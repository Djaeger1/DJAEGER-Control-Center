# Pinned for reproducibility; the boot service must not track moving versions.
DC_VERSION=0.2.51

# Official Remote Desktop Commander endpoint.
REMOTE_BASE=https://mcp.desktopcommander.app

# Retry policy.
RESTART_DELAY_SEC=20
NETWORK_RETRY_SEC=60
HTTP_RETRY_SEC=180
FORBIDDEN_RETRY_SEC=900

# Set to 1 only for troubleshooting. Do not enable by default.
DEBUG_MODE=0
