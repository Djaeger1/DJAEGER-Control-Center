# Pinned for reproducibility. Do not use @latest on a boot service.
DC_VERSION=0.2.51

# Official Remote Desktop Commander endpoint.
REMOTE_BASE=https://mcp.desktopcommander.app

# Restart/backoff policy. 403 is deliberately slow to avoid battery/network churn.
RESTART_DELAY_SEC=15
NETWORK_RETRY_SEC=30
HTTP_RETRY_SEC=120
FORBIDDEN_RETRY_SEC=900

# Set to 1 only for troubleshooting. Do not enable by default.
DEBUG_MODE=0
