# UI6_FIX1 canonical frequency contract: CPU policy values are kHz; GPU policy values are MHz.
# Kernel/devfreq readback may expose GPU values in Hz (or occasionally kHz in legacy state).
# Normalize only typed GPU fields; never guess units for arbitrary numbers.
gpu_unit_to_mhz(){
  _gu_v="$1"
  case "$_gu_v" in ''|*[!0-9]*) return 1;; esac
  if [ "$_gu_v" -ge 100000000 ] 2>/dev/null; then
    [ $((_gu_v%1000000)) -eq 0 ] 2>/dev/null || return 1
    printf '%s\n' $((_gu_v/1000000)); return 0
  fi
  if [ "$_gu_v" -ge 100000 ] 2>/dev/null; then
    [ $((_gu_v%1000)) -eq 0 ] 2>/dev/null || return 1
    printf '%s\n' $((_gu_v/1000)); return 0
  fi
  printf '%s\n' "$_gu_v"
}
gpu_pair_to_mhz(){
  _gp="$1"; case "$_gp" in *-*) :;; *) return 1;; esac
  _ga="${_gp%%-*}"; _gb="${_gp#*-}"
  _ga="$(gpu_unit_to_mhz "$_ga")" || return 1
  _gb="$(gpu_unit_to_mhz "$_gb")" || return 1
  printf '%s-%s\n' "$_ga" "$_gb"
}
normalize_account_budget(){
  _nab="$1"; _ngp="$(printf '%s\n' "$_nab" | sed -n 's/.* G=\([^ ]*\).*/\1/p')"
  [ -n "$_ngp" ] || { printf '%s\n' "$_nab"; return 0; }
  _ncanon="$(gpu_pair_to_mhz "$_ngp")" || { printf '%s\n' "$_nab"; return 0; }
  printf '%s\n' "$_nab" | sed "s/G=$_ngp/G=$_ncanon/"
}
# One-time non-destructive runtime migration for historical learning rows that stored
# GPU readback in Hz/kHz. Originals are retained as .pre_ui6_fix1_gpu_units backups.
ui6_fix1_migrate_gpu_learning_units(){
  _mark="$P/ui6_fix1_gpu_unit_migration_v1"
  [ -e "$_mark" ] && return 0
  _changed=0
  for _spec in \
    "$DYNLEARN:8:9:plain" \
    "$EFFMEM:8:9:plain" \
    "$HWLEARN:8:9:plain" \
    "$DECISION_LEDGER:7:0:range" \
    "$ACCOUNTABILITY_REVIEWS:11:0:range"
  do
    _f="${_spec%%:*}"; _rest="${_spec#*:}"; _c1="${_rest%%:*}"; _rest="${_rest#*:}"; _c2="${_rest%%:*}"; _kind="${_rest#*:}"
    [ -r "$_f" ] || continue
    _bak="$_f.pre_ui6_fix1_gpu_units"; [ -e "$_bak" ] || cp -p "$_f" "$_bak" 2>/dev/null || cp "$_f" "$_bak" 2>/dev/null || return 1
    _tmp="$_f.ui6_fix1tmp.$$"
    awk -F, -v OFS=, -v c1="$_c1" -v c2="$_c2" -v kind="$_kind" '
      function ng(v){ if(v~/^[0-9]+$/){ if(v>=100000000 && v%1000000==0)return int(v/1000000); if(v>=100000 && v%1000==0)return int(v/1000) } return v }
      NR==1{print;next}
      {
        if(kind=="plain"){$c1=ng($c1); if(c2>0)$c2=ng($c2)}
        else if(kind=="range"){split($c1,a,"-"); if(length(a)==2)$c1=ng(a[1])"-"ng(a[2])}
        print
      }' "$_f" >"$_tmp" || { rm -f "$_tmp"; return 1; }
    chmod 600 "$_tmp" 2>/dev/null
    mv -f "$_tmp" "$_f" || { rm -f "$_tmp"; return 1; }
    _changed=$((_changed+1))
  done
  # UI6_FIX1 context schema: append user_mode to legacy accountability ledgers. Historical
  # rows are retained as UNKNOWN and never enter a current-mode accountability lookup.
  for _lf in "$DECISION_LEDGER" "$ACCOUNTABILITY_REVIEWS"; do
    [ -r "$_lf" ] || continue
    _lh="$(head -n 1 "$_lf" 2>/dev/null)"
    case "$_lh" in *,user_mode) continue;; esac
    _lb="$_lf.pre_ui6_fix1_user_mode"; [ -e "$_lb" ] || cp -p "$_lf" "$_lb" 2>/dev/null || cp "$_lf" "$_lb" 2>/dev/null || return 1
    _lt="$_lf.ui6_fix1mode.$$"
    awk -F, -v OFS=, 'NR==1{print $0,"user_mode";next}{print $0,"UNKNOWN"}' "$_lf" >"$_lt" || { rm -f "$_lt"; return 1; }
    chmod 600 "$_lt" 2>/dev/null; mv -f "$_lt" "$_lf" || { rm -f "$_lt"; return 1; }
  done
  _mt="$P/.ui6_fix1_gpu_migration_marker.$$"
  printf "MIGRATION='GPU_CANONICAL_MHZ_V1'\nCONTEXT_SCHEMA='USER_MODE_V1'\nMIGRATED_FILES='%s'\nMIGRATED_AT='%s'\n" "$_changed" "$(date +%s)" >"$_mt" 2>/dev/null && chmod 600 "$_mt" 2>/dev/null && mv -f "$_mt" "$_mark"
}
# v12.6.0 transaction-aware, idempotent bounded CSV commit.
# policy_at (column 1) is the transaction key: retry replaces the same policy row
# instead of duplicating learning after a crash. Existing file is never modified in-place.
load_live_capability(){
  [ -r "$LIVE_CAPABILITY" ] || return 1
  _schema=$(sed -n "s/^CAP_SCHEMA='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  [ "$_schema" = "2" ] || return 1
  _opp_canon=$(sed -n "s/^CAP_OPP_CANONICAL='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gov_canon=$(sed -n "s/^CAP_GOVERNOR_CANONICAL='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  [ "$_opp_canon" = "YES" ] && [ "$_gov_canon" = "YES" ] || return 1
  _trust=$(sed -n "s/^CAP_TRUST='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _src_l=$(sed -n "s/^CAP_SOURCE_LITTLE='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _src_b=$(sed -n "s/^CAP_SOURCE_BIG='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _src_g=$(sed -n "s/^CAP_SOURCE_GPU='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  [ "$_trust" = "LIVE_EXACT_OPP_VERIFIED" ] || return 1
  case "$_src_l:$_src_b:$_src_g" in
    LIVE_EXACT_OPP_*:LIVE_EXACT_OPP_*:LIVE_EXACT_OPP_*) : ;;
    *) return 1 ;;
  esac
  _sig=$(sed -n "s/^CAP_CONTENT_SIG='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _epoch=$(sed -n "s/^CAP_CONTENT_EPOCH='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _updated=$(sed -n "s/^CAP_UPDATED_AT='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _prov_identity=$(sed -n "s/^CAP_IDENTITY_INCLUDES_OPP_PROVENANCE='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_reuse=$(sed -n "s/^CAP_GENERATION_REUSE_VALIDATED='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_bound=$(sed -n "s/^CAP_GENERATION_CONTEXT_BOUND='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_schema=$(sed -n "s/^CAP_GENERATION_ID_SCHEMA='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_ts_bound=$(sed -n "s/^CAP_GENERATION_TIMESTAMP_BOUND='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_max_age=$(sed -n "s/^CAP_GENERATION_MAX_AGE_S='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_age=$(sed -n "s/^CAP_GENERATION_AGE_S='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _gen_age_derivation=$(sed -n "s/^CAP_GENERATION_AGE_DERIVATION='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  [ "$_prov_identity" = YES ] && [ "$_gen_reuse" = YES ] && [ "$_gen_bound" = YES ] && [ "$_gen_schema" = LENPREFIX_V1 ] && [ "$_gen_ts_bound" = YES ] || return 1
  [ "$_gen_max_age" = 120 ] || return 1
  [ "$_gen_age_derivation" = UPDATED_AT_MINUS_EPOCH ] || return 1
  case "$_gen_age" in ''|*[!0-9]*) return 1;; esac
  [ "$_gen_age" -le "$_gen_max_age" ] 2>/dev/null || return 1
  case "$_epoch:$_updated" in *[!0-9:]*|*::*|:*) return 1;; esac
  [ "$_epoch" -le "$_updated" ] 2>/dev/null || return 1
  [ "$_gen_age" -eq "$((_updated-_epoch))" ] 2>/dev/null || return 1
  [ -n "$_sig" ] && [ -n "$_epoch" ] || return 1
  _ct="$_updated"
  _now=$(date +%s)
  case "$_ct:$_now" in *[!0-9:]*|*::*|:*) return 1;; esac
  [ "$_ct" -le "$_now" ] 2>/dev/null || return 1
  [ $((_now-_ct)) -le 120 ] || return 1
  _cb=$(sed -n "s/^CAP_BOOT_ID='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _cs=$(sed -n "s/^CAP_SESSION_ID='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _cg=$(sed -n "s/^CAP_GENERATION_ID='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  [ -n "$_cg" ] || return 1
  _boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  _sess=$(cat "$P/session_id" 2>/dev/null)
  [ -n "$_cb" ] && [ "$_cb" = "$_boot" ] || return 1
  [ -n "$_cs" ] && [ "$_cs" = "$_sess" ] || return 1
  # r78: independently reconstruct the exact length-prefixed generation identity.
  # Context-bound markers alone are not sufficient evidence.
  _expected_gen="B${#_boot}:${_boot};S${#_sess}:${_sess};T${_epoch}"
  [ "$_cg" = "$_expected_gen" ] || return 1
  HW_LITTLE_MIN=$(sed -n "s/^HW_LITTLE_MIN='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_LITTLE_MAX=$(sed -n "s/^HW_LITTLE_MAX='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_BIG_MIN=$(sed -n "s/^HW_BIG_MIN='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_BIG_MAX=$(sed -n "s/^HW_BIG_MAX='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GPU_MIN=$(sed -n "s/^HW_GPU_MIN='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GPU_MAX=$(sed -n "s/^HW_GPU_MAX='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_LITTLE_OPPS=$(sed -n "s/^LITTLE_OPP_KHZ='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_BIG_OPPS=$(sed -n "s/^BIG_OPP_KHZ='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GPU_OPPS=$(sed -n "s/^GPU_OPP_MHZ='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_LITTLE_GOVS=$(sed -n "s/^LITTLE_GOVERNORS='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_BIG_GOVS=$(sed -n "s/^BIG_GOVERNORS='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GPU_GOVS=$(sed -n "s/^GPU_GOVERNORS='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_LITTLE_GOV_SRC=$(sed -n "s/^GOV_SOURCE_LITTLE='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_BIG_GOV_SRC=$(sed -n "s/^GOV_SOURCE_BIG='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GPU_GOV_SRC=$(sed -n "s/^GOV_SOURCE_GPU='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  HW_GOV_TRUST=$(sed -n "s/^GOV_TRUST='\([^']*\)'.*/\1/p" "$LIVE_CAPABILITY" | head -1)
  _pred_gov_list(){
    _seen=""
    [ -n "$1" ] || return 0
    for _gx in $1; do
      case "$_gx" in *[!A-Za-z0-9_.+-]*) return 1;; esac
      case " $_seen " in *" $_gx "*) return 1;; esac
      _seen="$_seen $_gx"
    done
    return 0
  }
  _pred_gov_list "$HW_LITTLE_GOVS" || return 1
  _pred_gov_list "$HW_BIG_GOVS" || return 1
  _pred_gov_list "$HW_GPU_GOVS" || return 1
  [ -n "$HW_LITTLE_OPPS" ] && [ -n "$HW_BIG_OPPS" ] && [ -n "$HW_GPU_OPPS" ] || return 1
  _pred_num_list(){
    _pv=0
    for _px in $1; do
      case "$_px" in ''|*[!0-9]*) return 1;; esac
      [ "$_px" -gt "$_pv" ] || return 1
      _pv="$_px"
    done
    return 0
  }
  _pred_num_list "$HW_LITTLE_OPPS" || return 1
  _pred_num_list "$HW_BIG_OPPS" || return 1
  _pred_num_list "$HW_GPU_OPPS" || return 1
  return 0
}

publish_strategy_formula(){
  # Transparency-only contract for Control Center. Never execute from this file.
  _sf_tmp="$STRATEGY_FORMULA.tmp.$$"
  umask 077
  {
    _formula_tx="${POLICY_AT:-$(date +%s)}:${SESSION_ID:-0}:${GAME_ID:-UNKNOWN}:${USER_MODE:-AUTO}"
    printf "FORMULA_SCHEMA='2'\n"
    printf "FORMULA_TX_ID='%s'\n" "$_formula_tx"
    printf "SOURCE='GEMINI'\n"
    printf "STATUS='PROPOSED'\n"
