  grep -q '"object"[[:space:]]*:[[:space:]]*"interaction"' "$RAW" 2>/dev/null || { plog "PARSE_REJECT REASON=OBJECT_NOT_INTERACTION"; return 31; }
  grep -q '"type"[[:space:]]*:[[:space:]]*"model_output"' "$RAW" 2>/dev/null || { plog "PARSE_REJECT REASON=MODEL_OUTPUT_MISSING"; return 31; }
  RESP_MODEL="$(sh "$JSON" string model "$RAW" last 2>/dev/null)"
  [ "$RESP_MODEL" = "$MODEL" ] || { plog "PARSE_REJECT REASON=MODEL_MISMATCH GOT=${RESP_MODEL:-NONE} EXPECTED=$MODEL"; return 31; }

  # Persist only a completed, model-matching interaction ID. Never trust an ID
  # from an error/incomplete response. The file contains no API key.
  NEW_INTERACTION_ID="$(sh "$JSON" string id "$RAW" first 2>/dev/null)"
  if [ -n "$NEW_INTERACTION_ID" ]; then
    SERVER_CHAIN=$((SERVER_CHAIN + 1)); _SST="$SERVER_STATE.tmp.$$"
    printf "SERVER_INTERACTION_ID='%s'\nSERVER_GAME_ID='%s'\nSERVER_MODEL_ID='%s'\nSERVER_CHAIN_COUNT='%s'\nSERVER_UPDATED_AT='%s'\n" \
      "$NEW_INTERACTION_ID" "$GAME_ID" "$MODEL" "$SERVER_CHAIN" "$(date +%s)" >"$_SST" 2>/dev/null && \
      chmod 600 "$_SST" 2>/dev/null && mv -f "$_SST" "$SERVER_STATE" 2>/dev/null
    plog "GEMINI_SERVER_REASONING mode=$SERVER_MODE chain=$SERVER_CHAIN game=$GAME_ID model=$MODEL"
  fi

  # v12.9.50: decode only the model_output text through an escape-aware JSON
  # scanner, then parse the structured JSON from that isolated text. No global
  # unescape and no quote-fragile grep/sed extraction.
  # r87: decoded Gemini model output belongs in DJAEGER's writable state dir.
  # r86 accidentally referenced undefined $AI, expanding to /.gemini_model_output.<pid>
  # on device. The failed redirect was hidden and later surfaced misleadingly as RC=30.
  DECODED="$P/.gemini_model_output.$$"
  if ! sh "$JSON" string text "$RAW" last >"$DECODED" 2>/dev/null; then
    plog "PARSE_REJECT REASON=MODEL_OUTPUT_DECODE_FAILED"
    rm -f "$DECODED" 2>/dev/null
    return 31
  fi
  if [ ! -s "$DECODED" ]; then
    plog "PARSE_REJECT REASON=MODEL_OUTPUT_DECODE_EMPTY"
    rm -f "$DECODED" 2>/dev/null
    return 31
  fi
  chmod 600 "$DECODED" 2>/dev/null
  jstr(){ sh "$JSON" string "$1" "$DECODED" first 2>/dev/null; }
  jnum(){ sh "$JSON" number "$1" "$DECODED" first 2>/dev/null; }
  ACTION="$(jstr action)"
  REC="$(jstr recommended_profile)"; CMODE="$(jstr control_mode)"; OINT="$(jstr operating_intent)"; LMIN="$(jnum little_min_khz)"; LMAX="$(jnum little_max_khz)"; BMIN="$(jnum big_min_khz)"; BMAX="$(jnum big_max_khz)"; GMIN="$(jnum gpu_min_mhz)"; GMAX="$(jnum gpu_max_mhz)"
  TT="$(jstr thermal_trend)"; PT="$(jstr performance_trend)"; TR="$(jstr thermal_risk)"; PR="$(jstr performance_risk)"; SF="$(jnum skin_forecast_2m)"; FF="$(jnum fps_forecast_2m)"; CONF="$(jnum confidence)"; DUR="$(jnum intervention_seconds)"; EXIT_SKIN="$(jnum exit_skin_c)"
  ICOMFORT="$(jstr inferred_owner_comfort)"; CCONF="$(jnum comfort_confidence)"; CBASIS="$(jstr comfort_basis | tr '\n' ' ' | cut -c1-180)"
  ASCOPE="$(jstr authority_scope)"; TMODE="$(jstr thermal_mode)"; CGOV="$(jstr cpu_governor)"; GGOV="$(jstr gpu_governor)"; BMODE="$(jstr battery_mode)"; CENABLE="$(jstr charge_enable)"; CCURRENT="$(jnum charge_current_ua)"; ICURRENT="$(jnum input_current_ua)"; SMODE="$(jstr sensor_mode)"; TPOLL="$(jnum thermal_polling_ms)"; TPASS="$(jnum thermal_passive_ms)"; TSHIFT="$(jnum thermal_trip_shift_mc)"; CBOOST="$(jstr cpu_boost)"; GBOOST="$(jnum gpu_boost_level)"; BVOLT="$(jnum battery_voltage_uv)"; CEND="$(jnum charge_end_percent)"; NWRITE="$(jstr native_write_plan)"
  NARRATIVE="$(jstr narrative | tr '\n\r\t' '   ' | sed 's/[[:space:]][[:space:]]*/ /g' | cut -c1-600)"
  RAT="$(jstr rationale | tr '\n' ' ' | cut -c1-220)"
  PARSE_MODE=STRUCTURED_JSON_SCANNER

  case "$ICOMFORT" in VERY_COMFORTABLE|COMFORTABLE|LESS_COMFORTABLE|UNCOMFORTABLE)
    case "$CCONF" in ''|*[!0-9]*) CCONF=0;; esac
    [ "$CCONF" -gt 100 ] 2>/dev/null && CCONF=100
    [ -f "$AUTO_COMFORT" ] || printf "at,game,comfort,confidence,avg_skin,avg_fps,avg_p95,avg_p99,skin_momentum,basis\n" >"$AUTO_COMFORT"
    printf "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n" "$(date +%s)" "$GAME_ID" "$ICOMFORT" "$CCONF" "${AVG_SKIN:-NA}" "${AVG_FPS:-NA}" "${AVG_P95:-NA}" "${AVG_P99:-NA}" "${SKIN_MOM:-NA}" "$(printf '%s' "$CBASIS" | tr ',\n' '  ' | cut -c1-180)" >>"$AUTO_COMFORT"
    tail -n 81 "$AUTO_COMFORT" >"$AUTO_COMFORT.tmp.$$" 2>/dev/null && mv -f "$AUTO_COMFORT.tmp.$$" "$AUTO_COMFORT"
    chmod 600 "$AUTO_COMFORT" 2>/dev/null
    plog "AUTONOMOUS_COMFORT level=$ICOMFORT confidence=$CCONF skin=${AVG_SKIN:-NA} fps=${AVG_FPS:-NA} basis=${CBASIS:-NA}"
    ;;
  esac

  # 2) Backward-compatible labeled text parser.
  if [ -z "$ACTION" ]; then
    ACTION="$(grep -o 'ACTION:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^ACTION:[ ]*//')"
    REC="$(grep -o 'RECOMMENDED_PROFILE:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^RECOMMENDED_PROFILE:[ ]*//')"
    TT="$(grep -o 'THERMAL_TREND:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^THERMAL_TREND:[ ]*//')"
    PT="$(grep -o 'PERFORMANCE_TREND:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^PERFORMANCE_TREND:[ ]*//')"
    TR="$(grep -o 'THERMAL_RISK:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^THERMAL_RISK:[ ]*//')"
    PR="$(grep -o 'PERFORMANCE_RISK:[ ]*[A-Z_]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^PERFORMANCE_RISK:[ ]*//')"
    SF="$(grep -o 'SKIN_FORECAST_2M:[ ]*[0-9][0-9]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^SKIN_FORECAST_2M:[ ]*//')"
    FF="$(grep -o 'FPS_FORECAST_2M:[ ]*[0-9][0-9]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^FPS_FORECAST_2M:[ ]*//')"
    CONF="$(grep -o 'CONFIDENCE:[ ]*[0-9][0-9]*' "$DECODED" 2>/dev/null | head -1 | sed 's/^CONFIDENCE:[ ]*//')"
    RAT="$(tr -d '\r\n' <"$DECODED" | sed -n 's/.*RATIONALE:[ ]*\([^"}]*\).*/\1/p' | head -1 | cut -c1-220)"
    PARSE_MODE=LABELED_TEXT
  fi

  # 3) Positional fallback for the exact 10-line contract. This handles the
  #    response variant proven on-device: KEEP / STABLE / RECOVERING / ...
  if [ -z "$ACTION" ]; then
    TXT="$(cat "$DECODED" 2>/dev/null)"
    L1="$(printf '%s\n' "$TXT"|sed -n '1p'|tr -d '\r')"
    case "$L1" in KEEP|AVOID_RESPONSE|MORE_RESPONSE|COOLER)
      ACTION="$L1"; REC="$(printf '%s\n' "$TXT"|sed -n '2p'|tr -d '\r')"; TT="$(printf '%s\n' "$TXT"|sed -n '3p'|tr -d '\r')"; PT="$(printf '%s\n' "$TXT"|sed -n '4p'|tr -d '\r')"; TR="$(printf '%s\n' "$TXT"|sed -n '5p'|tr -d '\r')"; PR="$(printf '%s\n' "$TXT"|sed -n '6p'|tr -d '\r')"; SF="$(printf '%s\n' "$TXT"|sed -n '7p'|tr -d '\r')"; FF="$(printf '%s\n' "$TXT"|sed -n '8p'|tr -d '\r')"; CONF="$(printf '%s\n' "$TXT"|sed -n '9p'|tr -d '\r')"; RAT="$(printf '%s\n' "$TXT"|sed -n '10p'|tr -d '\r'|cut -c1-220)"; PARSE_MODE=POSITIONAL_TEXT;;
    esac
  fi
  [ -n "${CMODE:-}" ] || CMODE=PROFILE
  # v12 optional plan-outcome fields from the same isolated structured JSON.
  fnum(){ jnum "$1"; }
  ESD="$(fnum expected_skin_delta_c)"; EFD="$(fnum expected_fps_delta)"; REVIEW="$(jnum review_seconds)"; EINT="$(jstr efficiency_intent)"; EPD="$(jnum expected_power_delta_pct)"
  FPSLO="$(fnum fps_forecast_low)"; FPSHI="$(fnum fps_forecast_high)"; SKINLO="$(fnum skin_forecast_low_c)"; SKINHI="$(fnum skin_forecast_high_c)"
  PWRLO="$(jnum power_forecast_low_mw)"; PWRHI="$(jnum power_forecast_high_mw)"; P95LO="$(fnum p95_forecast_low_ms)"; P95HI="$(fnum p95_forecast_high_ms)"; P99LO="$(fnum p99_forecast_low_ms)"; P99HI="$(fnum p99_forecast_high_ms)"; JRISK="$(jnum jank_over_10_risk_pct)"; THRISK="$(jnum thermal_escalation_risk_pct)"; FCONF="$(jnum foresight_confidence)"
  PBOT="$(jstr predicted_bottleneck | cut -c1-160)"; FBASIS="$(jstr foresight_basis | cut -c1-220)"
  ACCVER="$(jstr accountability_verdict | cut -c1-40)"; ACCPREV="$(jstr accountability_previous_decision_id | cut -c1-40)"; ACCLESSON="$(jstr accountability_lesson | cut -c1-220)"; ACCCORR="$(jstr accountability_correction | cut -c1-220)"; DECHYP="$(jstr decision_hypothesis | cut -c1-220)"; FACTS="$(jstr facts_summary | cut -c1-500)"; INFER="$(jstr inference_summary | cut -c1-500)"; UNKNOWNS="$(jstr unknowns_summary | cut -c1-500)"; REQOBS="$(jstr requested_observations | cut -c1-500)"
  # GEMINITHOUGHTCOMMIT1: decoded narrative is advisory until the policy passes all validation gates.
  rm -f "$DECODED" 2>/dev/null
  case "$ESD" in ''|*[!0-9.-]*) ESD=0;; esac; case "$EFD" in ''|*[!0-9.-]*) EFD=0;; esac
  case "$REVIEW" in ''|*[!0-9]*) REVIEW=60;; esac; [ "$REVIEW" -lt 30 ] && REVIEW=30; [ "$REVIEW" -gt 150 ] && REVIEW=150
  validfloat(){ case "$1" in ''|*[!0-9.-]*) return 1;; *) return 0;; esac; }
  validfloat "$FPSLO" || FPSLO="$AVG_FPS"; validfloat "$FPSHI" || FPSHI="$AVG_FPS"; validfloat "$SKINLO" || SKINLO="$AVG_SKIN"; validfloat "$SKINHI" || SKINHI="$AVG_SKIN"
  awk -v a="$FPSLO" -v b="$FPSHI" 'BEGIN{exit !(a<=b)}' || { _t="$FPSLO"; FPSLO="$FPSHI"; FPSHI="$_t"; }
  awk -v a="$SKINLO" -v b="$SKINHI" 'BEGIN{exit !(a<=b)}' || { _t="$SKINLO"; SKINLO="$SKINHI"; SKINHI="$_t"; }
  case "$PWRLO" in ''|*[!0-9]*) PWRLO=NA;; esac; case "$PWRHI" in ''|*[!0-9]*) PWRHI=NA;; esac
  validfloat "$P95LO" || P95LO="$AVG_P95"; validfloat "$P95HI" || P95HI="$AVG_P95"; validfloat "$P99LO" || P99LO="$AVG_P99"; validfloat "$P99HI" || P99HI="$AVG_P99"
  awk -v a="$P95LO" -v b="$P95HI" 'BEGIN{exit !(a<=b)}' || { _t="$P95LO"; P95LO="$P95HI"; P95HI="$_t"; }; awk -v a="$P99LO" -v b="$P99HI" 'BEGIN{exit !(a<=b)}' || { _t="$P99LO"; P99LO="$P99HI"; P99HI="$_t"; }
  case "$JRISK" in ''|*[!0-9]*) JRISK=50;; esac; [ "$JRISK" -gt 100 ] && JRISK=100
  case "$THRISK" in ''|*[!0-9]*) THRISK=50;; esac; [ "$THRISK" -gt 100 ] && THRISK=100
  case "$FCONF" in ''|*[!0-9]*) FCONF="$CONF";; esac; [ "$FCONF" -gt 100 ] && FCONF=100
  case "$CMODE" in PROFILE|DYNAMIC|ENVELOPE) ;; *) CMODE=PROFILE;; esac
  case "${OINT:-}" in FRAME_RECOVERY|SUSTAINED_PERFORMANCE|THERMAL_HOLD|EFFICIENCY|BALANCED|EXPLORATION) ;; *) OINT=BALANCED;; esac
  # REBUILD3 AI Agent validates against LIVE kernel capabilities, never a chipset whitelist.
  numeric(){ case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
  map_up_words(){ v="$1"; shift; last=""; for x in "$@"; do last="$x"; [ "$x" -ge "$v" ] 2>/dev/null && { echo "$x"; return; }; done; echo "$last"; }
  map_down_words(){ v="$1"; shift; last="$1"; for x in "$@"; do [ "$x" -gt "$v" ] 2>/dev/null && { echo "$last"; return; }; last="$x"; done; echo "$last"; }
  caprow(){ awk -F '\t' -v typ="$1" -v idx="$2" '$1==typ{n++;if(n==idx){print;exit}}' "$KERNEL_CAPABILITY_FILE" 2>/dev/null; }
  quant_cpu(){
    idx="$1"; v="$2"; dir="$3"; row="$(caprow CPU "$idx")"; freqs="$(printf '%s\n' "$row"|awk -F '\t' '{print $5}')"
    [ -n "$freqs" ] || { echo "$v"; return; }
    if [ "$dir" = up ]; then map_up_words "$v" $freqs; else map_down_words "$v" $freqs; fi
  }
  quant_gpu(){
    v="$1"; dir="$2"; row="$(caprow GPU 1)"; freqs="$(printf '%s\n' "$row"|awk -F '\t' '{print $5}')"
    [ -n "$freqs" ] || { echo "$v"; return; }
    # Kernel GPU frequencies are Hz; predictor schema uses MHz.
    mf=""; for hz in $freqs; do numeric "$hz" && mf="$mf $((hz/1000000))"; done
    mf="$(printf '%s\n' "$mf"|tr ' ' '\n'|awk '/^[0-9]+$/{print}'|sort -n -u|tr '\n' ' '|sed 's/ $//')"
    [ -n "$mf" ] || { echo "$v"; return; }
    if [ "$dir" = up ]; then map_up_words "$v" $mf; else map_down_words "$v" $mf; fi
  }
  if [ "$CMODE" = DYNAMIC ] || [ "$CMODE" = ENVELOPE ]; then
    numeric "$LMIN" && numeric "$LMAX" && numeric "$BMIN" && numeric "$BMAX" && numeric "$GMIN" && numeric "$GMAX" || return 33
    [ "$LMIN" -le "$LMAX" ] && [ "$BMIN" -le "$BMAX" ] && [ "$GMIN" -le "$GMAX" ] || return 34
    RAW_LMIN="$LMIN"; RAW_LMAX="$LMAX"; RAW_BMIN="$BMIN"; RAW_BMAX="$BMAX"; RAW_GMIN="$GMIN"; RAW_GMAX="$GMAX"
    GMIN="$(gpu_unit_to_mhz "$GMIN")" || { plog "GPU_UNIT_REJECT field=min raw=$RAW_GMIN"; return 33; }
    GMAX="$(gpu_unit_to_mhz "$GMAX")" || { plog "GPU_UNIT_REJECT field=max raw=$RAW_GMAX"; return 33; }
    [ "$GMIN" -le "$GMAX" ] 2>/dev/null || return 34
    [ -r "$KERNEL_CAPABILITY_FILE" ] && {
      LMIN="$(quant_cpu 1 "$LMIN" up)"; LMAX="$(quant_cpu 1 "$LMAX" down)"
      _cpun="$(awk -F '\t' '$1=="CPU"{n++}END{print n+0}' "$KERNEL_CAPABILITY_FILE" 2>/dev/null)"
      [ "${_cpun:-0}" -gt 1 ] || _cpun=1
      BMIN="$(quant_cpu "$_cpun" "$BMIN" up)"; BMAX="$(quant_cpu "$_cpun" "$BMAX" down)"
      GMIN="$(quant_gpu "$GMIN" up)"; GMAX="$(quant_gpu "$GMAX" down)"
    }
    [ "$LMIN" -le "$LMAX" ] && [ "$BMIN" -le "$BMAX" ] && [ "$GMIN" -le "$GMAX" ] || return 34
    plog "LIVE_OPP_MAP RAW_L=${RAW_LMIN}-${RAW_LMAX} RAW_B=${RAW_BMIN}-${RAW_BMAX} RAW_G=${RAW_GMIN}-${RAW_GMAX} CANON_G=${GMIN}-${GMAX}MHz MAPPED_L=${LMIN}-${LMAX} MAPPED_B=${BMIN}-${BMAX} MAPPED_G=${GMIN}-${GMAX}"
  else LMIN=NA; LMAX=NA; BMIN=NA; BMAX=NA; GMIN=NA; GMAX=NA; fi
  case "$SF" in ''|null|NULL|NA) SF=NA;; *[!0-9]*) SF=NA;; esac
  case "$FF" in ''|null|NULL|NA) FF=NA;; *[!0-9]*) FF=NA;; esac
  [ -n "$ACTION" ] || return 30

  case "$ACTION" in EXECUTE|KEEP|AVOID_RESPONSE|MORE_RESPONSE|COOLER) ;; *) return 31;; esac
  [ -n "$FACTS" ] && [ -n "$INFER" ] && [ -n "$UNKNOWNS" ] && [ -n "$REQOBS" ] || { plog "EPISTEMIC_REJECT missing_structured_reasoning=1"; return 36; }
  if [ "$UNKNOWNS" != NONE ] && [ "$REQOBS" != NONE ] && [ "$CONF" -lt 70 ] 2>/dev/null && [ "$ACTION" = EXECUTE ]; then plog "EPISTEMIC_VETO low_confidence_unknowns=1 requested_observation=1"; ACTION=KEEP; fi
  case "$REC" in COOL|SOFT_COOL|STABLE|PERFORM|RESPONSE|SAFE) ;; *) REC=STABLE;; esac
  case "$CONF" in ''|*[!0-9]*) return 32;; esac
  [ "$CONF" -gt 100 ] && CONF=100
  # UI6_FIX1 Decision Accountability: fail closed for ATTRIBUTION, not for Gemini resource authority.
  # A stale/wrong retrospective ID or textual frequency claim is quarantined from learning,
  # but it cannot veto a current schema/context/OPP-valid Gemini plan.
  ACCOUNTABILITY_STATUS="TRUSTED"; ACCOUNTABILITY_TRUSTED=1; ACCPREV_MODEL="$ACCPREV"
  case "$ACCVER" in
    NO_PRIOR_OUTCOME|ACCEPT_SUCCESS|ACCEPT_FAILURE|DEFEND_WITH_NEW_EVIDENCE|REVISE|ABANDON) :;;
    *) ACCOUNTABILITY_STATUS="INVALID_VERDICT_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0;;
  esac
  if [ "$LAST_DECISION_ID" != NONE ]; then
    if [ "$ACCPREV" != "$LAST_DECISION_ID" ]; then ACCOUNTABILITY_STATUS="STALE_REFERENCE_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0; fi
    if [ "$ACCOUNTABILITY_TRUSTED" -eq 1 ]; then
      case "$LAST_DECISION_OUTCOME:$ACCVER" in
        FAILED:ACCEPT_SUCCESS|SUCCESS:ACCEPT_FAILURE) ACCOUNTABILITY_STATUS="OUTCOME_CONTRADICTION_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0;;
      esac
      [ "$ACCVER" != NO_PRIOR_OUTCOME ] || { ACCOUNTABILITY_STATUS="MISSING_PRIOR_ACK_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0; }
    fi
  else
    ACCPREV=NONE; ACCVER=NO_PRIOR_OUTCOME; ACCOUNTABILITY_STATUS="NO_PRIOR_OUTCOME"; ACCOUNTABILITY_TRUSTED=1
  fi
  # Ground frequency claims against canonical CPU-kHz / GPU-MHz prior budget. Legacy
  # Hz/kHz GPU rows are normalized before this comparison.
  if [ "$ACCOUNTABILITY_TRUSTED" -eq 1 ] && [ "$LAST_DECISION_BUDGET" != NONE ]; then
    _freq_claims="$(printf '%s %s' "$ACCLESSON" "$ACCCORR" | grep -Eo '[0-9]{3,10}[[:space:]]*(MHz|kHz)' 2>/dev/null | tr -s ' ' | sort -u)"
    while IFS= read -r _claim; do
      [ -n "$_claim" ] || continue
      _fc="$(printf '%s' "$_claim" | grep -Eo '^[0-9]+')"; _fu="$(printf '%s' "$_claim" | grep -Eo '(MHz|kHz)$')"
      _fc_canon="$_fc"
      if [ "$_fu" = MHz ]; then _fc_canon="$(gpu_unit_to_mhz "$_fc")" || { ACCOUNTABILITY_STATUS="FREQUENCY_UNIT_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0; break; }; fi
      printf '%s' "$LAST_DECISION_BUDGET" | grep -Eq "(^|[-=])${_fc_canon}([[:space:]-]|$)" || { ACCOUNTABILITY_STATUS="UNGROUNDED_FREQUENCY_QUARANTINED"; ACCOUNTABILITY_TRUSTED=0; break; }
    done <<EOF_ACC_CLAIMS
$_freq_claims
EOF_ACC_CLAIMS
  fi
  if [ "$ACCOUNTABILITY_TRUSTED" -ne 1 ]; then
    plog "ACCOUNTABILITY_QUARANTINE status=$ACCOUNTABILITY_STATUS model_previous=${ACCPREV_MODEL:-NONE} expected=${LAST_DECISION_ID:-NONE} current_plan_continues=1 NO_ATTRIBUTION_LEARNING=1"
  fi
  case "$DUR" in ''|*[!0-9]*) DUR=150;; esac
  [ "$DUR" -lt 30 ] && DUR=30
  [ "$DUR" -gt 150 ] && DUR=150
  case "$EXIT_SKIN" in ''|*[!0-9]*) EXIT_SKIN=NA;; esac
  if [ "$EXIT_SKIN" != NA ]; then [ "$EXIT_SKIN" -lt 40 ] && EXIT_SKIN=40; [ "$EXIT_SKIN" -gt 41 ] && EXIT_SKIN=41; fi
  BASE_POWER_MW="$(tail -n 60 "$TEL" 2>/dev/null | awk -F, -v wm="$CURRENT_WINDOW_MODE" -v we="$CURRENT_WINDOW_EPOCH" '$23==wm && $24==we && $19~/^[0-9]+$/ && $20=="VALID"{s+=$19;n++}END{if(n)printf "%.0f",s/n;else print "NA"}')"
  # Persist server-side structured reasoning as inert evolution memory.
  # This is not sourced/eval'd and cannot directly execute hardware changes.
  _evo_sanitize(){ printf '%s' "$1" | tr '\t\r\n' '   ' | cut -c1-260; }
  _evo_acc_lesson="${ACCLESSON:-NA}"; _evo_acc_correction="${ACCCORR:-NA}"; [ "${ACCOUNTABILITY_TRUSTED:-0}" -eq 1 ] || { _evo_acc_lesson="QUARANTINED"; _evo_acc_correction="QUARANTINED"; }; _evo_line="$(date +%s)\t${GAME_ID:-UNKNOWN}\t${CURRENT_WINDOW_MODE:-UNKNOWN}\t$(_evo_sanitize "${ACTION:-NA}")\t$(_evo_sanitize "${CMODE:-NA}")\t$(_evo_sanitize "${OINT:-NA}")\t$(_evo_sanitize "${DECHYP:-NA}")\t$(_evo_sanitize "${_evo_acc_lesson:-NA}")\t$(_evo_sanitize "${_evo_acc_correction:-NA}")\t$(_evo_sanitize "${RAT:-NA}")"
  umask 077
  printf '%b\n' "$_evo_line" >>"$EVOLUTION_MEMORY"
  tail -n 1200 "$EVOLUTION_MEMORY" >"$EVOLUTION_MEMORY.tmp.$$" 2>/dev/null && mv -f "$EVOLUTION_MEMORY.tmp.$$" "$EVOLUTION_MEMORY"
  chmod 600 "$EVOLUTION_MEMORY" 2>/dev/null || true

  case "${ASCOPE:-}" in RESOURCE_ONLY|FULL_EXPERT) :;; *) ASCOPE=FULL_EXPERT;; esac
  case "${TMODE:-}" in NATIVE|RELAXED|PERFORMANCE|BYPASS) :;; *) TMODE=NATIVE;; esac
  # Governor names are validated against live kernel lists, not a module whitelist.
  case "${CGOV:-}" in ''|AUTO) CGOV=AUTO;; *[!A-Za-z0-9_.-]*) CGOV=AUTO;; esac
  case "${GGOV:-}" in ''|AUTO) GGOV=AUTO;; *[!A-Za-z0-9_.-]*) GGOV=AUTO;; esac
  if [ -r "$KERNEL_CAPABILITY_FILE" ]; then
    if [ "$CGOV" != AUTO ]; then
      _cgovok="$(awk -F '\t' -v g="$CGOV" '$1=="CPU"{x=" "$6" ";if(index(x," "g" "))ok=1}END{print ok+0}' "$KERNEL_CAPABILITY_FILE" 2>/dev/null)"
      [ "$_cgovok" = 1 ] || { plog "GOVERNOR_REJECT cpu=$CGOV reason=not_live_capability"; CGOV=AUTO; }
    fi
    if [ "$GGOV" != AUTO ]; then
      _ggovok="$(awk -F '\t' -v g="$GGOV" '$1=="GPU"{x=" "$6" ";if(index(x," "g" "))ok=1}END{print ok+0}' "$KERNEL_CAPABILITY_FILE" 2>/dev/null)"
      [ "$_ggovok" = 1 ] || { plog "GOVERNOR_REJECT gpu=$GGOV reason=not_live_capability"; GGOV=AUTO; }
    fi
  fi
  case "${BMODE:-}" in NATIVE|COOL|BALANCED|PERFORMANCE|CUSTOM) :;; *) BMODE=NATIVE;; esac
  case "${CENABLE:-}" in AUTO|ENABLE|DISABLE) :;; *) CENABLE=AUTO;; esac
  case "${CCURRENT:-}" in ''|*[!0-9]*) CCURRENT=NA;; esac
  case "${ICURRENT:-}" in ''|*[!0-9]*) ICURRENT=NA;; esac
