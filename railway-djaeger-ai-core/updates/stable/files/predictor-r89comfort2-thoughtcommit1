# v12.9.8 PID-reuse-safe predictor singleton. PID + /proc starttime identify the owner.
PRED_OWNER="$LOCKDIR/owner"
proc_starttime(){ awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
predictor_owner_is_live(){
  _pid="$1"; _birth="$2"
  case "$_pid:$_birth" in *[!0-9:]*|:|*:) return 1;; esac
  [ "$_pid" -gt 1 ] 2>/dev/null || return 1
  kill -0 "$_pid" 2>/dev/null || return 1
  [ "$(proc_starttime "$_pid")" = "$_birth" ] || return 1
  _cmd="$(tr '\000' ' ' <"/proc/$_pid/cmdline" 2>/dev/null)"
  case "$_cmd" in *djaeger_game_stabilizer/predictor.sh*) return 0;; esac
  return 1
}
acquire_predictor_lock(){
  _try=0
  while [ "$_try" -lt 3 ]; do
    if mkdir "$LOCKDIR" 2>/dev/null; then
      chmod 700 "$LOCKDIR" 2>/dev/null
      _birth="$(proc_starttime "$$")"
      printf 'PID=%s\nSTARTTIME=%s\n' "$$" "$_birth" >"$PRED_OWNER.tmp.$$" 2>/dev/null && { chmod 600 "$PRED_OWNER.tmp.$$" 2>/dev/null; mv -f "$PRED_OWNER.tmp.$$" "$PRED_OWNER"; }
      printf '%s\n' "$$" >"$LOCK.tmp.$$" 2>/dev/null && { chmod 600 "$LOCK.tmp.$$" 2>/dev/null; mv -f "$LOCK.tmp.$$" "$LOCK"; }
      return 0
    fi
    OLD="$(sed -n 's/^PID=//p' "$PRED_OWNER" 2>/dev/null)"
    BIRTH="$(sed -n 's/^STARTTIME=//p' "$PRED_OWNER" 2>/dev/null)"
    predictor_owner_is_live "$OLD" "$BIRTH" && return 1
    plog "STALE_PREDICTOR_LOCK PID=${OLD:-NA} STARTTIME=${BIRTH:-NA} RECOVERED=1"
    rm -rf "$LOCKDIR" 2>/dev/null; rm -f "$LOCK" 2>/dev/null
    _try=$((_try+1))
  done
  return 1
}
predictor_cleanup(){
  _pid="$(sed -n 's/^PID=//p' "$PRED_OWNER" 2>/dev/null)"
  _birth="$(sed -n 's/^STARTTIME=//p' "$PRED_OWNER" 2>/dev/null)"
  if [ "$_pid" = "$$" ] && [ "$_birth" = "$(proc_starttime "$$")" ]; then rm -f "$LOCK" 2>/dev/null; rm -rf "$LOCKDIR" 2>/dev/null; fi
}
