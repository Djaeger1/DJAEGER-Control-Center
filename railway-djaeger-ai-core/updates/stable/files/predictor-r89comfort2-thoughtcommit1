    case "${USER_MODE:-AUTO}" in
      DINGIN) _ceil=37;; NYAMAN) _ceil=40;; HANGAT) _ceil=43;; PANAS) _ceil=45;; *) _ceil=NA;;
    esac
    printf "COMFORT_CEILING_C='%s'\n" "$_ceil"
    printf "CONFIDENCE='%s'\n" "${CONFIDENCE:-NA}"
    printf "REASON='%s'\n" "$(printf '%s' "${REASON:-${RATIONALE:-NA}}" | tr '\r\n' '  ' | sed "s/'/_/g")"
    printf "PREDICTED_SKIN='%s'\n" "${SKIN_FORECAST_2M:-NA}"
    printf "PREDICTED_FPS='%s'\n" "${FPS_FORECAST_2M:-NA}"
    printf "SESSION_ID='%s'\n" "${SESSION_ID:-0}"
    printf "POLICY_AT='%s'\n" "${POLICY_AT:-0}"
    printf "FORMULA_TTL_SEC='120'\n"
    _formula_complete=YES
    for _v in PROFILE LITTLE_MIN LITTLE_MAX BIG_MIN BIG_MAX GPU_MIN GPU_MAX; do
      eval "_vv=\${$_v:-}"
      [ -n "$_vv" ] || _formula_complete=NO
    done
    printf "FORMULA_COMPLETE='%s'\n" "$_formula_complete"
    _formula_bounds=YES
    _num(){ case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
    for _v in LITTLE_MIN LITTLE_MAX BIG_MIN BIG_MAX GPU_MIN GPU_MAX; do
      eval "_vv=\${$_v:-}"
      _num "$_vv" || _formula_bounds=NO
    done
    if [ "$_formula_bounds" = YES ]; then
      [ "$LITTLE_MIN" -le "$LITTLE_MAX" ] || _formula_bounds=NO
      [ "$BIG_MIN" -le "$BIG_MAX" ] || _formula_bounds=NO
      [ "$GPU_MIN" -le "$GPU_MAX" ] || _formula_bounds=NO
    fi
    printf "FORMULA_BOUNDS_VALID='%s'\n" "$_formula_bounds"
    _cap_bounds=YES
    _within(){
      _x="$1"; _lo="$2"; _hi="$3"
      _num "$_x" && _num "$_lo" && _num "$_hi" && [ "$_x" -ge "$_lo" ] && [ "$_x" -le "$_hi" ]
    }
    # Capability variables are populated by DJAEGER hardware discovery/contract.
    # Missing capability evidence is fail-closed, never guessed.
    _within "${LITTLE_MIN:-}" "${HW_LITTLE_MIN:-}" "${HW_LITTLE_MAX:-}" || _cap_bounds=NO
    _within "${LITTLE_MAX:-}" "${HW_LITTLE_MIN:-}" "${HW_LITTLE_MAX:-}" || _cap_bounds=NO
    _within "${BIG_MIN:-}" "${HW_BIG_MIN:-}" "${HW_BIG_MAX:-}" || _cap_bounds=NO
    _within "${BIG_MAX:-}" "${HW_BIG_MIN:-}" "${HW_BIG_MAX:-}" || _cap_bounds=NO
    _within "${GPU_MIN:-}" "${HW_GPU_MIN:-}" "${HW_GPU_MAX:-}" || _cap_bounds=NO
    _within "${GPU_MAX:-}" "${HW_GPU_MIN:-}" "${HW_GPU_MAX:-}" || _cap_bounds=NO
    printf "FORMULA_LIVE_CAPABILITY_VALID='%s'\n" "$_cap_bounds"
    _opp_exact=YES
    _opp_has(){ case " $1 " in *" $2 "*) return 0;; *) return 1;; esac; }
    _opp_has "${HW_LITTLE_OPPS:-}" "${LITTLE_MIN:-}" || _opp_exact=NO
    _opp_has "${HW_LITTLE_OPPS:-}" "${LITTLE_MAX:-}" || _opp_exact=NO
    _opp_has "${HW_BIG_OPPS:-}" "${BIG_MIN:-}" || _opp_exact=NO
    _opp_has "${HW_BIG_OPPS:-}" "${BIG_MAX:-}" || _opp_exact=NO
    _opp_has "${HW_GPU_OPPS:-}" "${GPU_MIN:-}" || _opp_exact=NO
    _opp_has "${HW_GPU_OPPS:-}" "${GPU_MAX:-}" || _opp_exact=NO
    printf "FORMULA_EXACT_OPP_VALID='%s'\n" "$_opp_exact"
    _gov_valid=YES
    if [ -n "${CPU_GOVERNOR:-}" ]; then
      [ "${HW_LITTLE_GOV_SRC:-}" = LIVE_SYSFS ] && [ "${HW_BIG_GOV_SRC:-}" = LIVE_SYSFS ] || _gov_valid=NO
      _opp_has "${HW_LITTLE_GOVS:-}" "$CPU_GOVERNOR" || _gov_valid=NO
      _opp_has "${HW_BIG_GOVS:-}" "$CPU_GOVERNOR" || _gov_valid=NO
    fi
    if [ -n "${GPU_GOVERNOR:-}" ]; then
      [ "${HW_GPU_GOV_SRC:-}" = LIVE_SYSFS ] || _gov_valid=NO
      _opp_has "${HW_GPU_GOVS:-}" "$GPU_GOVERNOR" || _gov_valid=NO
    fi
    printf "FORMULA_GOVERNOR_CAPABILITY_VALID='%s'\n" "$_gov_valid"
    printf "GOVERNOR_CAPABILITY_TRUST='%s'\n" "${HW_GOV_TRUST:-UNKNOWN}"
    printf "GOVERNOR_SOURCE_LITTLE='%s'\n" "${HW_LITTLE_GOV_SRC:-UNKNOWN}"
    printf "GOVERNOR_SOURCE_BIG='%s'\n" "${HW_BIG_GOV_SRC:-UNKNOWN}"
    printf "GOVERNOR_SOURCE_GPU='%s'\n" "${HW_GPU_GOV_SRC:-UNKNOWN}"
    printf "CAP_LITTLE='%s..%s'\n" "${HW_LITTLE_MIN:-UNKNOWN}" "${HW_LITTLE_MAX:-UNKNOWN}"
    printf "CAP_BIG='%s..%s'\n" "${HW_BIG_MIN:-UNKNOWN}" "${HW_BIG_MAX:-UNKNOWN}"
    printf "CAP_GPU='%s..%s'\n" "${HW_GPU_MIN:-UNKNOWN}" "${HW_GPU_MAX:-UNKNOWN}"
    printf "CAPABILITY_BOOT_ID='%s'\n" "${_cb:-UNKNOWN}"
    printf "CAPABILITY_SESSION_ID='%s'\n" "${_cs:-UNKNOWN}"
    printf "CAPABILITY_CONTEXT_VERIFIED='%s'\n" "$([ -n "${_cb:-}" ] && [ -n "${_cs:-}" ] && echo YES || echo NO)"
    printf "CAPABILITY_GENERATION_ID='%s'\n" "${_cg:-UNKNOWN}"
    printf "CAPABILITY_CONTENT_SIG='%s'\n" "${_sig:-UNKNOWN}"
    printf "CAPABILITY_CONTENT_EPOCH='%s'\n" "${_epoch:-UNKNOWN}"
    printf "CAPABILITY_TRUST='%s'\n" "${_trust:-UNKNOWN}"
    printf "CAPABILITY_SOURCE_LITTLE='%s'\n" "${_src_l:-UNKNOWN}"
    printf "CAPABILITY_SOURCE_BIG='%s'\n" "${_src_b:-UNKNOWN}"
    printf "CAPABILITY_SOURCE_GPU='%s'\n" "${_src_g:-UNKNOWN}"
    printf "CAPABILITY_OPP_CANONICAL='%s'\n" "${_opp_canon:-NO}"
    printf "CAPABILITY_GOVERNOR_CANONICAL='%s'\n" "${_gov_canon:-NO}"
    printf "FORMULA_OWNER_MODE='%s'\n" "${USER_MODE:-AUTO}"
    printf "FORMULA_PROFILE='%s'\n" "${PROFILE:-UNKNOWN}"
    printf "FORMULA_GAME='%s'\n" "${GAME:-UNKNOWN}"
    printf "FORMULA_OBSERVATION_AT='%s'\n" "${NOW:-0}"
    _obs_fps="${FPS:-NA}"
    _obs_fps_source=UNVERIFIED_RUNTIME_INPUT
    [ "$_obs_fps" = NA ] && _obs_fps_source=UNAVAILABLE
    case "$_obs_fps" in
      ''|*[!0-9.]*) _obs_fps=NA ;;
