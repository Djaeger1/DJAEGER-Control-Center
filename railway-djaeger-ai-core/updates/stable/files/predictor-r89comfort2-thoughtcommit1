  if [ -r "$POL" ]; then
    _policy_until="$(awk -v k=POLICY_UNTIL 'index($0,k"=\047")==1&&substr($0,length($0),1)=="\047"{print substr($0,length(k)+3,length($0)-length(k)-3);exit}' "$POL" 2>/dev/null)"
    case "$_policy_until" in ''|*[!0-9]*) :;; *)
      POLICY_REMAIN_SEC=$((_policy_until-NOW_LOOP))
      [ "$POLICY_REMAIN_SEC" -le "$POLICY_REFRESH_LEAD_SEC" ] 2>/dev/null && [ "$AGE" -ge 30 ] 2>/dev/null && SHOULD_REASON=1
    ;; esac
  elif [ "$AGE" -ge 30 ] 2>/dev/null; then
    SHOULD_REASON=1
  fi

  [ "$SHOULD_REASON" -eq 1 ] || { sleep 20; continue; }
  PRE_CONTEXT_ID="$(reasoning_context_identity)"
  analyze 0; RC=$?; NOW_LOOP=$(date +%s)
  POST_CONTEXT_ID="$(reasoning_context_identity)"
  if [ "$RC" -eq 0 ] && [ "$PRE_CONTEXT_ID" != "$POST_CONTEXT_ID" ]; then
    # Fail closed: a Gemini proposal reasoned over a session/window/mode that changed
    # while the request was in flight must never become executable policy.
    rm -f "$POL" "$ROOT_AUTHORITY_POLICY" 2>/dev/null
    RC=31
    GEMINI_WAS_UNAVAILABLE=1
    resync_publish NEEDS_RESYNC CONTEXT_CHANGED_DURING_REASONING
    reasoning_trace_publish INVALIDATED_CONTEXT_CHANGE CONTEXT_CHANGED_DURING_REASONING
    plog "REASONING_CONTEXT_INVALIDATED pre=$PRE_CONTEXT_ID post=$POST_CONTEXT_ID POLICY_REMOVED=1"
  fi
  if [ "$RC" -eq 0 ]; then
    FAILS=0; LAST_GEMINI_AT=$NOW_LOOP; LAST_EVENT_SIG="$EVENT_SIG"
    if [ "$GEMINI_WAS_UNAVAILABLE" -eq 1 ]; then
      resync_publish RESYNCED FRESH_CONTEXT_ACCEPTED_AFTER_UNAVAILABLE
      plog "GEMINI_STATE_RESYNC COMPLETE fresh_telemetry=1 prior_outcomes=1 session_context=1"
    else
      resync_publish SYNCHRONIZED VALIDATED_REASONING_COMMITTED
    fi
    GEMINI_WAS_UNAVAILABLE=0
    plog "REASONING_EVENT COMMITTED signature=$EVENT_SIG max_refresh=${EVENT_MAX_GAP}s"
  else
    FAILS=$((FAILS+1))
    if [ "$RC" -eq 11 ] || [ "$RC" -eq 13 ]; then WAIT=20; FAILS=0
    elif [ "$RC" -eq 23 ]; then WAIT=900
    elif [ "$RC" -eq 24 ] || [ "$RC" -eq 25 ]; then WAIT=300
    elif [ "$RC" -eq 22 ]; then WAIT=120
    elif [ "$RC" -eq 29 ]; then WAIT="${GEMINI_COOLDOWN_WAIT:-900}"; case "$WAIT" in ''|*[!0-9]*) WAIT=900;; esac; [ "$WAIT" -lt 20 ] && WAIT=20; [ "$WAIT" -gt 900 ] && WAIT=900
    elif [ "$RC" -eq 31 ]; then WAIT=45
    elif [ "$FAILS" -ge 3 ]; then WAIT=600
    else WAIT=180; fi
    LAST_GEMINI_AT=$((NOW_LOOP+WAIT-EVENT_MAX_GAP)); LAST_EVENT_SIG="$EVENT_SIG"
    GEMINI_WAS_UNAVAILABLE=1; resync_publish NEEDS_RESYNC "GEMINI_UNAVAILABLE_RC_$RC"
    reasoning_trace_publish LOCAL_FALLBACK "GEMINI_UNAVAILABLE_RC_$RC"
    plog "UNAVAILABLE RC=$RC BACKOFF=${WAIT}s LOCAL_ONLY_CONTINUES=1 EVENT_DRIVEN=1 RESYNC_REQUIRED=1"
  fi
  sleep 20
done