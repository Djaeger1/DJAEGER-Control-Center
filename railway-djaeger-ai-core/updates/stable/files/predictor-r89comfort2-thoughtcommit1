json_escape(){
  # JSON permits no raw C0 control bytes. Preserve UTF-8, drop uncommon C0
  # controls, and encode TAB/CR/LF plus quote/backslash deterministically.
  # The tr ranges intentionally exclude TAB (011), LF (012) and CR (015),
  # which are encoded below instead of removed.
  printf '%s' "$1" \
    | tr -d '\000-\010\013\014\016-\037' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
    | awk 'BEGIN{ORS="";tab=sprintf("%c",9);cr=sprintf("%c",13)}{gsub(tab,"\\t");gsub(cr,"\\r");if(NR>1)printf "\\n";printf "%s",$0}'
}
esc(){ json_escape "$1"; }
