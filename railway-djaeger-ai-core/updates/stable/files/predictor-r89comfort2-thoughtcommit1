gemini_rate_cooldown_file(){ printf '%s' "$P/gemini_key_cooldowns"; }
gemini_rate_mark_current(){
  _vault="$P/gemini_keys.vault"; [ -r "$_vault" ] || return 1
  _now=$(date +%s); _until=$((_now + 900)); _slot=0; _n=0
  while IFS= read -r _k; do [ -n "$_k" ] || continue; _n=$((_n+1)); [ "$_k" = "$GEMINI_API_KEY" ] && { _slot=$_n; break; }; done <"$_vault"
  [ "$_slot" -gt 0 ] || return 1
  _cf="$(gemini_rate_cooldown_file)"; _tmp="$_cf.tmp.$$"; umask 077
  awk -F'|' -v s="$_slot" '$1!=s' "$_cf" 2>/dev/null >"$_tmp" || :
  printf '%s|%s|429\n' "$_slot" "$_until" >>"$_tmp"
  chmod 600 "$_tmp" 2>/dev/null; mv -f "$_tmp" "$_cf"
  plog "GEMINI_KEY_COOLDOWN SLOT=$_slot REASON=429 UNTIL=$_until SECRET_MASKED=1"
  return 0
}
gemini_rate_cooldown_until(){
  _grcu_want="$1"; _grcu_cf="$(gemini_rate_cooldown_file)"; _grcu_found=0
  [ -r "$_grcu_cf" ] || { printf '0'; return 0; }
  while IFS='|' read -r _grcu_s _grcu_u _grcu_reason; do
    [ "${_grcu_s:-}" = "$_grcu_want" ] || continue
    case "${_grcu_u:-}" in ''|*[!0-9]*) _grcu_u=0;; esac
    _grcu_found="$_grcu_u"
  done <"$_grcu_cf"
  printf '%s' "${_grcu_found:-0}"
}
gemini_rate_activate(){
  _gra_key="$1"; _gra_slot="$2"; _gra_reason="$3"
  [ -n "$_gra_key" ] || return 1
  _gra_tmp="$CFG.tmp.$$"
  if [ -r "$CFG" ]; then
    awk -v k="$_gra_key" 'BEGIN{done=0} /^GEMINI_API_KEY=/{print "GEMINI_API_KEY=\047" k "\047";done=1;next} {print} END{if(!done)print "GEMINI_API_KEY=\047" k "\047"}' "$CFG" >"$_gra_tmp" || { rm -f "$_gra_tmp"; return 1; }
  else
    printf "GEMINI_API_KEY='%s'\n" "$_gra_key" >"$_gra_tmp" || return 1
  fi
  chmod 600 "$_gra_tmp" 2>/dev/null && mv -f "$_gra_tmp" "$CFG" || { rm -f "$_gra_tmp"; return 1; }
  GEMINI_API_KEY="$_gra_key"; rm -f "$SERVER_STATE" 2>/dev/null
  plog "GEMINI_KEY_PREFLIGHT ACTIVE_SLOT=$_gra_slot REASON=$_gra_reason MODE=AUTO SECRET_MASKED=1"
  return 0
}
gemini_rate_preflight(){
  GEMINI_COOLDOWN_WAIT=0
  _grpf_vault="$P/gemini_keys.vault"; [ -r "$_grpf_vault" ] || return 0
  _grpf_now=$(date +%s); _grpf_n=0; _grpf_current_slot=0; _grpf_current_until=0
  _grpf_ready=""; _grpf_ready_slot=0; _grpf_earliest=0
  while IFS= read -r _grpf_k; do
    [ -n "$_grpf_k" ] || continue
    _grpf_n=$((_grpf_n+1)); _grpf_until="$(gemini_rate_cooldown_until "$_grpf_n")"
    case "${_grpf_until:-}" in ''|*[!0-9]*) _grpf_until=0;; esac
    if [ "$_grpf_k" = "$GEMINI_API_KEY" ]; then _grpf_current_slot=$_grpf_n; _grpf_current_until=$_grpf_until; fi
    if [ "$_grpf_until" -le "$_grpf_now" ] 2>/dev/null && [ -z "$_grpf_ready" ]; then _grpf_ready="$_grpf_k"; _grpf_ready_slot=$_grpf_n; fi
    if [ "$_grpf_until" -gt "$_grpf_now" ] 2>/dev/null; then
      if [ "$_grpf_earliest" -eq 0 ] 2>/dev/null || [ "$_grpf_until" -lt "$_grpf_earliest" ] 2>/dev/null; then _grpf_earliest=$_grpf_until; fi
    fi
  done <"$_grpf_vault"
  # A configured key outside the managed vault keeps its existing manual semantics.
  [ "$_grpf_current_slot" -gt 0 ] 2>/dev/null || return 0
  # Current managed key is ready: no rotation and no delay.
  [ "$_grpf_current_until" -le "$_grpf_now" ] 2>/dev/null && return 0
  # Current key is cooling but another managed slot is ready: activate it before curl.
  if [ -n "$_grpf_ready" ]; then
    gemini_rate_activate "$_grpf_ready" "$_grpf_ready_slot" CURRENT_SLOT_COOLDOWN || return 1
    return 0
  fi
  # Every managed slot is cooling. Strict hold: do not reach any Gemini curl.
  if [ "$_grpf_earliest" -gt "$_grpf_now" ] 2>/dev/null; then
    GEMINI_COOLDOWN_WAIT=$((_grpf_earliest-_grpf_now)); [ "$GEMINI_COOLDOWN_WAIT" -lt 1 ] && GEMINI_COOLDOWN_WAIT=1
    printf "HTTP_CODE='COOLDOWN_HOLD'\nCOOLDOWN_UNTIL='%s'\nAT='%s'\nPROVIDER='GEMINI'\nMODEL='%s'\n" "$_grpf_earliest" "$_grpf_now" "${MODEL:-gemini-3.6-flash}" >"$HTTPSTATE"
    plog "GEMINI_KEY_COOLDOWN_HOLD ALL_SLOTS=1 UNTIL=$_grpf_earliest WAIT=${GEMINI_COOLDOWN_WAIT}s FALLBACK=HERMES_H2 NO_REQUEST=1"
    return 1
  fi
  return 0
}

gemini_rate_failover(){
  _vault="$P/gemini_keys.vault"; [ -r "$_vault" ] || return 1
  _cf="$(gemini_rate_cooldown_file)"; _now=$(date +%s); _current="$GEMINI_API_KEY"; _next=""; _nextslot=0; _n=0
  while IFS= read -r _k; do
    [ -n "$_k" ] || continue; _n=$((_n+1)); [ "$_k" = "$_current" ] && continue
    _until=$(awk -F'|' -v s="$_n" '$1==s{u=$2}END{print u+0}' "$_cf" 2>/dev/null)
    [ "${_until:-0}" -gt "$_now" ] && continue
    _next="$_k"; _nextslot=$_n; break
  done <"$_vault"
  [ -n "$_next" ] || { plog "GEMINI_KEY_ROTATION EXHAUSTED=1 FALLBACK=HERMES_H2"; return 1; }
  _tmp="$CFG.tmp.$$"
  awk -v k="$_next" 'BEGIN{done=0} /^GEMINI_API_KEY=/{print "GEMINI_API_KEY=\047" k "\047";done=1;next} {print} END{if(!done)print "GEMINI_API_KEY=\047" k "\047"}' "$CFG" >"$_tmp" || { rm -f "$_tmp"; return 1; }
  chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$CFG" || { rm -f "$_tmp"; return 1; }
  GEMINI_API_KEY="$_next"; rm -f "$SERVER_STATE" 2>/dev/null
  plog "GEMINI_KEY_ROTATION ACTIVE_SLOT=$_nextslot REASON=429 MODE=AUTO SECRET_MASKED=1"
  unset _next _current _k
  return 0
}

gemini_auth_failover(){
  _vault="$P/gemini_keys.vault"; [ -r "$_vault" ] || return 1
  _current="$GEMINI_API_KEY"; _next=""; _fallback=""; _seen=0; _n=0; _now=$(date +%s)
  # r92: auth failover obeys the same managed-slot cooldown contract as 429 rotation.
  # Prefer the first READY slot after the current key, then wrap to the first READY
  # slot before it. A cooling slot is never selected for an auth retry.
  while IFS= read -r _k; do
    [ -n "$_k" ] || continue; _n=$((_n+1))
    if [ "$_k" = "$_current" ]; then _seen=1; continue; fi
    _until="$(gemini_rate_cooldown_until "$_n")"; case "${_until:-}" in ''|*[!0-9]*) _until=0;; esac
    [ "$_until" -gt "$_now" ] 2>/dev/null && continue
    if [ "$_seen" -eq 1 ]; then _next="$_k"; break; fi
    [ -n "$_fallback" ] || _fallback="$_k"
  done <"$_vault"
  [ -n "$_next" ] || _next="$_fallback"
  [ -n "$_next" ] || { plog "GEMINI_AUTH_FAILOVER NO_READY_SLOT=1 FALLBACK=HERMES_H2 NO_REQUEST=1"; return 1; }
  _tmp="$CFG.tmp.$$"
  if [ -r "$CFG" ]; then
    awk -v k="$_next" 'BEGIN{done=0} /^GEMINI_API_KEY=/{print "GEMINI_API_KEY=\047" k "\047";done=1;next} {print} END{if(!done)print "GEMINI_API_KEY=\047" k "\047"}' "$CFG" >"$_tmp" || { rm -f "$_tmp"; return 1; }
  else
    printf "GEMINI_API_KEY='%s'\n" "$_next" >"$_tmp" || return 1
  fi
  chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$CFG" || { rm -f "$_tmp"; return 1; }
  GEMINI_API_KEY="$_next"; unset _next _current _k
  plog "GEMINI_KEY_FAILOVER REASON=AUTH_INVALID BACKUP_SELECTED=1 SECRET_MASKED=1"
  return 0
}

analyze(){
  OUTCOME_ONLY="${1:-0}"
  [ -r "$CFG" ] || return 10
  [ -r "$TEL" ] || return 11
  . "$CFG" 2>/dev/null
  [ -n "$GEMINI_API_KEY" ] || return 12
  # v12.9.48 final-boundary model pin for Interactions API.
  MODEL='gemini-3.6-flash'
  EXECUTIONCTX="NO_PREVIOUS_EXECUTION_FEEDBACK"
  if [ -r "$RESOURCE_EXECUTION_FEEDBACK" ]; then
    EXECUTIONCTX="$(sed -n '1,36p' "$RESOURCE_EXECUTION_FEEDBACK" 2>/dev/null | tr '\n' ';' | cut -c1-2200)"
    [ -n "$EXECUTIONCTX" ] || EXECUTIONCTX="NO_PREVIOUS_EXECUTION_FEEDBACK"
  fi
  # Migrate only DJAEGER's known retired/temporary defaults. Preserve an explicit
  # user-selected different model.
  case "$MODEL" in gemini3.6flash|gemini-2.5-flash) MODEL=gemini-3.6-flash;; gemini3.7flash) MODEL=gemini-3.7-flash;; gemini3.5flash) MODEL=gemini-3.5-flash;; gemini3.5flashlite|gemini-3.5-flash-lite) MODEL=gemini-3.5-flash-lite;; esac

  # v12.2.5 read the authoritative window context before selecting telemetry.
  CURRENT_WINDOW_MODE="INACTIVE"; CURRENT_WINDOW_EPOCH=0
  if [ -r "$WINDOW_CTX" ]; then
    CURRENT_WINDOW_MODE="$(sed -n "s/^WINDOW_MODE='\([^']*\)'.*/\1/p" "$WINDOW_CTX" 2>/dev/null | head -1)"
    CURRENT_WINDOW_EPOCH="$(sed -n "s/^WINDOW_EPOCH='\([0-9][0-9]*\)'.*/\1/p" "$WINDOW_CTX" 2>/dev/null | head -1)"
  fi
  [ -n "$CURRENT_WINDOW_MODE" ] || CURRENT_WINDOW_MODE="INACTIVE"
  case "$CURRENT_WINDOW_EPOCH" in ''|*[!0-9]*) CURRENT_WINDOW_EPOCH=0;; esac

  # v12.3.0 schema firewall: pre-game-scoped learning is not trusted for autonomous reuse.
  for _mf in "$LEARNED" "$DYNLEARN" "$EFFMEM" "$HWLEARN"; do
    [ -r "$_mf" ] || continue
    _hdr="$(head -n 1 "$_mf" 2>/dev/null)"
    case "$_hdr" in *,game_id|*,game_id,user_mode) :;; *) mv -f "$_mf" "$_mf.legacy_pre_v1230" 2>/dev/null; plog "LEARNING_QUARANTINE file=${_mf##*/} reason=missing_game_id";; esac
  done

  # v12.3.0 bind all learned knowledge to the active game before any memory query.
  GAME_ID="$(cat "$SESSION_GAME" 2>/dev/null)"; [ -n "$GAME_ID" ] || GAME_ID=UNKNOWN
