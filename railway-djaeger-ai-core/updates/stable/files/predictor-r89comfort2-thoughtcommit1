# v12.9.1: one authoritative distiller for persistent device knowledge. It is
# called both before Gemini reasoning and immediately after a mature hardware
# outcome is committed, so the model cannot lag one predictor cycle behind.
refresh_device_knowledge(){
  _dk_wm="$1"; _dk_game="$2"; _dk_now="$(date +%s)"
  DEVICECTX="INSUFFICIENT_DEVICE_EVIDENCE"
  if [ -r "$HWLEARN" ]; then
    DEVICECTX="$(awk -F, -v wm="$_dk_wm" -v game="$_dk_game" -v um="${USER_MODE:-AUTO}" -v now="$_dk_now" '
      NR>1&&$17==wm&&$18==game&&$19==um&&(now-$1)>=0&&(now-$1)<=1209600 {
        n++; cls[$16]++; k="L"$4"-"$5"_B"$6"-"$7"_G"$8"-"$9; bn[k]++;
        if($13~/^-?[0-9.]+$/){bf[k]+=$13; fn[k]++}
        if($14~/^-?[0-9.]+$/){bs[k]+=$14; sn[k]++}
        if($12~/^-?[0-9.]+$/){bp[k]+=$12; pn[k]++}
      }
      END {
        printf "samples=%d success_classes[efficient=%d performance=%d thermal=%d balanced=%d reject=%d]",n+0,cls["EFFICIENT"]+0,cls["PERFORMANCE"]+0,cls["THERMAL"]+0,cls["BALANCED"]+0,cls["REJECT"]+0;
        shown=0; for(k in bn) if(shown<5){printf ";budget=%s n=%d",k,bn[k]; if(fn[k])printf " fps_delta=%.1f",bf[k]/fn[k]; if(sn[k])printf " skin_delta=%.1f",bs[k]/sn[k]; if(pn[k])printf " power_delta_pct=%.1f",bp[k]/pn[k]; shown++}
      }' "$HWLEARN" 2>/dev/null | cut -c1-2200)"
    [ -n "$DEVICECTX" ] || DEVICECTX="INSUFFICIENT_DEVICE_EVIDENCE"
  if [ -n "$EXECUTIONCTX" ]; then
    DEVICECTX="$DEVICECTX;PREVIOUS_EXECUTION_FEEDBACK=$EXECUTIONCTX"
  fi
  fi
  if [ -r "$FORESIGHT_CAL" ]; then
    _DKCAL="$(tail -n 30 "$FORESIGHT_CAL" 2>/dev/null | awk -F, -v wm="$_dk_wm" -v game="$_dk_game" '$9==wm&&$10==game&&$2~/^[0-9.]+$/&&$3~/^[0-9.]+$/{n++;se+=$2;fe+=$3}END{if(n)printf ";forecast_n=%d skin_mae=%.2fC fps_mae=%.2f",n,se/n,fe/n}')"
    [ -n "$_DKCAL" ] && DEVICECTX="$DEVICECTX$_DKCAL"
  fi
  _DMT="$DEVICE_MODEL.tmp.$$"
  printf 'updated_at=%s\ngame=%s\nwindow_mode=%s\nknowledge=%s\n' "$_dk_now" "$_dk_game" "$_dk_wm" "$DEVICECTX" >"$_DMT" 2>/dev/null && chmod 600 "$_DMT" 2>/dev/null && mv -f "$_DMT" "$DEVICE_MODEL" 2>/dev/null
}


