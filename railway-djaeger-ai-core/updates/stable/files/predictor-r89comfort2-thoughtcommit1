          *.) _obs_fps=NA ;;
          *)
            _fps_int="${_obs_fps%%.*}"
            case "$_fps_int" in ''|*[!0-9]*) _obs_fps=NA ;; *)
              if [ "$_fps_int" -gt 1000 ] 2>/dev/null; then
                _obs_fps=NA
              elif [ "$_fps_int" -eq 1000 ] 2>/dev/null; then
                case "$_obs_fps" in 1000|1000.0|1000.00|1000.000) ;; *) _obs_fps=NA;; esac
              fi
            esac
          ;;
        esac
      ;;
    esac
    _obs_identity="${NOW:-0}|${GAME:-UNKNOWN}|${USER_MODE:-AUTO}|${PROFILE:-UNKNOWN}|FPS=${_obs_fps}"
    printf "FORMULA_OBSERVATION_FPS='%s'\n" "$_obs_fps"
