publish_runtime_heartbeat(){
  _rh_now="$(date +%s)"
  _rh_active="${1:-$ACTIVE}"; _rh_game="${2:-${F:-NA}}"; _rh_window="${3:-${WINDOW_MODE:-INACTIVE}}"
  printf "controller_pid='%s'\npredictor_pid='%s'\nactive='%s'\ngame='%s'\nwindow_mode='%s'\nuser_mode='%s'\nupdated_at='%s'\n" "$$" "$(cat "$P/predictor.pid" 2>/dev/null)" "$_rh_active" "${_rh_game:-NA}" "$_rh_window" "$USER_MODE" "$_rh_now" >"$P/runtime_status.tmp.$$" 2>/dev/null && { chmod 600 "$P/runtime_status.tmp.$$" 2>/dev/null; mv -f "$P/runtime_status.tmp.$$" "$P/runtime_status"; }
  printf '%s\n' "$_rh_now" >"$P/controller.heartbeat.tmp.$$" 2>/dev/null && { chmod 600 "$P/controller.heartbeat.tmp.$$" 2>/dev/null; mv -f "$P/controller.heartbeat.tmp.$$" "$P/controller.heartbeat"; }
}
start_runtime_heartbeat_worker(){
  # LOOPFIX1: independent liveness publication. It updates only runtime_status
  # and the __RUNTIME__ snapshot section; hardware control stays in AI Agent.
  [ -r "$RUNTIME_HEARTBEAT_EXEC" ] || return 0
  _owner_birth="$(proc_starttime "$$")"
  sh "$RUNTIME_HEARTBEAT_EXEC" "$$" "$_owner_birth" >/dev/null 2>&1 &
  _hbp=$!
  printf '%s\n' "$_hbp" >"$RUNTIME_HEARTBEAT_PID.tmp.$$" 2>/dev/null && {
    chmod 600 "$RUNTIME_HEARTBEAT_PID.tmp.$$" 2>/dev/null
    mv -f "$RUNTIME_HEARTBEAT_PID.tmp.$$" "$RUNTIME_HEARTBEAT_PID"
  }
  log "LOOPFIX1 RUNTIME_HEARTBEAT_STARTED PID=$_hbp OWNER=$$"
}

