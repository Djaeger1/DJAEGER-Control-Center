  # Historical penalty only when the exact same dynamic budget repeatedly failed.
  if { [ "${POLICY_CONTROL_MODE:-PROFILE}" = "DYNAMIC" ] || [ "${POLICY_CONTROL_MODE:-PROFILE}" = "ENVELOPE" ]; } && [ -r "$DYNLEARN" ]; then
    STATS="$(awk -F, -v a="$POLICY_LITTLE_MIN" -v b="$POLICY_LITTLE_MAX" -v c="$POLICY_BIG_MIN" -v d="$POLICY_BIG_MAX" -v e="$POLICY_GPU_MIN" -v f="$POLICY_GPU_MAX" -v wm="$WINDOW_MODE" -v game="${SESSION_GAME_ID:-UNKNOWN}" -v um="${USER_MODE:-AUTO}" -v now="$(date +%s)" 'NR>1&&$5==a&&$6==b&&$7==c&&$8==d&&$9==e&&$10==f&&$18==wm&&$19==game&&$20==um&&(now-$1)>=0&&(now-$1)<=1209600{n++;if($4=="SUCCESS")ok++;else if($4=="FAILED")bad++;else if($4=="MIXED")mix++}END{printf "%d %d %d %d",n,ok,bad,mix}' "$DYNLEARN" 2>/dev/null)"
    set -- $STATS; HN=${1:-0}; HOK=${2:-0}; HBAD=${3:-0}; HMIX=${4:-0}
    if [ "$HN" -ge 3 ] && [ "$HBAD" -gt "$HOK" ]; then SCORE=$((SCORE-25)); SHADOW_REASON="HISTORICAL_FAILURE_PENALTY"
    elif [ "$HN" -ge 3 ] && [ "$HMIX" -ge 2 ] && [ "$HOK" -eq 0 ]; then SCORE=$((SCORE-12)); SHADOW_REASON="REPEATED_MIXED_REGRET"
    else SHADOW_REASON="HISTORY_OK"; fi
  else SHADOW_REASON="PROFILE_OR_NEW_PLAN"; fi
  [ "$SCORE" -lt 0 ] && SCORE=0; [ "$SCORE" -gt 100 ] && SCORE=100
  SHADOW_SCORE="$SCORE"
  if [ "$SCORE" -ge 65 ]; then SHADOW_STATE="PROMOTED"; else SHADOW_STATE="REJECT"; fi
  NOWS=$(date +%s)
  printf "STATE='%s'\nSCORE='%s'\nREASON='%s'\nMODE='%s'\nPROFILE='%s'\nLITTLE='%s-%s'\nBIG='%s-%s'\nGPU='%s-%s'\nUPDATED_AT='%s'\n" "$SHADOW_STATE" "$SHADOW_SCORE" "$SHADOW_REASON" "${POLICY_CONTROL_MODE:-PROFILE}" "${POLICY_PROFILE:-NA}" "${POLICY_LITTLE_MIN:-NA}" "${POLICY_LITTLE_MAX:-NA}" "${POLICY_BIG_MIN:-NA}" "${POLICY_BIG_MAX:-NA}" "${POLICY_GPU_MIN:-NA}" "${POLICY_GPU_MAX:-NA}" "$NOWS" >"$SHADOW.tmp" 2>/dev/null && { chmod 600 "$SHADOW.tmp" 2>/dev/null; mv -f "$SHADOW.tmp" "$SHADOW"; }
  [ -f "$PLANHIST" ] || echo "epoch,state,score,reason,mode,profile,lmin,lmax,bmin,bmax,gmin,gmax" >"$PLANHIST"
  printf "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n" "$NOWS" "$SHADOW_STATE" "$SHADOW_SCORE" "$SHADOW_REASON" "${POLICY_CONTROL_MODE:-PROFILE}" "${POLICY_PROFILE:-NA}" "${POLICY_LITTLE_MIN:-NA}" "${POLICY_LITTLE_MAX:-NA}" "${POLICY_BIG_MIN:-NA}" "${POLICY_BIG_MAX:-NA}" "${POLICY_GPU_MIN:-NA}" "${POLICY_GPU_MAX:-NA}" >>"$PLANHIST"
  tail -n 80 "$PLANHIST" >"$PLANHIST.tmp" 2>/dev/null && mv -f "$PLANHIST.tmp" "$PLANHIST" 2>/dev/null
  [ "$SHADOW_STATE" = "PROMOTED" ]
}

predictive_read(){
  PREDICTIVE_ACTION="NONE"; PREDICTIVE_CONF=0; PREDICTIVE_STATE="LOCAL_ONLY"
  [ -r "$POLICY" ] || return
  unset POLICY_ACTION POLICY_PROFILE POLICY_CONTROL_MODE POLICY_LITTLE_MIN POLICY_LITTLE_MAX POLICY_BIG_MIN POLICY_BIG_MAX POLICY_GPU_MIN POLICY_GPU_MAX POLICY_CONFIDENCE POLICY_AT POLICY_MIN_UNTIL POLICY_UNTIL INTERVENTION_SECONDS EXIT_SKIN_C THERMAL_TREND PERFORMANCE_TREND THERMAL_RISK PERFORMANCE_RISK SKIN_FORECAST_2M FPS_FORECAST_2M POLICY_SESSION_ID POLICY_GAME POLICY_USER_MODE POLICY_WINDOW_MODE POLICY_WINDOW_EPOCH POLICY_ACCOUNTABILITY_STATUS POLICY_ACCOUNTABILITY_TRUSTED
  # v12.3.5: policy is DATA, never shell code. Accept only strict KEY='VALUE' records.
  policy_get(){ awk -v k="$1" 'index($0,k"=\047")==1 && substr($0,length($0),1)=="\047" {v=substr($0,length(k)+3,length($0)-length(k)-3); print v; exit}' "$POLICY" 2>/dev/null; }
  POLICY_ACTION="$(policy_get POLICY_ACTION)"; POLICY_PROFILE="$(policy_get POLICY_PROFILE)"; POLICY_CONTROL_MODE="$(policy_get POLICY_CONTROL_MODE)"
  POLICY_LITTLE_MIN="$(policy_get POLICY_LITTLE_MIN)"; POLICY_LITTLE_MAX="$(policy_get POLICY_LITTLE_MAX)"; POLICY_BIG_MIN="$(policy_get POLICY_BIG_MIN)"; POLICY_BIG_MAX="$(policy_get POLICY_BIG_MAX)"
  POLICY_GPU_MIN="$(policy_get POLICY_GPU_MIN)"; POLICY_GPU_MAX="$(policy_get POLICY_GPU_MAX)"; POLICY_CONFIDENCE="$(policy_get POLICY_CONFIDENCE)"
  POLICY_AT="$(policy_get POLICY_AT)"; POLICY_MIN_UNTIL="$(policy_get POLICY_MIN_UNTIL)"; POLICY_UNTIL="$(policy_get POLICY_UNTIL)"; INTERVENTION_SECONDS="$(policy_get INTERVENTION_SECONDS)"; EXIT_SKIN_C="$(policy_get EXIT_SKIN_C)"
  THERMAL_TREND="$(policy_get THERMAL_TREND)"; PERFORMANCE_TREND="$(policy_get PERFORMANCE_TREND)"; THERMAL_RISK="$(policy_get THERMAL_RISK)"; PERFORMANCE_RISK="$(policy_get PERFORMANCE_RISK)"
  SKIN_FORECAST_2M="$(policy_get SKIN_FORECAST_2M)"; FPS_FORECAST_2M="$(policy_get FPS_FORECAST_2M)"; POLICY_WINDOW_MODE="$(policy_get POLICY_WINDOW_MODE)"; POLICY_WINDOW_EPOCH="$(policy_get POLICY_WINDOW_EPOCH)"
  POLICY_SESSION_ID="$(policy_get POLICY_SESSION_ID)"; POLICY_GAME="$(policy_get POLICY_GAME)"; POLICY_USER_MODE="$(policy_get POLICY_USER_MODE)"; POLICY_ACCOUNTABILITY_STATUS="$(policy_get ACCOUNTABILITY_STATUS)"; POLICY_ACCOUNTABILITY_TRUSTED="$(policy_get ACCOUNTABILITY_TRUSTED)"
  NP="$(date +%s)"
  case "${POLICY_AT:-}" in ''|*[!0-9]*) PREDICTIVE_STATE="INVALID_CONTEXT"; return;; esac
  [ "$POLICY_AT" -le "$NP" ] || { PREDICTIVE_STATE="FUTURE_POLICY"; return; }
  [ "$NP" -le "${POLICY_UNTIL:-0}" ] || { PREDICTIVE_STATE="STALE"; return; }
  # r19 execution-time context lease. Predictor-side in-flight validation is not
  # enough: the session/mode/window can change after commit but before consumption.
  _ctx_sid="$(cat "$P/session_id" 2>/dev/null)"; _ctx_game="$(cat "$P/session_game" 2>/dev/null)"
  _ctx_um="$(cat "$USER_MODE_FILE" 2>/dev/null | tr '[:lower:]' '[:upper:]' | tr -d '\r\n ')"; [ -n "$_ctx_um" ] || _ctx_um=AUTO
  _ctx_we="$(cat "$WINDOW_EPOCH_FILE" 2>/dev/null)"; case "$_ctx_we" in ''|*[!0-9]*) _ctx_we=0;; esac
  [ -n "$POLICY_SESSION_ID" ] && [ "$POLICY_SESSION_ID" = "$_ctx_sid" ] || { PREDICTIVE_STATE="CONTEXT_SESSION_MISMATCH"; return; }
  [ -n "$POLICY_GAME" ] && [ "$POLICY_GAME" = "$_ctx_game" ] || { PREDICTIVE_STATE="CONTEXT_GAME_MISMATCH"; return; }
  [ "${POLICY_USER_MODE:-}" = "$_ctx_um" ] || { PREDICTIVE_STATE="CONTEXT_USER_MODE_MISMATCH"; return; }
  [ "${POLICY_WINDOW_MODE:-}" = "${WINDOW_MODE:-INACTIVE}" ] || { PREDICTIVE_STATE="CONTEXT_WINDOW_MISMATCH"; return; }
  [ "${POLICY_WINDOW_EPOCH:-}" = "$_ctx_we" ] || { PREDICTIVE_STATE="CONTEXT_EPOCH_MISMATCH"; return; }
  case "${POLICY_ACTION:-}" in KEEP|AVOID_RESPONSE|MORE_RESPONSE|COOLER|EXECUTE) ;; *) return;; esac
  case "${POLICY_CONFIDENCE:-}" in ''|*[!0-9]*) return;; esac
  # v12.9: confidence is evidence for Gemini's own strategy, not a Local veto.
  # Any schema-valid typed plan continues to execution validation.
  # v10.4 Dynamic Intervention: Gemini COOLER may finish early only after a
  # 30s minimum and only when local safety logic no longer requires COOL/SAFE.
  # This can never weaken local COOL/SAFE safety logic or native thermal safety.
  if [ "$POLICY_ACTION" = "COOLER" ] && [ "$NP" -ge "${POLICY_MIN_UNTIL:-$POLICY_UNTIL}" ] &&
     [ "$LOCAL_DECISION" != "COOL" ] && [ "$LOCAL_DECISION" != "SAFE" ]; then
    case "${EXIT_SKIN_C:-NA}" in ''|NA|*[!0-9]*) :;; *)
      if [ "$SKIN" -le "$EXIT_SKIN_C" ] && [ "$CPU" -le 60 ] && [ "$GPUT" -le 60 ] && [ "$BAT" -le 40 ]; then
        PREDICTIVE_STATE="EARLY_EXIT"
        if [ "${POLICY_AT:-}" != "$LAST_PRED_EARLY_AT" ]; then
          log "PREDICTIVE_EARLY_EXIT ACTION=COOLER EXIT_SKIN=$EXIT_SKIN_C CPU=${CPU}C GPU=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C LOCAL=$LOCAL_DECISION"
          LAST_PRED_EARLY_AT="${POLICY_AT:-}"
        fi
        return
      fi;;
    esac
  fi
  case "${POLICY_PROFILE:-}" in STABLE|PERFORM|RESPONSE|SOFT_COOL|COOL|FREEZE|SAFE) ;; *) PREDICTIVE_STATE="INVALID_PROFILE"; return;; esac
  if [ "${POLICY_PROFILE:-}" = FREEZE ] && [ "${LOCAL_DECISION:-STABLE}" != FREEZE ]; then PREDICTIVE_STATE="FREEZE_MANUAL_ONLY"; return; fi
  case "${POLICY_CONTROL_MODE:-PROFILE}" in PROFILE) :;; DYNAMIC|ENVELOPE) dynamic_valid "$POLICY_LITTLE_MIN" "$POLICY_LITTLE_MAX" "$POLICY_BIG_MIN" "$POLICY_BIG_MAX" "$POLICY_GPU_MIN" "$POLICY_GPU_MAX" || { PREDICTIVE_STATE="INVALID_DYNAMIC"; return; };; *) PREDICTIVE_STATE="INVALID_MODE"; return;; esac
  PREDICTIVE_ACTION="$POLICY_ACTION"; PREDICTIVE_CONF="$POLICY_CONFIDENCE"; PREDICTIVE_STATE="VALID"
}

publish_agent_brain_lease(){
  _ab="${BRAIN_SOURCE:-NONE}"; [ "$_ab" = NONE ] && _ab=NATIVE_FAILSAFE
  _did="NATIVE-$(date +%s)"
  if [ "$_ab" = GEMINI ]; then _did="${POLICY_AT:-$_did}"
  elif [ "$_ab" = HERMES_H2 ]; then _did="$(sed -n "s/^AT='\\([0-9][0-9]*\\)'.*/\\1/p" "$HERMES_PROPOSAL" 2>/dev/null | head -1)"; [ -n "$_did" ] || _did="HERMES-$(date +%s)"; fi
