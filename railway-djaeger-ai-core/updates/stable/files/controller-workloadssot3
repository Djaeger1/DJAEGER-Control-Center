valid_l(){ opp_has "$LITTLE_OPP_KHZ" "$1"; }
valid_b(){ opp_has "$BIG_OPP_KHZ" "$1"; }
valid_g(){ opp_has "$GPU_OPP_MHZ" "$1"; }
snapshot_value(){
  _k="$1"; _f="$2"
  sed -n "s/^${_k}=//p" "$_f" 2>/dev/null | tail -n 1
}
snapshot_valid(){
  _f="$1"; [ -r "$_f" ] || return 1
  [ "$(snapshot_value SCHEMA "$_f")" = "DJAEGER_ORIGINAL_STATE_V5" ] || return 1
  _snap_boot=$(snapshot_value BOOT_ID "$_f"); _cur_boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  [ -n "$_snap_boot" ] && [ -n "$_cur_boot" ] && [ "$_snap_boot" = "$_cur_boot" ] || return 1
  _snap_session=$(snapshot_value SESSION_ID "$_f"); _cur_session=$(cat "$P/session_id" 2>/dev/null)
  [ -n "$_snap_session" ] && [ -n "$_cur_session" ] && [ "$_snap_session" = "$_cur_session" ] || return 1
  _p0max=$(snapshot_value P0_MAX "$_f"); _p0min=$(snapshot_value P0_MIN "$_f"); _p0gov=$(snapshot_value P0_GOV "$_f")
  _p6max=$(snapshot_value P6_MAX "$_f"); _p6min=$(snapshot_value P6_MIN "$_f"); _p6gov=$(snapshot_value P6_GOV "$_f")
  _gmax=$(snapshot_value G_MAX "$_f"); _gmin=$(snapshot_value G_MIN "$_f"); _kmax=$(snapshot_value K_MAX "$_f"); _kmin=$(snapshot_value K_MIN "$_f"); _ggov=$(snapshot_value G_GOV "$_f")
  case "$_p0max:$_p0min:$_p6max:$_p6min:$_gmax:$_gmin:$_kmax:$_kmin" in *[!0-9:]*|*::*|:*) return 1;; esac
  # ORIGINAL STATE is a kernel runtime constraint snapshot, not a DJAEGER target plan.
  # Qualcomm may expose a valid scaling_min_freq between listed OPPs (observed on this
  # device: policy6=1104000 while the next listed OPP is 1228800). Preserve that raw
  # value for exact restore. Only AI/Local target plans are required to be exact OPPs.
  refresh_live_contract
  _p0lo=$(r "$P0/cpuinfo_min_freq"); _p0hi=$(r "$P0/cpuinfo_max_freq"); _p6lo=$(r "$P6/cpuinfo_min_freq"); _p6hi=$(r "$P6/cpuinfo_max_freq")
  [ -n "$_p0lo" ] || _p0lo=$(list_first "$LITTLE_OPP_KHZ"); [ -n "$_p0hi" ] || _p0hi=$(list_last "$LITTLE_OPP_KHZ")
  [ -n "$_p6lo" ] || _p6lo=$(list_first "$BIG_OPP_KHZ"); [ -n "$_p6hi" ] || _p6hi=$(list_last "$BIG_OPP_KHZ")
  [ "$_p0min" -ge "$_p0lo" ] && [ "$_p0max" -le "$_p0hi" ] && [ "$_p0min" -le "$_p0max" ] || return 1
  [ "$_p6min" -ge "$_p6lo" ] && [ "$_p6max" -le "$_p6hi" ] && [ "$_p6min" -le "$_p6max" ] || return 1
  # GPUFIX1: devfreq is the canonical runtime GPU policy constraint. KGSL
  # min/max_clock_mhz is an auxiliary capability/window and may legitimately be
  # wider than devfreq on Poco X5 5G (proven fixture: devfreq 266-770 MHz,
  # KGSL 266-840 MHz). Validate both interfaces independently and require the
  # canonical devfreq interval to be contained inside the KGSL window.
  _gmaxmhz=$((_gmax/1000000)); _gminmhz=$((_gmin/1000000))
  opp_has "$GPU_OPP_MHZ" "$_gmaxmhz" && opp_has "$GPU_OPP_MHZ" "$_gminmhz" || return 1
  opp_has "$GPU_OPP_MHZ" "$_kmax" && opp_has "$GPU_OPP_MHZ" "$_kmin" || return 1
  [ "$_gmax" -eq $((_gmaxmhz*1000000)) ] && [ "$_gmin" -eq $((_gminmhz*1000000)) ] || return 1
  [ "$_gmin" -le "$_gmax" ] && [ "$_kmin" -le "$_kmax" ] || return 1
  [ "$_kmin" -le "$_gminmhz" ] && [ "$_gmaxmhz" -le "$_kmax" ] || return 1
  _p0av=$(r "$P0/scaling_available_governors"); _p6av=$(r "$P6/scaling_available_governors"); _gav=$(r "$G/available_governors")
  case " $_p0av " in *" $_p0gov "*) :;; *) return 1;; esac
  case " $_p6av " in *" $_p6gov "*) :;; *) return 1;; esac
  if [ -n "$_gav" ]; then case " $_gav " in *" $_ggov "*) :;; *) return 1;; esac; fi
  return 0
}
save_original(){
  ORIG="/data/adb/djaeger_ai/original_state"; TMP="${ORIG}.tmp.$$"
  mkdir -p /data/adb/djaeger_ai 2>/dev/null
  _p0max=$(r "$P0/scaling_max_freq"); _p0min=$(r "$P0/scaling_min_freq"); _p0gov=$(r "$P0/scaling_governor")
  _p6max=$(r "$P6/scaling_max_freq"); _p6min=$(r "$P6/scaling_min_freq"); _p6gov=$(r "$P6/scaling_governor")
  _gmax=$(r "$G/max_freq"); _gmin=$(r "$G/min_freq"); _kmax=$(r "$K/max_clock_mhz"); _kmin=$(r "$K/min_clock_mhz"); _ggov=$(r "$G/governor")
  {
