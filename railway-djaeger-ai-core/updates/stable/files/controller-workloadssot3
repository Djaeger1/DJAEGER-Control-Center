opp_has(){ case " $1 " in *" $2 "*) return 0;; *) return 1;; esac; }
normalize_opp_numeric(){
  _raw="$1"; [ -n "$_raw" ] || return 1
  _out=""
  for _v in $_raw; do
    case "$_v" in ''|*[!0-9]*) return 1;; esac
    [ "$_v" -gt 0 ] 2>/dev/null || return 1
    case " $_out " in *" $_v "*) return 1;; esac
    _out="$_out $_v"
  done
  _sorted=""
  for _v in $_out; do
    _new=""; _placed=0
    for _x in $_sorted; do
      if [ "$_placed" -eq 0 ] && [ "$_v" -lt "$_x" ]; then _new="$_new $_v"; _placed=1; fi
      _new="$_new $_x"
    done
    [ "$_placed" -eq 1 ] || _new="$_new $_v"
    _sorted="$_new"
  done
  printf '%s\n' "${_sorted# }"
}
discover_cpu_opp(){
  _p="$1"
  _v=$(r "$_p/scaling_available_frequencies")
  _n=$(normalize_opp_numeric "$_v" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_EXACT_OPP_AVAILABLE_FREQ "$_n"; return 0; }
  if [ -r "$_p/stats/time_in_state" ]; then
    _v=$(awk '{print $1}' "$_p/stats/time_in_state" 2>/dev/null | tr '\n' ' ')
    _n=$(normalize_opp_numeric "$_v" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_EXACT_OPP_TIME_IN_STATE "$_n"; return 0; }
  fi
  _lo=$(r "$_p/cpuinfo_min_freq"); _hi=$(r "$_p/cpuinfo_max_freq")
  _n=$(normalize_opp_numeric "$_lo $_hi" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_RANGE_ONLY "$_n"; return 0; }
  printf '%s|\n' BASELINE_FALLBACK
}
discover_gpu_opp(){
  _v=$(r "$G/available_frequencies")
  _o=""; for _x in $_v; do case "$_x" in ''|*[!0-9]*) _o=""; break;; esac; [ "$_x" -gt 1000000 ] 2>/dev/null && _x=$((_x/1000000)); _o="$_o $_x"; done
  _n=$(normalize_opp_numeric "$_o" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_EXACT_OPP_DEVFREQ "$_n"; return 0; }
  _v=$(r "$K/gpu_available_frequencies")
  _o=""; for _x in $_v; do case "$_x" in ''|*[!0-9]*) _o=""; break;; esac; [ "$_x" -gt 1000000 ] 2>/dev/null && _x=$((_x/1000000)); _o="$_o $_x"; done
  _n=$(normalize_opp_numeric "$_o" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_EXACT_OPP_KGSL "$_n"; return 0; }
  _lo=$(r "$G/min_freq"); _hi=$(r "$G/max_freq")
  for _x in _lo _hi; do eval "_v=\${$_x}"; [ "$_v" -gt 1000000 ] 2>/dev/null && eval "$_x=$((_v/1000000))"; done
  _n=$(normalize_opp_numeric "$_lo $_hi" 2>/dev/null) && [ -n "$_n" ] && { printf '%s|%s\n' LIVE_RANGE_ONLY "$_n"; return 0; }
  printf '%s|\n' BASELINE_FALLBACK
