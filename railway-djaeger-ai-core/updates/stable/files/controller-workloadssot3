  vals SAFE || return 1; write_local_typed_policy SAFE "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
  sh "$AGENT_EXEC" execute-policy "$LOCAL_TYPED_POLICY" FREEZE_RETURN >/dev/null 2>&1 || return 1
  FREEZE_FRAME_RESCUE_ACTIVE=0; PROFILE=SAFE; PROFILE_APPLIED=SAFE; APPLIED_SIGNATURE=""; PROFILE_SINCE="$(date +%s)"; profile_map_publish SAFE
  log "FREEZE_FRAME_RESCUE RELEASE_FAILED action=SAFE"; return 0
