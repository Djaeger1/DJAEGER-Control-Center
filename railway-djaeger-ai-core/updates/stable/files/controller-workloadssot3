authority_rescue_guard(){
  [ -x "$AGENT_EXEC" ] || return 0
  _rg="$(sh "$AGENT_EXEC" rescue-check "${CPU:-0}" "${GPUT:-0}" "${BAT:-0}" 2>/dev/null | tr '\n' ';')"
  case "$_rg" in *TRIGGERED*) APPLIED_SIGNATURE=""; PROFILE="SAFE"; FINAL_DECISION="SAFE"; EXEC_SOURCE="RESCUE_GUARD"; log "ROOT_AUTHORITY $_rg";; esac
