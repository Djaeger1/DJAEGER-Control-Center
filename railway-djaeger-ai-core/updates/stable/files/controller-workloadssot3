agent_observe_async(){
  # LOOPFIX1: SYSFS capability discovery/readback is useful but may be slow on a
  # vendor kernel. Never make the 1 Hz controller/Control Center path wait for it.
  [ -r "$AGENT_EXEC" ] || return 0
  if [ -d "$AGENT_OBSERVE_LOCK" ]; then
    _aop="$(cat "$AGENT_OBSERVE_LOCK/pid" 2>/dev/null)"
    case "$_aop" in
      ''|*[!0-9]*) rm -rf "$AGENT_OBSERVE_LOCK" 2>/dev/null;;
      *) kill -0 "$_aop" 2>/dev/null && return 0; rm -rf "$AGENT_OBSERVE_LOCK" 2>/dev/null;;
    esac
  fi
  mkdir "$AGENT_OBSERVE_LOCK" 2>/dev/null || return 0
  chmod 700 "$AGENT_OBSERVE_LOCK" 2>/dev/null
  # Separate sh process: no controller cleanup/restore trap can be inherited.
  sh -c 'exec sh "$1" observe' _ "$AGENT_EXEC" >/dev/null 2>&1 &
  _aop=$!
  printf '%s\n' "$_aop" >"$AGENT_OBSERVE_LOCK/pid" 2>/dev/null
  printf '%s\n' "$(date +%s)" >"$AGENT_OBSERVE_LOCK/at" 2>/dev/null
  # A stale lock is recovered on the next pass after the child exits.
}

