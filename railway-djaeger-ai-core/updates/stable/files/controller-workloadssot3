    echo "P0_MAX=$_p0max"; echo "P0_MIN=$_p0min"; echo "P0_GOV=$_p0gov"
    echo "P6_MAX=$_p6max"; echo "P6_MIN=$_p6min"; echo "P6_GOV=$_p6gov"
    echo "G_MAX=$_gmax"; echo "G_MIN=$_gmin"; echo "K_MAX=$_kmax"; echo "K_MIN=$_kmin"; echo "G_GOV=$_ggov"
  } >"$TMP" 2>/dev/null || { rm -f "$TMP"; log "ORIGINAL_STATE SAVE_FAILED WRITE"; return 1; }
