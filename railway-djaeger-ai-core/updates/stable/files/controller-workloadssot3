cloud_semantics(){
  _cn=$(date +%s); _hf="$P/gemini_http_state"; _gs="$P/gemini_status_semantics.env"
  CLOUD_CONNECTION_STATUS="NOT_YET_CHECKED"; CLOUD_PROVIDER="GEMINI"; CLOUD_HTTP_CODE="NA"; CLOUD_HTTP_AGE_SEC=-1; CLOUD_MODEL="NA"
  GEMINI_LAST_EVENT_STATUS="NONE"; GEMINI_STATUS_FRESH="NO"; GEMINI_COOLDOWN_UNTIL=0

  # APPREBUILD4: provider status is event-driven. An idle period or absence of a
  # new request must never demote a known provider state to UNKNOWN. The helper
  # only reads Gemini transport state and maintains a bounded last-known latch.
  if [ -r "$BRAIN_STATUS_HELPER" ]; then
    DJAEGER_STATE_DIR="$P" sh "$BRAIN_STATUS_HELPER" gemini >"$_gs.tmp.$$" 2>/dev/null && { chmod 600 "$_gs.tmp.$$" 2>/dev/null; mv -f "$_gs.tmp.$$" "$_gs"; }
  fi
  if [ -r "$_gs" ]; then
    CLOUD_CONNECTION_STATUS=$(sed -n "s/^GEMINI_STATUS='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    GEMINI_LAST_EVENT_STATUS=$(sed -n "s/^GEMINI_LAST_EVENT_STATUS='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    _gat=$(sed -n "s/^GEMINI_LAST_EVENT_AT='\\([0-9][0-9]*\\)'.*/\\1/p" "$_gs" | head -1)
    CLOUD_HTTP_AGE_SEC=$(sed -n "s/^GEMINI_STATUS_AGE_SEC='\\(-\{0,1\}[0-9][0-9]*\\)'.*/\\1/p" "$_gs" | head -1)
    GEMINI_STATUS_FRESH=$(sed -n "s/^GEMINI_STATUS_FRESH='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    CLOUD_HTTP_CODE=$(sed -n "s/^GEMINI_HTTP_CODE='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    CLOUD_PROVIDER=$(sed -n "s/^GEMINI_PROVIDER='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    CLOUD_MODEL=$(sed -n "s/^GEMINI_MODEL='\\([^']*\\)'.*/\\1/p" "$_gs" | head -1)
    GEMINI_COOLDOWN_UNTIL=$(sed -n "s/^GEMINI_COOLDOWN_UNTIL='\\([0-9][0-9]*\\)'.*/\\1/p" "$_gs" | head -1)
    [ -n "$CLOUD_CONNECTION_STATUS" ] || CLOUD_CONNECTION_STATUS="NOT_YET_CHECKED"
    [ -n "$CLOUD_PROVIDER" ] || CLOUD_PROVIDER="GEMINI"
    [ -n "$CLOUD_MODEL" ] || CLOUD_MODEL="NA"
    [ -n "$CLOUD_HTTP_CODE" ] || CLOUD_HTTP_CODE="NA"
    [ -n "$CLOUD_HTTP_AGE_SEC" ] || CLOUD_HTTP_AGE_SEC=-1
  elif [ -r "$_hf" ]; then
    # Compatibility fallback if the helper is unavailable: never use UNKNOWN
    # for a merely idle provider; expose explicit not-yet-checked semantics.
    CLOUD_HTTP_CODE=$(sed -n "s/^HTTP_CODE='\\([^']*\\)'.*/\\1/p" "$_hf" | head -1)
    _hat=$(sed -n "s/^AT='\\([0-9][0-9]*\\)'.*/\\1/p" "$_hf" | head -1)
    CLOUD_PROVIDER=$(sed -n "s/^PROVIDER='\\([^']*\\)'.*/\\1/p" "$_hf" | head -1)
    CLOUD_MODEL=$(sed -n "s/^MODEL='\\([^']*\\)'.*/\\1/p" "$_hf" | head -1)
    [ -n "$CLOUD_PROVIDER" ] || CLOUD_PROVIDER=GEMINI; [ -n "$CLOUD_MODEL" ] || CLOUD_MODEL=NA
    case "$_hat" in ''|*[!0-9]*) CLOUD_HTTP_AGE_SEC=-1;; *) CLOUD_HTTP_AGE_SEC=$((_cn-_hat));; esac
    case "$CLOUD_HTTP_CODE" in 200) CLOUD_CONNECTION_STATUS=ONLINE;; 429|COOLDOWN_HOLD) CLOUD_CONNECTION_STATUS=COOLDOWN;; 401|403) CLOUD_CONNECTION_STATUS=AUTH_ERROR;; 000|CURL_ERROR) CLOUD_CONNECTION_STATUS=OFFLINE;; ''|NA) CLOUD_CONNECTION_STATUS=NOT_YET_CHECKED;; *) CLOUD_CONNECTION_STATUS=ERROR;; esac
  fi

  # HERMES Cloud transport availability and HERMES route selection are separate
  # facts. READY does not mean that Cloud HERMES is currently the active route.
  HERMES_CLOUD_TRANSPORT_STATUS="NOT_YET_CHECKED"; HERMES_CLOUD_TRANSPORT_AGE_SEC=-1; HERMES_CLOUD_REPORTED_ROUTE="NA"
  if [ -r "$HERMES_CLOUD_STATE_FILE" ]; then
    HERMES_CLOUD_TRANSPORT_STATUS=$(sed -n "s/^HERMES_CLOUD_STATE='\\([^']*\\)'.*/\\1/p" "$HERMES_CLOUD_STATE_FILE" | head -1)
    _hcat=$(sed -n "s/^HERMES_CLOUD_AT='\\([0-9][0-9]*\\)'.*/\\1/p" "$HERMES_CLOUD_STATE_FILE" | head -1)
    HERMES_CLOUD_REPORTED_ROUTE=$(sed -n "s/^HERMES_CLOUD_ROUTE='\\([^']*\\)'.*/\\1/p" "$HERMES_CLOUD_STATE_FILE" | head -1)
    [ -n "$HERMES_CLOUD_TRANSPORT_STATUS" ] || HERMES_CLOUD_TRANSPORT_STATUS="NOT_YET_CHECKED"
    [ -n "$HERMES_CLOUD_REPORTED_ROUTE" ] || HERMES_CLOUD_REPORTED_ROUTE="NA"
    case "$_hcat" in ''|*[!0-9]*) :;; *) HERMES_CLOUD_TRANSPORT_AGE_SEC=$((_cn-_hcat));; esac
  fi
  if [ "${BRAIN_SOURCE:-NONE}" = HERMES_H2 ]; then HERMES_ACTIVE_ROUTE="$HERMES_BACKEND"; else HERMES_ACTIVE_ROUTE="STANDBY"; fi
  if [ "${BRAIN_SOURCE:-NONE}" = HERMES_H2 ] && [ "${HERMES_BACKEND:-LOCAL}" = CLOUD ]; then HERMES_CLOUD_USED=YES; else HERMES_CLOUD_USED=NO; fi

  CLOUD_PLAN_SCORE="${PREDICTIVE_CONF:-0}"
  CLOUD_ACCOUNTABILITY_STATUS="${POLICY_ACCOUNTABILITY_STATUS:-NA}"
  case "${PREDICTIVE_STATE:-LOCAL_ONLY}" in
    VALID) CLOUD_PLAN_STATE="VALID"; CLOUD_PLAN_REASON="VALID_TYPED_GEMINI_PLAN";;
    STALE) CLOUD_PLAN_STATE="STALE"; CLOUD_PLAN_REASON="STALE_GEMINI_POLICY";;
    CONTEXT_*) CLOUD_PLAN_STATE="INVALIDATED_CONTEXT"; CLOUD_PLAN_REASON="$PREDICTIVE_STATE";;
    FUTURE_POLICY|INVALID_CONTEXT|INVALID_PROFILE|INVALID_DYNAMIC|INVALID_MODE) CLOUD_PLAN_STATE="INVALID"; CLOUD_PLAN_REASON="$PREDICTIVE_STATE";;
    EARLY_EXIT) CLOUD_PLAN_STATE="EXPIRED"; CLOUD_PLAN_REASON="EARLY_EXIT";;
    LOCAL_ONLY)
      case "$CLOUD_CONNECTION_STATUS" in
        COOLDOWN|LAST_KNOWN_COOLDOWN) CLOUD_PLAN_STATE="DEFERRED"; CLOUD_PLAN_REASON="GEMINI_COOLDOWN";;
        OFFLINE|LAST_KNOWN_OFFLINE|AUTH_ERROR|ERROR) CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_REASON="GEMINI_NOT_AVAILABLE";;
        *) CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_REASON="NO_ACTIVE_GEMINI_POLICY";;
      esac;;
    *) CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_REASON="${PREDICTIVE_STATE:-NO_ACTIVE_GEMINI_POLICY}";;
  esac
  # CLOUDATTR1: canonical truth identifies the provider actually used.
  # Legacy display aliases are intentionally provider-aware for the current
  # Control Center: CLOUD_PROVIDER -> Cloud in control, CLOUD_IN_CONTROL -> Cloud plan.
  CLOUD_CONTROL_PROVIDER="NONE"
  CLOUD_PLAN_PROVIDER="NONE"
  if [ "${BRAIN_SOURCE:-NONE}" = GEMINI ]; then
    CLOUD_CONTROL_PROVIDER="GEMINI"
    [ "${PREDICTIVE_STATE:-LOCAL_ONLY}" = VALID ] && CLOUD_PLAN_PROVIDER="GEMINI"
  elif [ "${BRAIN_SOURCE:-NONE}" = HERMES_H2 ] && [ "${HERMES_BACKEND:-LOCAL}" = CLOUD ]; then
    CLOUD_CONTROL_PROVIDER="HERMES_CLOUD"
    if [ "${HERMES_STATE:-UNAVAILABLE}" = VALID ]; then
      CLOUD_PLAN_PROVIDER="HERMES_CLOUD"
      CLOUD_PLAN_STATE="VALID"
      CLOUD_PLAN_SCORE="${HERMES_CONF:-0}"
      CLOUD_PLAN_REASON="${HERMES_REASON:-HERMESCLOUD1_VALID_PLAN}"
    else
      CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_SCORE=0; CLOUD_PLAN_REASON="HERMES_CLOUD_NOT_VALID"
    fi
  elif [ "${BRAIN_SOURCE:-NONE}" = HERMES_H2 ]; then
    # HERMES Local is the actual deputy. Do not show a stale Gemini plan as if it
    # were the active cloud plan merely because an old predictive policy exists.
    CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_SCORE=0
    if [ "${HERMES_CLOUD_TRANSPORT_STATUS:-NOT_YET_CHECKED}" = READY ]; then
      CLOUD_PLAN_REASON="HERMES_LOCAL_ACTIVE_CLOUD_NOT_SELECTED"
    else
      CLOUD_PLAN_REASON="HERMES_LOCAL_ACTIVE_CLOUD_${HERMES_CLOUD_TRANSPORT_STATUS:-NOT_YET_CHECKED}"
    fi
  else
    CLOUD_PLAN_PROVIDER="NONE"
    if [ "${BRAIN_SOURCE:-NONE}" != GEMINI ]; then
      CLOUD_PLAN_STATE="NOT_USED"; CLOUD_PLAN_SCORE=0; CLOUD_PLAN_REASON="NO_CLOUD_BRAIN_SELECTED"
    fi
  fi
  case "$CLOUD_CONTROL_PROVIDER" in
    GEMINI) CLOUD_PROVIDER="GEMINI";;
    HERMES_CLOUD) CLOUD_PROVIDER="HERMES CLOUD";;
    *) CLOUD_PROVIDER="NO";;
  esac
  case "$CLOUD_PLAN_PROVIDER" in
    GEMINI) CLOUD_IN_CONTROL="GEMINI";;
    HERMES_CLOUD) CLOUD_IN_CONTROL="HERMES CLOUD";;
    *) CLOUD_IN_CONTROL="NO";;
  esac
}
current_scene(){
  # Lightweight local fingerprint; no game files/network/process internals.
  case "${SKIN:-0}" in ''|*[!0-9]*) H=H1;; *) if [ "$SKIN" -ge 43 ]; then H=H3; elif [ "$SKIN" -ge 41 ]; then H=H2; else H=H1; fi;; esac
  # r79: FPS workload bin must never reuse F. F is the authoritative game id
  # throughout the outer/fast lifecycle loop and frame-layer detector. Reusing
  # it here caused sts.al -> F1/F2/F3 false GAME_CHANGED teardown.
  if awk "BEGIN{exit !((${FPS_EST:-0})>=55)}" 2>/dev/null; then FPS_BIN=F3
  elif awk "BEGIN{exit !((${FPS_EST:-0})>=42)}" 2>/dev/null; then FPS_BIN=F2; else FPS_BIN=F1; fi
  if awk "BEGIN{exit !((${P99_MS:-0})>=50)}" 2>/dev/null; then J=J3
  elif awk "BEGIN{exit !((${P95_MS:-0})>=33)}" 2>/dev/null; then J=J2; else J=J1; fi
  MOM=FLAT
  case "$LAST_SKIN_SAMPLE" in ''|*[!0-9]*) :;; *)
    DSK=$((SKIN-LAST_SKIN_SAMPLE)); [ "$DSK" -ge 1 ] && MOM=UP; [ "$DSK" -le -1 ] && MOM=DOWN;; esac
  CURRENT_SCENE="${H}_${FPS_BIN}_${J}_${MOM}"
  LAST_SKIN_SAMPLE="$SKIN"
}

offline_distill(){
  # v12.9.15 Persistent Local Intelligence: distill durable, game-specific
  # hardware outcomes into a compact offline model. This is evidence storage,
  # not an override of a fresh valid Gemini policy.
  _game="${SESSION_GAME_ID:-UNKNOWN}"; _um="${USER_MODE:-AUTO}"; _now="$(date +%s)"
  # v12.9.18: idle/inactive must never erase a valid game-scoped offline model.
  # Distillation is committed only for a concrete game id.
  [ -n "$_game" ] && [ "$_game" != "UNKNOWN" ] || return 0
  _tmp="$OFFLINE_KNOWLEDGE.tmp.$$"
  {
    printf 'version=2\ngame=%s\nuser_mode=%s\nupdated_at=%s\n' "$_game" "$_um" "$_now"
    if [ -r "$HWLEARN" ]; then
      awk -F, -v game="$_game" -v um="$_um" -v now="$_now" '
        NR>1 && $18==game && $19==um && (now-$1)<=2592000 {
          k=$4"-"$5"|"$6"-"$7"|"$8"-"$9; n[k]++;
          if($3=="SUCCESS")ok[k]++; if($16=="REJECT"||$3=="FAILED")bad[k]++;
          if($13~/^-?[0-9.]+$/)fd[k]+=$13; if($14~/^-?[0-9.]+$/)sd[k]+=$14;
          if($12~/^-?[0-9.]+$/)pd[k]+=$12
        }
        END{for(k in n){rate=ok[k]*100/n[k]; br=bad[k]*100/n[k];
          printf "budget=%s samples=%d success_rate=%.0f reject_rate=%.0f avg_fps_delta=%.1f avg_skin_delta=%.1f avg_power_delta=%.1f\n",k,n[k],rate,br,fd[k]/n[k],sd[k]/n[k],pd[k]/n[k]}}
      ' "$HWLEARN"
    fi
  } >"$_tmp" 2>/dev/null && { chmod 600 "$_tmp" 2>/dev/null; mv -f "$_tmp" "$OFFLINE_KNOWLEDGE"; }
}

local_reject_veto(){
  # Refuse to autonomously reuse a repeatedly failed same-game budget unless
  # there is stronger contradictory SUCCESS evidence. Gemini online is not
  # vetoed; this protects only Local temporary authority.
  [ -r "$HWLEARN" ] || return 1
  _key="$1,$2,$3,$4,$5,$6"
  awk -F, -v game="${SESSION_GAME_ID:-UNKNOWN}" -v um="${USER_MODE:-AUTO}" -v key="$_key" -v now="$(date +%s)" '
    NR>1&&$18==game&&$19==um&&(now-$1)<=2592000 {k=$4","$5","$6","$7","$8","$9;if(k==key){n++;if($3=="SUCCESS")ok++;if($16=="REJECT"||$3=="FAILED")bad++}}
    END{exit !((bad>=2 && bad>ok) || (n>=3 && bad*100/n>=67))}' "$HWLEARN" 2>/dev/null
