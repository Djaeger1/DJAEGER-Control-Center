    printf "RESULT_UPDATED_AT='%s'\n" "$(date +%s)"
  } >"$_sr_tmp" || { rm -f "$_sr_tmp"; return 1; }
  chmod 600 "$_sr_tmp" 2>/dev/null
  mv -f "$_sr_tmp" "$STRATEGY_RESULT"
}

# MWFIX2: every Android Binder/dumpsys observer used by session/frame detection
# is time-bounded. A stuck SurfaceFlinger/WindowManager/ActivityManager query
# must fail soft instead of freezing runtime_status + cc_snapshot publication.
# 10 ticks x 0.1s = ~1s budget per Binder observer.
bounded_capture(){
  _bc_out="$1"; _bc_ticks="$2"; shift 2
  rm -f "$_bc_out" 2>/dev/null
  ( "$@" >"$_bc_out" 2>/dev/null ) &
  _bc_pid=$!
  _bc_i=0
  while kill -0 "$_bc_pid" 2>/dev/null; do
    if [ "$_bc_i" -ge "$_bc_ticks" ] 2>/dev/null; then
      kill "$_bc_pid" 2>/dev/null || true
      sleep 0.05
      kill -9 "$_bc_pid" 2>/dev/null || true
      wait "$_bc_pid" 2>/dev/null || true
      rm -f "$_bc_out" 2>/dev/null
      return 124
    fi
    sleep 0.1
    _bc_i=$((_bc_i+1))
  done
  wait "$_bc_pid" 2>/dev/null
  _bc_rc=$?
  [ "$_bc_rc" -eq 0 ] || { rm -f "$_bc_out" 2>/dev/null; return "$_bc_rc"; }
  return 0
}

wm_game_visible_current(){
  # MWFIX2: same exact block parser, but the Binder read has a hard 1s budget.
  _wgp="$1"; _wm_tmp="$P/.mwfix2_window.$$"
  bounded_capture "$_wm_tmp" 10 dumpsys window windows || { rm -f "$_wm_tmp" 2>/dev/null; log "MWFIX2 WINDOW_DUMPSYS_TIMEOUT FAILSOFT=1"; return 1; }
  awk -v gp="$_wgp" '
    function finish(){ if (ing && vis) { found=1; exit } }
    /Window #[0-9]+ Window\{|^[[:space:]]*Window\{/ {
      finish(); ing=(index($0,gp)>0); vis=0; surf=0; next
    }
    ing && /mHasSurface=true/ { surf=1 }
    ing && /(isVisible=true|isOnScreen=true|mViewVisibility=0x0|mPolicyVisibility=true|mSurfaceShown=true)/ { vis=1 }
    ing && surf && /mViewVisibility=0x0/ { vis=1 }
    END { if(found || (ing && vis)) exit 0; exit 1 }
  ' "$_wm_tmp"; _wm_rc=$?; rm -f "$_wm_tmp" 2>/dev/null; return "$_wm_rc"
}

am_game_visible_current(){
  # Secondary current-state evidence. START never uses this by itself.
  _agp="$1"; _am_tmp="$P/.mwfix2_activity.$$"
  bounded_capture "$_am_tmp" 10 dumpsys activity activities || { rm -f "$_am_tmp" 2>/dev/null; log "MWFIX2 ACTIVITY_DUMPSYS_TIMEOUT FAILSOFT=1"; return 1; }
  awk -v gp="$_agp" '
    function finish(){ if (ing && vis) { found=1; exit } }
    /ActivityRecord\{/ {
      finish(); ing=(index($0,gp)>0); vis=0; next
    }
    ing && /(state=RESUMED|mState=RESUMED|mVisibleRequested=true|mVisible=true|visible=true|mClientVisible=true)/ { vis=1 }
    END { if(found || (ing && vis)) exit 0; exit 1 }
  ' "$_am_tmp"; _am_rc=$?; rm -f "$_am_tmp" 2>/dev/null; return "$_am_rc"
}

observer_rebind_probe(){
  # SESSIONFIX2 observer-safe session rebind/start fallback.
  # This is READ-ONLY evidence gathering. Android/MIUI freeform can report a
  # transient/foreign focus owner even while Arcane Legends remains visibly
  # composed and rendering. Do not require Control Center or RESUMED focus here.
  # START still requires ALL of: supported package process + exact SurfaceFlinger
  # layer + advancing frame timestamps. A stale/background process cannot pass.
  _orp_now="${1:-$(date +%s)}"
  for _orp_game in $GAMES; do
    pidof "$_orp_game" >/dev/null 2>&1 || continue
    _orp_tmp="$P/.mwfix2_orp.$$"
    bounded_capture "$_orp_tmp" 10 dumpsys SurfaceFlinger --list || { rm -f "$_orp_tmp" 2>/dev/null; log "MWFIX2 SF_LIST_TIMEOUT path=observer_rebind FAILSOFT=1"; continue; }
    _orp_list="$(cat "$_orp_tmp" 2>/dev/null)"; rm -f "$_orp_tmp" 2>/dev/null
    _orp_layer="$(printf '%s\n' "$_orp_list" | grep -m1 -F "$_orp_game" 2>/dev/null)"
    [ -n "$_orp_layer" ] || continue
    bounded_capture "$_orp_tmp" 10 dumpsys SurfaceFlinger --latency "$_orp_layer" || { rm -f "$_orp_tmp" 2>/dev/null; log "MWFIX2 SF_LATENCY_TIMEOUT path=observer_rebind_a FAILSOFT=1"; continue; }
    _orp_a="$(awk 'NF>=3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { if (($2+0)>m) m=$2+0 } END{printf "%.0f",m+0}' "$_orp_tmp")"; rm -f "$_orp_tmp" 2>/dev/null
    case "$_orp_a" in ''|0|*[!0-9]*) continue;; esac
    sleep 1
    bounded_capture "$_orp_tmp" 10 dumpsys SurfaceFlinger --latency "$_orp_layer" || { rm -f "$_orp_tmp" 2>/dev/null; log "MWFIX2 SF_LATENCY_TIMEOUT path=observer_rebind_b FAILSOFT=1"; continue; }
    _orp_b="$(awk 'NF>=3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { if (($2+0)>m) m=$2+0 } END{printf "%.0f",m+0}' "$_orp_tmp")"; rm -f "$_orp_tmp" 2>/dev/null
    case "$_orp_b" in ''|0|*[!0-9]*) continue;; esac
    if [ "$_orp_b" -gt "$_orp_a" ] 2>/dev/null; then
      LAST_GAME_FOCUS_AT="$_orp_now"
      printf '%s\n' "$_orp_now" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
      log "SESSION_REBIND OBSERVER_SAFE=1 GAME=$_orp_game FRAME_A=$_orp_a FRAME_B=$_orp_b"
      printf '%s|MULTIWINDOW\n' "$_orp_game"
      return 0
    fi
  done
  return 1
}

game_window_state(){
  refresh_game_registry

  # WORKLOADSSOT3: workload_context is the canonical classifier result shared
  # across DJAEGER. If it says a registered GAME is currently foreground/visible
  # and the snapshot is fresh, use that same truth instead of requiring a second
  # independent WindowManager parse to agree before a session can start.
  _wc="$P/workload_context.env"
  if [ -r "$_wc" ]; then
    # WORKLOADSSOT3: workload_context may be written as KEY=value or
    # KEY='value'. Parse both forms exactly like the Railway bridge.
    _wc_class="$(awk -F= '$1=="WORKLOAD_CLASS"{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$_wc" 2>/dev/null)"
    _wc_pkg="$(awk -F= '$1=="PACKAGE"{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$_wc" 2>/dev/null)"
    _wc_win="$(awk -F= '$1=="WINDOW_MODE"{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$_wc" 2>/dev/null)"
    _wc_profile="$(awk -F= '$1=="WORKLOAD_PROFILE"{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$_wc" 2>/dev/null)"
    _wc_at="$(awk -F= '$1=="AT"{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$_wc" 2>/dev/null)"
    case "$_wc_at" in ''|*[!0-9]*) _wc_at=0;; esac
    _wc_now="$(date +%s)"; _wc_age=$((_wc_now-_wc_at))
    # WORKLOADSSOT3: do not re-run GAME registry/eligibility here. The shared
    # workload classifier already owns that decision. Requiring a second registry
    # opinion recreated the split-brain bug we are eliminating.
    case "$_wc_pkg" in ''|NA) _wc_pkg_ok=0;; *) _wc_pkg_ok=1;; esac
    case "$_wc_profile" in GAME_*) _wc_profile_ok=1;; *) _wc_profile_ok=0;; esac
    if [ "$_wc_class" = GAME ] && [ "$_wc_pkg_ok" -eq 1 ] && [ "$_wc_profile_ok" -eq 1 ] && [ "$_wc_age" -ge 0 ] 2>/dev/null && [ "$_wc_age" -le 6 ] 2>/dev/null; then
      case "$_wc_win" in FOREGROUND|MULTIWINDOW)
        LAST_GAME_FOCUS_AT="$_wc_now"
        printf '%s\n' "$_wc_now" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
        log "WORKLOAD_SSOT GAME=$_wc_pkg MODE=$_wc_win AGE=$_wc_age SOURCE=WORKLOAD_CONTEXT"
        printf '%s|%s\n' "$_wc_pkg" "$_wc_win"
        return 0
        ;;
      esac
    fi
  fi
  # v12.2.1 defensive multiwindow detector.
  # Focus is the only signal allowed to START a game session. A resumed
  # ActivityManager record may only KEEP an already-confirmed session alive.
  # This prevents stale MIUI task/resume records from activating tuning.
  _gw_tmp="$P/.mwfix2_gamewin.$$"
  FG_LINE=""
  if bounded_capture "$_gw_tmp" 10 dumpsys window windows; then FG_LINE="$(grep -m1 -E 'mCurrentFocus|mFocusedApp' "$_gw_tmp" 2>/dev/null)"; fi
  if [ -z "$FG_LINE" ]; then
    if bounded_capture "$_gw_tmp" 10 dumpsys window; then FG_LINE="$(grep -m1 -E 'mCurrentFocus|mFocusedApp' "$_gw_tmp" 2>/dev/null)"; fi
  fi
  rm -f "$_gw_tmp" 2>/dev/null
  NOW_WS=$(date +%s)

  # Screen-off is never multiwindow. Unknown/timeout remains fail-soft, not asleep.
  POWER_WAKE=""
  if bounded_capture "$_gw_tmp" 10 dumpsys power; then POWER_WAKE="$(grep -m1 'mWakefulness=' "$_gw_tmp" 2>/dev/null)"; fi
  rm -f "$_gw_tmp" 2>/dev/null
  case "$POWER_WAKE" in *Asleep*|*Dozing*) return 1;; esac

  for gp in $GAMES; do
    case "$FG_LINE" in *"$gp"*) LAST_GAME_FOCUS_AT=$NOW_WS; printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }; printf '%s|FOREGROUND\n' "$gp"; return 0;; esac
  done

  # APPREBUILD4 multitask arbitration: a registered GAME that is currently
  # visible/on-screen owns the workload even when another normal APP (ChatGPT,
  # Control Center, Facebook, etc.) owns Android focus. This is not process-only
  # inference: the shared arbiter requires the game process plus an exact current
  # WindowManager block with a visible surface. It can START or KEEP a session.
  if [ -x "$VISIBLE_GAME_ARBITER" ]; then
    _vg_state="$(DJAEGER_MODDIR="$M" DJAEGER_STATE_DIR="$P" sh "$VISIBLE_GAME_ARBITER" current 2>/dev/null)"
    if [ -n "$_vg_state" ]; then
      _vg_game="${_vg_state%%|*}"
      if is_supported_game "$_vg_game"; then
        LAST_GAME_FOCUS_AT=$NOW_WS
        printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
        log "MULTITASK_OWNER GAME=$_vg_game EVIDENCE=WINDOW_VISIBLE FOCUS_LINE=$(printf '%s' "$FG_LINE" | tr '\r\n' ' ' | cut -c1-120)"
        printf '%s|MULTIWINDOW\n' "$_vg_game"
        return 0
      fi
    fi
  fi

  # MWFIX1 visible multiwindow START integrity:
  # MIUI/freeform may give focus to Control Center and move the game out of
  # ActivityManager RESUMED while the game is still visibly composed and rendering.
  # Requiring RESUMED here caused a false IDLE/STALE session in that exact layout.
  # START is now allowed only when ALL of these are current:
  #   (1) Control Center owns focus,
  #   (2) the supported game process exists, and
  #   (3) WindowManager reports the exact game window visible/on-screen.
  # ActivityManager visibility is recorded as corroboration, not a mandatory gate.
  # A stale task/process alone can never pass this path.
  if [ "$ACTIVE" -eq 0 ]; then
    case "$FG_LINE" in
      *"com.djaeger.controlcenter"*)
        for gp in $GAMES; do
          pidof "$gp" >/dev/null 2>&1 || continue
          if wm_game_visible_current "$gp"; then
            _amv=0; am_game_visible_current "$gp" && _amv=1
            LAST_GAME_FOCUS_AT=$NOW_WS
            printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
            log "SESSION_START CC_VISIBLE=1 GAME=$gp WM_VISIBLE=1 AM_VISIBLE=$_amv MODE=MULTIWINDOW"
            printf '%s|MULTIWINDOW\n' "$gp"
            return 0
          fi
        done
        ;;
    esac
  fi

  # SESSIONFIX2: if MIUI/freeform focus truth is incomplete, permit a safe
  # START/rebind from live SurfaceFlinger frame progression. This only runs while
  # ACTIVE=0 and still requires process + exact package layer + advancing frames.
  # It therefore fixes false WAITING_GAME without accepting process-only evidence.
  if [ "$ACTIVE" -eq 0 ]; then
    _orp_state="$(observer_rebind_probe "$NOW_WS")"
    if [ -n "$_orp_state" ]; then
      printf '%s\n' "$_orp_state"
      return 0
    fi
  fi

  # MWFIX1 Control Center coexistence: exact WindowManager-block parser keeps
  # an already-confirmed session alive while the observer UI owns focus.
  if [ "$ACTIVE" -eq 1 ]; then
    case "$FG_LINE" in
      *"com.djaeger.controlcenter"*)
        _cc_bound="$(cat "$P/session_game" 2>/dev/null)"
        for gp in $GAMES; do
          [ -z "$_cc_bound" ] || [ "$gp" = "$_cc_bound" ] || continue
          pidof "$gp" >/dev/null 2>&1 || continue
          if wm_game_visible_current "$gp"; then
            LAST_GAME_FOCUS_AT=$NOW_WS
            printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
            printf '%s|MULTIWINDOW\n' "$gp"
            return 0
          fi
        done
        ;;
    esac
  fi

  # HCC1 FIX2 session-observer lease: WindowManager/MIUI may transiently omit
  # focus/visibility while a floating observer is on top of the game.  Keep only
  # an ALREADY-BOUND session alive when the latest SurfaceFlinger frame sample is
  # current, valid, belongs to that exact game, and the game process still exists.
  # This path can never START an inactive session and therefore cannot activate
  # tuning from a stale task/process alone.
  if [ "$ACTIVE" -eq 1 ]; then
    _fd_bound="$(cat "$P/session_game" 2>/dev/null)"
    _fd_file="$P/frame_debug"
    if [ -n "$_fd_bound" ] && is_supported_game "$_fd_bound" && [ -r "$_fd_file" ] && pidof "$_fd_bound" >/dev/null 2>&1; then
      _fd_valid="$(sed -n 's/^CURRENT_FRAME_DATA=//p' "$_fd_file" 2>/dev/null | head -1)"
      _fd_game="$(sed -n 's/^GAME_DETECT=//p' "$_fd_file" 2>/dev/null | head -1)"
      _fd_active="$(sed -n 's/^SESSION_ACTIVE=//p' "$_fd_file" 2>/dev/null | head -1)"
      _fd_at="$(sed -n 's/^SAMPLE_AT=//p' "$_fd_file" 2>/dev/null | head -1)"
      case "$_fd_at" in ''|*[!0-9]*) _fd_at=0;; esac
      _fd_age=$((NOW_WS-_fd_at))
      if [ "$_fd_valid" = "VALID" ] && [ "$_fd_game" = "$_fd_bound" ] && [ "$_fd_active" = "1" ] && [ "$_fd_age" -ge 0 ] && [ "$_fd_age" -le 4 ]; then
        LAST_GAME_FOCUS_AT=$NOW_WS
        printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
        printf '%s|MULTIWINDOW\n' "$_fd_bound"
        return 0
      fi
    fi
  fi

  # r81 session ownership: Android/MIUI may omit per-window visibility while
  # several freeform windows are composed. Keep ONLY the already-bound game
  # alive when two independent live signals agree: its process exists and
  # SurfaceFlinger still owns a layer for that exact package. This cannot START
  # a session and therefore cannot activate tuning for a stale/background task.
  if [ "$ACTIVE" -eq 1 ]; then
    _bound_game="$(cat "$P/session_game" 2>/dev/null)"
    case " $_bound_game " in
      "  ") :;;
      *)
        is_supported_game "$_bound_game" || return 1
        _gpid="$(pidof "$_bound_game" 2>/dev/null | awk '{print $1}')"
        if [ -n "$_gpid" ]; then
          _sf=""; _ka_tmp="$P/.mwfix2_keepalive.$$"
          if bounded_capture "$_ka_tmp" 10 dumpsys SurfaceFlinger --list; then _sf="$(grep -m1 -F "$_bound_game" "$_ka_tmp" 2>/dev/null)"; fi
          if [ -z "$_sf" ] && bounded_capture "$_ka_tmp" 10 dumpsys SurfaceFlinger; then _sf="$(grep -m1 -F "$_bound_game" "$_ka_tmp" 2>/dev/null)"; fi
          rm -f "$_ka_tmp" 2>/dev/null
          if [ -n "$_sf" ]; then
            LAST_GAME_FOCUS_AT=$NOW_WS
            printf '%s\n' "$NOW_WS" >"$LAST_FOCUS_FILE.tmp" 2>/dev/null && { chmod 600 "$LAST_FOCUS_FILE.tmp" 2>/dev/null; mv -f "$LAST_FOCUS_FILE.tmp" "$LAST_FOCUS_FILE"; }
            printf '%s|MULTIWINDOW\n' "$_bound_game"
            return 0
          fi
        fi
        ;;
    esac
  fi

  # Existing keep-alive path: after a confirmed session start, a resumed record
  # may keep MULTIWINDOW alive only inside the bounded no-focus lease.
  if [ "$ACTIVE" -eq 1 ]; then
    LAST_GAME_FOCUS_AT=$(cat "$LAST_FOCUS_FILE" 2>/dev/null)
    case "$LAST_GAME_FOCUS_AT" in ''|*[!0-9]*) LAST_GAME_FOCUS_AT=0;; esac
  fi
  if [ "$ACTIVE" -eq 1 ] && [ "$LAST_GAME_FOCUS_AT" -gt 0 ]; then
    FOCUS_AGE=$((NOW_WS - LAST_GAME_FOCUS_AT))
    if [ "$FOCUS_AGE" -le "$MULTIWINDOW_MAX_NOFOCUS" ]; then
      _ar_tmp="$P/.mwfix2_resumed.$$"; ACT_RESUMED=""
      if bounded_capture "$_ar_tmp" 10 dumpsys activity activities; then ACT_RESUMED="$(grep -E 'mResumedActivity|ResumedActivity' "$_ar_tmp" 2>/dev/null)"; fi
      rm -f "$_ar_tmp" 2>/dev/null
      for gp in $GAMES; do
        case "$ACT_RESUMED" in *"$gp"*) printf '%s|MULTIWINDOW\n' "$gp"; return 0;; esac
      done
    fi
  fi
  return 1
}
biasread(){ BMODE=KEEP; BS=NONE; if [ -r "$BIAS" ];then unset BIAS_MODE BIAS_UNTIL;. "$BIAS" 2>/dev/null;now=$(date +%s);if [ -n "$BIAS_UNTIL" ]&&[ "$now" -le "$BIAS_UNTIL" ];then BMODE=${BIAS_MODE:-KEEP};BS="ACTIVE:$BMODE";else BS=EXPIRED;fi;fi; if [ "$BS" != "$LASTBIAS" ];then case "$BS" in ACTIVE:*)log "BIAS ACTIVE: ${BS#ACTIVE:}";;EXPIRED)log "BIAS EXPIRED";;esac;LASTBIAS="$BS";fi; }
decide(){
  temps; biasread
  # Native/emergency safety thresholds are intentionally unchanged.
  if [ "$SKIN" -ge 47 ]||[ "$BAT" -ge 44 ]||[ "$CPU" -ge 78 ]||[ "$GPUT" -ge 78 ];then HOT=$((HOT+1));else HOT=0;fi
  [ "$HOT" -ge 2 ]&&{ NEW=SAFE;return;}
  if [ "$PROFILE" = SAFE ]&&{ [ "$SKIN" -ge 43 ]||[ "$BAT" -ge 41 ]||[ "$CPU" -ge 68 ]||[ "$GPUT" -ge 68 ];};then NEW=SAFE;return;fi

  # R89COMFORT2: AUTO deliberately has no FREEZE rung. FREEZE remains a valid
  # executable profile for explicit/manual selection, but deterministic AUTO is
  # restored to STABLE -> SOFT_COOL -> COOL -> SAFE. SAFE above stays absolute.
  FREEZE_RECOVERY_COUNT=0

  # Proven r89 staged cooling.
  if [ "$SKIN" -ge 44 ]; then SKIN43_COUNT=2; NEW=COOL; return; fi
  if [ "$PROFILE" = "COOL" ] && [ "$SKIN" -ge 42 ]; then SKIN43_COUNT=0; NEW=COOL; return; fi
  if [ "$SKIN" -ge 43 ]; then
    SKIN43_COUNT=$((SKIN43_COUNT+1))
    if [ "$SKIN43_COUNT" -ge 2 ]; then NEW=COOL; else NEW=SOFT_COOL; fi
    return
  fi
  SKIN43_COUNT=0
  if [ "$SKIN" -ge 42 ]; then NEW=SOFT_COOL; return; fi
  if [ "$BMODE" = COOLER ];then NEW=COOL;return;fi
  if [ "$CPU" -ge 70 ]||[ "$GPUT" -ge 70 ]||[ "$BAT" -ge 42 ];then NEW=COOL;return;fi

  # Performance promotion is allowed only with strong comfort headroom.
  if [ "$BMODE" = MORE_RESPONSE ]&&[ "$CPU" -le 60 ]&&[ "$GPUT" -le 60 ]&&[ "$SKIN" -le 38 ]&&[ "$BAT" -le 39 ];then NEW=RESPONSE;return;fi
  # COMFORT89: a high instantaneous GPU clock is not evidence that more
  # performance is required. RESPONSE is requested only by an explicit fresh
  # brain bias above or by the sustained frame-pacing advisory in fusion_decide().
  COOLCNT=0
  NEW=STABLE
}

frame_sample(){
  FRAME_MS="NA"; FPS_EST="NA"; JANK_PCT="NA"; P95_MS="NA"; P99_MS="NA"; FRAME_N="0"
  DBG="/data/adb/djaeger_ai/frame_debug"
  CACHE="/data/adb/djaeger_ai/frame_layer"
  mkdir -p /data/adb/djaeger_ai 2>/dev/null

  # r12: fast path reuses the already discovered BLAST layer.  The expensive
  # SurfaceFlinger --list discovery runs only on cache miss/recovery; latency
  # failure drops the cache and the next 1s sample rediscovers it.
  LAYER=""; FG="${F:-}"
  if [ -r "$CACHE" ]; then
    CACHED="$(cat "$CACHE" 2>/dev/null)"
    [ -n "$CACHED" ] && LAYER="$CACHED"
  fi
  if [ -z "$LAYER" ]; then
    _sf_list_tmp="$P/.mwfix2_sf_list.$$"
    if bounded_capture "$_sf_list_tmp" 10 dumpsys SurfaceFlinger --list; then
      LIST="$(cat "$_sf_list_tmp" 2>/dev/null)"; rm -f "$_sf_list_tmp" 2>/dev/null
    else
      rm -f "$CACHE" "$_sf_list_tmp" 2>/dev/null
      { echo "CURRENT_FRAME_DATA=UNAVAILABLE"; echo "STAGE=SURFACEFLINGER_LIST_TIMEOUT"; echo "GAME_DETECT=${F:-NA}"; echo "LAYER_DETECT=NOT_FOUND"; echo "SAMPLE_AT=$(date +%s)"; echo "SESSION_ACTIVE=$ACTIVE"; echo "FAILSOFT=1"; } > "$DBG.tmp"
      mv "$DBG.tmp" "$DBG"; chmod 600 "$DBG" 2>/dev/null
      log "MWFIX2 FRAME_SAMPLE SF_LIST_TIMEOUT budget_ms=1000 FAILSOFT=1 SESSION_PRESERVED=1"
      return
    fi
    FG=""
    refresh_game_registry
    for PKG in $GAMES; do
      is_supported_game "$PKG" || continue
      if printf '%s\n' "$LIST" | grep -F "$PKG" >/dev/null 2>&1; then FG="$PKG"; break; fi
    done
    if [ -z "$FG" ]; then
      { echo "CURRENT_FRAME_DATA=UNAVAILABLE"; echo "STAGE=GAME_DETECT"; echo "GAME_DETECT=NOT_FOUND"; echo "SAMPLE_AT=$(date +%s)"; echo "SESSION_ACTIVE=$ACTIVE"; } > "$DBG.tmp"
      mv "$DBG.tmp" "$DBG"; chmod 600 "$DBG" 2>/dev/null; return
    fi
    LAYER="$(printf '%s\n' "$LIST" | grep -F "$FG" | grep -F "SurfaceView[" | grep -F "(BLAST)" | head -n 1)"
    [ -z "$LAYER" ] && LAYER="$(printf '%s\n' "$LIST" | grep -F "$FG" | grep -F "(BLAST)" | head -n 1)"
    [ -n "$LAYER" ] && { printf '%s\n' "$LAYER" > "$CACHE.tmp"; mv "$CACHE.tmp" "$CACHE"; chmod 600 "$CACHE" 2>/dev/null; }
  fi
  if [ -z "$LAYER" ]; then
    { echo "CURRENT_FRAME_DATA=UNAVAILABLE"; echo "STAGE=LAYER_DETECT"; echo "GAME_DETECT=$FG"; echo "LAYER_DETECT=NOT_FOUND"; } > "$DBG.tmp"
    mv "$DBG.tmp" "$DBG"; chmod 600 "$DBG" 2>/dev/null; return
  fi

  _sf_lat_tmp="$P/.mwfix2_sf_latency.$$"
  if bounded_capture "$_sf_lat_tmp" 10 dumpsys SurfaceFlinger --latency "$LAYER"; then
    RAW="$(cat "$_sf_lat_tmp" 2>/dev/null)"; rm -f "$_sf_lat_tmp" 2>/dev/null
  else
    rm -f "$CACHE" "$_sf_lat_tmp" 2>/dev/null
    { echo "CURRENT_FRAME_DATA=UNAVAILABLE"; echo "STAGE=SURFACEFLINGER_LATENCY_TIMEOUT"; echo "GAME_DETECT=${FG:-${F:-NA}}"; echo "LAYER_DETECT=$LAYER"; echo "SAMPLE_AT=$(date +%s)"; echo "SESSION_ACTIVE=$ACTIVE"; echo "FAILSOFT=1"; echo "CACHE_DROPPED=1"; } > "$DBG.tmp"
    mv "$DBG.tmp" "$DBG"; chmod 600 "$DBG" 2>/dev/null
    log "MWFIX2 FRAME_SAMPLE SF_LATENCY_TIMEOUT budget_ms=1000 FAILSOFT=1 SESSION_PRESERVED=1 CACHE_DROPPED=1"
    return
  fi
  NZ="$(printf '%s\n' "$RAW" | awk 'NR>1 && $2~/^[0-9]+$/ && $2+0>0{n++} END{print n+0}')"
  RES="$(printf '%s\n' "$RAW" | awk '
    NR==1{next}
    $1~/^[0-9]+$/ && $2~/^[0-9]+$/ && $3~/^[0-9]+$/ && $2>0{
      if(prev>0 && $2>prev){d=($2-prev)/1000000.0;if(d>=4&&d<=250){a[++n]=d;sum+=d}}
      prev=$2
    }
    END{
      if(n<3)exit
      for(i=2;i<=n;i++){v=a[i];j=i-1;while(j>=1&&a[j]>v){a[j+1]=a[j];j--}a[j+1]=v}
      avg=sum/n; med=a[int((n-1)*.50)+1]; p95=a[int((n-1)*.95)+1]; p99=a[int((n-1)*.99)+1]
      # More conservative jank definition: slower than max(1.75x median, median+8ms).
      thr=med*1.75; if(med+8>thr)thr=med+8
      jank=0;for(i=1;i<=n;i++)if(a[i]>thr)jank++
      printf "%.2f %.1f %.1f %.2f %.2f %d %.2f",avg,1000/avg,(jank*100)/n,p95,p99,n,thr
    }')"

  if [ -n "$RES" ]; then
    FRAME_MS="$(echo "$RES"|awk '{print $1}')"; FPS_EST="$(echo "$RES"|awk '{print $2}')"
    JANK_PCT="$(echo "$RES"|awk '{print $3}')"; P95_MS="$(echo "$RES"|awk '{print $4}')"
    P99_MS="$(echo "$RES"|awk '{print $5}')"; FRAME_N="$(echo "$RES"|awk '{print $6}')"; JTHR="$(echo "$RES"|awk '{print $7}')"
    { echo "CURRENT_FRAME_DATA=VALID"; echo "STAGE=OK"; echo "GAME_DETECT=$FG"; echo "LAYER_DETECT=$LAYER"; echo "NONZERO_ROWS=$NZ"; echo "PARSER_ROWS=$FRAME_N"; echo "JANK_THRESHOLD_MS=$JTHR"; echo "SAMPLE_AT=$(date +%s)"; echo "SESSION_ACTIVE=$ACTIVE"; } > "$DBG.tmp"
  else
    # Cache may have gone stale between --list and --latency. Drop it so next sample rediscovers.
    rm -f "$CACHE"
    { echo "CURRENT_FRAME_DATA=UNAVAILABLE"; echo "STAGE=PARSER"; echo "GAME_DETECT=$FG"; echo "LAYER_DETECT=$LAYER"; echo "NONZERO_ROWS=$NZ"; echo "PARSER_ROWS=0"; echo "CACHE_DROPPED=1"; echo "SAMPLE_AT=$(date +%s)"; echo "SESSION_ACTIVE=$ACTIVE"; } > "$DBG.tmp"
  fi
  mv "$DBG.tmp" "$DBG"; chmod 600 "$DBG" 2>/dev/null
}
network_load_state(){
  [ -r "$NETWORK_STATE" ] || return 1
  NET_PING_MS=$(sed -n "s/^PING_CURRENT_MS='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_AVG_MS=$(sed -n "s/^PING_AVG_MS='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_P95_MS=$(sed -n "s/^PING_P95_MS='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_JITTER_MS=$(sed -n "s/^JITTER_MS='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_LOSS_PCT=$(sed -n "s/^PACKET_LOSS_PCT='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_SAMPLES=$(sed -n "s/^SAMPLES='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  NET_QUALITY=$(sed -n "s/^QUALITY='\([^']*\)'.*/\1/p" "$NETWORK_STATE" | head -1)
  [ -n "$NET_AVG_MS" ] || NET_AVG_MS=NA; [ -n "$NET_P95_MS" ] || NET_P95_MS=NA
  [ -n "$NET_JITTER_MS" ] || NET_JITTER_MS=NA; [ -n "$NET_LOSS_PCT" ] || NET_LOSS_PCT=NA
  [ -n "$NET_QUALITY" ] || NET_QUALITY=UNKNOWN; [ -n "$NET_SAMPLES" ] || NET_SAMPLES=0
}
network_sample(){
  _now=$(date +%s)
  [ "$ACTIVE" = 1 ] || { NET_PING_MS=NA; NET_AVG_MS=NA; NET_P95_MS=NA; NET_JITTER_MS=NA; NET_LOSS_PCT=NA; NET_QUALITY=INACTIVE; NET_SAMPLES=0; printf "UPDATED_AT='%s'\nSESSION_ACTIVE='0'\nTARGET='%s'\nPING_CURRENT_MS='NA'\nPING_AVG_MS='NA'\nPING_P95_MS='NA'\nJITTER_MS='NA'\nPACKET_LOSS_PCT='NA'\nSAMPLES='0'\nQUALITY='INACTIVE'\nREAD_ONLY='1'\n" "$_now" "1.1.1.1" >"$NETWORK_STATUS.tmp" && { chmod 600 "$NETWORK_STATUS.tmp"; mv -f "$NETWORK_STATUS.tmp" "$NETWORK_STATUS"; }; return; }
  # Read-only network observation. Never changes routes, DNS, sockets, game traffic or firewall state.
  [ $((_now-LAST_NETWORK_SAMPLE_AT)) -ge 10 ] 2>/dev/null || { network_load_state; return; }
  LAST_NETWORK_SAMPLE_AT=$_now
  _target=1.1.1.1
  if [ -r "$NETWORK_CFG" ]; then
    _cfg_target=$(sed -n "s/^TARGET='\\([^']*\\)'.*/\\1/p;s/^TARGET=\\([^[:space:]]*\\).*/\\1/p" "$NETWORK_CFG" 2>/dev/null | head -1)
    case "$_cfg_target" in ''|*[!0-9A-Za-z._:-]*) :;; *) _target="$_cfg_target";; esac
  fi
  _out=$(ping -n -c 1 -W 1 "$_target" 2>/dev/null)
  _ms=$(printf '%s\n' "$_out" | sed -n 's/.*time[=<]\([0-9.][0-9.]*\)[[:space:]]*ms.*/\1/p' | head -1)
  case "$_ms" in ''|*[!0-9.]*) _ok=0; _ms=NA;; *) _ok=1;; esac
  [ -f "$NETWORK_HISTORY" ] || echo 'epoch,target,ok,ping_ms' >"$NETWORK_HISTORY"
  printf '%s,%s,%s,%s\n' "$_now" "$_target" "$_ok" "$_ms" >>"$NETWORK_HISTORY"
  { head -n 1 "$NETWORK_HISTORY"; tail -n 20 "$NETWORK_HISTORY"; } >"$NETWORK_HISTORY.tmp" && mv -f "$NETWORK_HISTORY.tmp" "$NETWORK_HISTORY"
  _stats=$(tail -n 20 "$NETWORK_HISTORY" | awk -F, '
    $1~/^[0-9]+$/ {total++; if($3==1 && $4~/^[0-9.]+$/){n++;a[n]=$4+0;sum+=$4;if(prev!=""){d=$4-prev;if(d<0)d=-d;js+=d;jn++}prev=$4}}
    END{if(!total){print "NA NA NA NA 0";exit} loss=100*(total-n)/total;if(!n){printf "NA NA NA %.1f 0",loss;exit}
      for(i=2;i<=n;i++){v=a[i];j=i-1;while(j>=1&&a[j]>v){a[j+1]=a[j];j--}a[j+1]=v} p=a[int((n-1)*.95)+1]; jit=(jn?js/jn:0);printf "%.1f %.1f %.1f %.1f %d",sum/n,p,jit,loss,n}')
  set -- $_stats; NET_AVG_MS=$1; NET_P95_MS=$2; NET_JITTER_MS=$3; NET_LOSS_PCT=$4; NET_SAMPLES=$5; NET_PING_MS=$_ms
  NET_QUALITY=UNKNOWN
  if [ "$NET_SAMPLES" -ge 3 ] 2>/dev/null; then
    NET_QUALITY=GOOD
    awk "BEGIN{exit !(($NET_LOSS_PCT>=5)||($NET_P95_MS>=180)||($NET_JITTER_MS>=40))}" && NET_QUALITY=POOR
    if [ "$NET_QUALITY" = GOOD ]; then awk "BEGIN{exit !(($NET_LOSS_PCT>0)||($NET_P95_MS>=100)||($NET_JITTER_MS>=20))}" && NET_QUALITY=VARIABLE; fi
  fi
  _sid=$(cat "$P/session_id" 2>/dev/null); _sgame=$(cat "$P/session_game" 2>/dev/null)
  [ -n "$_sid" ] || _sid=NA; [ -n "$_sgame" ] || _sgame=${F:-NA}
  printf "UPDATED_AT='%s'\nSESSION_ACTIVE='1'\nSESSION_ID='%s'\nGAME='%s'\nWINDOW_MODE='%s'\nTARGET='%s'\nPING_CURRENT_MS='%s'\nPING_AVG_MS='%s'\nPING_P95_MS='%s'\nJITTER_MS='%s'\nPACKET_LOSS_PCT='%s'\nSAMPLES='%s'\nQUALITY='%s'\nREAD_ONLY='1'\n" "$_now" "$_sid" "$_sgame" "${WINDOW_MODE:-INACTIVE}" "$_target" "$NET_PING_MS" "$NET_AVG_MS" "$NET_P95_MS" "$NET_JITTER_MS" "$NET_LOSS_PCT" "$NET_SAMPLES" "$NET_QUALITY" >"$NETWORK_STATE.tmp" && { chmod 600 "$NETWORK_STATE.tmp"; cp -f "$NETWORK_STATE.tmp" "$NETWORK_STATUS.tmp"; chmod 600 "$NETWORK_STATUS.tmp"; mv -f "$NETWORK_STATE.tmp" "$NETWORK_STATE"; mv -f "$NETWORK_STATUS.tmp" "$NETWORK_STATUS"; }
}


bug_report_update(){
  _now=$(date +%s); _ledger="$P/bug_event_ledger.csv"; _state="$P/bug_health_state"; _cool="$P/bug_notify_state"; _dedup_marker="$P/.bug_ledger_dedup_attr1"
  [ -f "$_ledger" ] || echo 'epoch,event_id,severity,component,code,status,decision_id,transaction_id,summary' >"$_ledger"
  # ATTR1 one-time migration: compact legacy per-cycle duplicates while retaining
  # event transitions and reminders separated by at least 15 minutes.
  if [ ! -e "$_dedup_marker" ] && [ -s "$_ledger" ]; then
    awk -F, 'NR==1{print;next}{t=$1+0;e=$2;if(e!=last_e || (t-last_t)>=900){print;last_e=e;last_t=t}}' "$_ledger" >"$_ledger.attr1.$$" 2>/dev/null && mv -f "$_ledger.attr1.$$" "$_ledger"
    : >"$_dedup_marker"; chmod 600 "$_dedup_marker" 2>/dev/null
  fi
  _code=''; _sev='INFO'; _comp='CONTROL_PLANE'; _summary=''; _did='NA'; _tid='NA'; _event_key=''
  _exec="$P/resource_execution_feedback"; _resync="$P/gemini_resync_state"
  if [ -r "$_exec" ]; then
    _es=$(sed -n "s/^EXECUTION_STATUS='\([^']*\)'.*/\1/p;s/^EXECUTION_STATUS=\([^[:space:]]*\).*/\1/p" "$_exec" | head -1)
    _did=$(sed -n "s/^DECISION_ID='\([^']*\)'.*/\1/p;s/^DECISION_ID=\([^[:space:]]*\).*/\1/p" "$_exec" | head -1); [ -n "$_did" ] || _did=NA
    _tid=$(sed -n "s/^TRANSACTION_ID='\([^']*\)'.*/\1/p;s/^TRANSACTION_ID=\([^[:space:]]*\).*/\1/p" "$_exec" | head -1); [ -n "$_tid" ] || _tid=NA
    case "$_es" in
      READBACK_MISMATCH) _code=KERNEL_READBACK_MISMATCH; _sev=HIGH; _comp=KERNEL_EXECUTOR; _summary='Kernel readback differs from validated execution target';;
      FAILED|ROLLBACK_FAILED) _code=EXECUTION_FAILURE; _sev=CRITICAL; _comp=LOCAL_EXECUTOR; _summary='Typed execution or rollback failed';;
    esac
  fi
  if [ -z "$_code" ] && [ -r "$_resync" ]; then
    _rs=$(sed -n "s/^STATE='\([^']*\)'.*/\1/p;s/^STATE=\([^[:space:]]*\).*/\1/p" "$_resync" | head -1)
    _rr=$(sed -n "s/^REASON='\([^']*\)'.*/\1/p;s/^REASON=\([^[:space:]]*\).*/\1/p" "$_resync" | head -1); [ -n "$_rr" ] || _rr=UNSPECIFIED
    _rr_safe=$(printf '%s' "$_rr" | tr -c 'A-Za-z0-9_.:-' '_')
    case "$_rs" in
      NEEDS_RESYNC) _code=GEMINI_RESYNC_REQUIRED; _sev=WARNING; _comp=GEMINI_REASONING; _did=NA; _tid=NA; _event_key="${_code}:${_rr_safe}"; _summary="Gemini reasoning requires resynchronization reason=${_rr_safe}";;
      RESYNC_FAILED) _code=GEMINI_RESYNC_FAILED; _sev=WARNING; _comp=GEMINI_REASONING; _did=NA; _tid=NA; _event_key="${_code}:${_rr_safe}"; _summary="Gemini reasoning resynchronization failed reason=${_rr_safe}";;
    esac
  fi
  if [ -z "$_code" ] && [ "${RUNTIME_ACTIVE:-${ACTIVE:-0}}" = 1 ]; then
    _na=$(sed -n "s/^UPDATED_AT='\([^']*\)'.*/\1/p" "$NETWORK_STATUS" 2>/dev/null | head -1)
    case "$_na" in ''|*[!0-9]*) :;; *) [ $((_now-_na)) -le 30 ] 2>/dev/null || { _code=TELEMETRY_STALE; _sev=WARNING; _comp=TELEMETRY; _summary='Active session telemetry is stale'; };; esac
  fi
  if [ -n "$_code" ]; then
    [ -n "$_event_key" ] && _eid="$_event_key" || _eid="${_code}:${_did}:${_tid}"
    _last=$(sed -n "s/^EVENT_ID='\([^']*\)'.*/\1/p" "$_cool" 2>/dev/null | head -1); _lastat=$(sed -n "s/^NOTIFIED_AT='\([^']*\)'.*/\1/p" "$_cool" 2>/dev/null | head -1); case "$_lastat" in ''|*[!0-9]*) _lastat=0;; esac
    _notify=0; [ "$_eid" != "$_last" ] && _notify=1; [ $((_now-_lastat)) -ge 900 ] 2>/dev/null && _notify=1
    # GOLDENFIX1: Gemini resync identity is reason-based and independent of unrelated execution IDs.
    if [ "$_notify" = 1 ]; then
      printf '%s,%s,%s,%s,%s,OPEN,%s,%s,%s\n' "$_now" "$_eid" "$_sev" "$_comp" "$_code" "$_did" "$_tid" "$_summary" >>"$_ledger"
      { head -n 1 "$_ledger"; tail -n 100 "$_ledger"; } >"$_ledger.tmp" && mv -f "$_ledger.tmp" "$_ledger"
    fi
    printf "UPDATED_AT='%s'\nHEALTH='DEGRADED'\nOPEN_BUG='1'\nSEVERITY='%s'\nCOMPONENT='%s'\nCODE='%s'\nEVENT_ID='%s'\nDECISION_ID='%s'\nTRANSACTION_ID='%s'\nSUMMARY='%s'\nNOTIFY_PENDING='%s'\n" "$_now" "$_sev" "$_comp" "$_code" "$_eid" "$_did" "$_tid" "$_summary" "$_notify" >"$_state.tmp" && chmod 600 "$_state.tmp" && mv -f "$_state.tmp" "$_state"
    [ "$_notify" = 1 ] && printf "EVENT_ID='%s'\nNOTIFIED_AT='%s'\n" "$_eid" "$_now" >"$_cool.tmp" && [ -f "$_cool.tmp" ] && { chmod 600 "$_cool.tmp"; mv -f "$_cool.tmp" "$_cool"; }
  else
    # GOLDENFIX1: append exactly one RESOLVED transition before publishing HEALTHY.
    _prev_open=$(sed -n "s/^OPEN_BUG='\([^']*\)'.*/\1/p;s/^OPEN_BUG=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1)
    if [ "$_prev_open" = 1 ]; then
      _peid=$(sed -n "s/^EVENT_ID='\([^']*\)'.*/\1/p;s/^EVENT_ID=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_peid" ] || _peid=UNKNOWN
      _psev=$(sed -n "s/^SEVERITY='\([^']*\)'.*/\1/p;s/^SEVERITY=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_psev" ] || _psev=INFO
      _pcomp=$(sed -n "s/^COMPONENT='\([^']*\)'.*/\1/p;s/^COMPONENT=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_pcomp" ] || _pcomp=CONTROL_PLANE
      _pcode=$(sed -n "s/^CODE='\([^']*\)'.*/\1/p;s/^CODE=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_pcode" ] || _pcode=UNKNOWN
      _pdid=$(sed -n "s/^DECISION_ID='\([^']*\)'.*/\1/p;s/^DECISION_ID=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_pdid" ] || _pdid=NA
      _ptid=$(sed -n "s/^TRANSACTION_ID='\([^']*\)'.*/\1/p;s/^TRANSACTION_ID=\([^[:space:]]*\).*/\1/p" "$_state" 2>/dev/null | head -1); [ -n "$_ptid" ] || _ptid=NA
      printf '%s,%s,%s,%s,%s,RESOLVED,%s,%s,%s\n' "$_now" "$_peid" "$_psev" "$_pcomp" "$_pcode" "$_pdid" "$_ptid" 'Condition cleared by current verified state' >>"$_ledger"
      { head -n 1 "$_ledger"; tail -n 100 "$_ledger"; } >"$_ledger.tmp" && mv -f "$_ledger.tmp" "$_ledger"
      printf "EVENT_ID='NONE'\nNOTIFIED_AT='%s'\n" "$_now" >"$_cool.tmp" && chmod 600 "$_cool.tmp" 2>/dev/null && mv -f "$_cool.tmp" "$_cool"
    fi
    printf "UPDATED_AT='%s'\nHEALTH='HEALTHY'\nOPEN_BUG='0'\nSEVERITY='INFO'\nCOMPONENT='NONE'\nCODE='NONE'\nEVENT_ID='NONE'\nDECISION_ID='NA'\nTRANSACTION_ID='NA'\nSUMMARY='No locally verified DJAEGER bug condition'\nNOTIFY_PENDING='0'\n" "$_now" >"$_state.tmp" && chmod 600 "$_state.tmp" && mv -f "$_state.tmp" "$_state"
  fi
}

# r82 Fast Telemetry Engine: read-only observer path, independent from the
# conservative control/AI cadence.  It never writes sysfs/network state.
FAST_TELEMETRY_FILE="$P/fast_telemetry"
fast_telemetry_publish(){
  _ft_now_ms="$(date +%s%3N 2>/dev/null)"; case "$_ft_now_ms" in *N*) _ft_now_ms="$(($(date +%s)*1000))";; esac
  _ft_l="$(r "$P0/scaling_cur_freq")"; _ft_b="$(r "$P6/scaling_cur_freq")"; _ft_g="$(r "$G/cur_freq")"
  # Thermal/battery values are supplied by the slower sensor sampler; do not
  # rescan every thermal zone at 5 Hz.
  _ft_tmp="$FAST_TELEMETRY_FILE.tmp.$$"
  printf "UPDATED_MS='%s'\nCPU_L_CUR='%s'\nCPU_B_CUR='%s'\nGPU_CUR='%s'\nCPU_T='%s'\nGPU_T='%s'\nSKIN_T='%s'\nBAT_T='%s'\nBATT_STATUS='%s'\nBATT_CURRENT_UA='%s'\nBATT_VOLTAGE_UV='%s'\nBATT_POWER_MW='%s'\nFRAME_MS='%s'\nFPS_EST='%s'\nJANK_PCT='%s'\nP95_MS='%s'\nP99_MS='%s'\nFRAME_N='%s'\nWINDOW_MODE='%s'\n" \
    "$_ft_now_ms" "${_ft_l:-NA}" "${_ft_b:-NA}" "${_ft_g:-NA}" "${CPU:-NA}" "${GPUT:-NA}" "${SKIN:-NA}" "${BAT:-NA}" \
    "${BATT_STATUS:-NA}" "${BATT_UA:-NA}" "${BATT_UV:-NA}" "${BATT_POWER_MW:-NA}" "${FRAME_MS:-NA}" "${FPS_EST:-NA}" "${JANK_PCT:-NA}" "${P95_MS:-NA}" "${P99_MS:-NA}" "${FRAME_N:-0}" "${WINDOW_MODE:-INACTIVE}" >"$_ft_tmp" 2>/dev/null && { chmod 600 "$_ft_tmp" 2>/dev/null; mv -f "$_ft_tmp" "$FAST_TELEMETRY_FILE"; }
}
fast_telemetry_burst(){
  # Five 200-ms publications per second. Frequency changes become visible
  # quickly while expensive frame/thermal collection remains rate-limited.
  _ft_i=0
  while [ "$_ft_i" -lt 5 ]; do fast_telemetry_publish; _ft_i=$((_ft_i+1)); [ "$_ft_i" -lt 5 ] && sleep 0.2; done
}

publish_idle_snapshot(){
  # r25: Control Center must never inherit an old ACTIVE snapshot while the
  # authoritative detector has no game. Publish a complete atomic idle view
  # without writing hardware/network state; idle device sensors are read-only.
  _now="$(date +%s)"
  printf "controller_pid='%s'\npredictor_pid='%s'\nactive='0'\ngame='NA'\nwindow_mode='INACTIVE'\nuser_mode='%s'\nupdated_at='%s'\n" \
    "$$" "$(cat "$P/predictor.pid" 2>/dev/null)" "$USER_MODE" "$_now" >"$P/runtime_status.tmp" 2>/dev/null && { chmod 600 "$P/runtime_status.tmp" 2>/dev/null; mv -f "$P/runtime_status.tmp" "$P/runtime_status"; }
  printf "UPDATED_AT='%s'\nSESSION_ACTIVE='0'\nSESSION_ID='NA'\nGAME='NA'\nWINDOW_MODE='INACTIVE'\nTARGET='1.1.1.1'\nPING_CURRENT_MS='NA'\nPING_AVG_MS='NA'\nPING_P95_MS='NA'\nJITTER_MS='NA'\nPACKET_LOSS_PCT='NA'\nSAMPLES='0'\nQUALITY='INACTIVE'\nREAD_ONLY='1'\n" "$_now" >"$NETWORK_STATUS.tmp" 2>/dev/null && { chmod 600 "$NETWORK_STATUS.tmp" 2>/dev/null; mv -f "$NETWORK_STATUS.tmp" "$NETWORK_STATUS"; }
  # Keep device telemetry live while idle without reviving session telemetry.
  # temps() and the frequency reads below are read-only.  The row is published
  # directly to cc_snapshot and is NOT appended to the game telemetry history.
  temps
  fast_telemetry_publish
  _idle_tel="${_now},${CPU:-NA},${GPUT:-NA},${SKIN:-NA},${BAT:-NA},$(r "$P0/scaling_cur_freq"),$(r "$P6/scaling_cur_freq"),$(r "$G/cur_freq"),NA,NA,NA,NA,NA,NA,0,${BATT_STATUS:-NA},${BATT_UA:-NA},${BATT_UV:-NA},${BATT_POWER_MW:-NA},${BATT_POWER_VALID:-REJECTED},${BATT_POWER_REASON:-NO_SAMPLE},${BATT_CURRENT_SCALE:-NA},INACTIVE,0"
  # Preserve deterministic Bug Ledger truth even while idle. Do not overwrite a
  # previously verified execution/readback fault merely because the game closed.
  bug_report_update
  CC_IDLE_TEL="$_idle_tel" publish_cc_snapshot
}

publish_cc_runtime_heartbeat(){
  # MWFIX2: refresh only __RUNTIME__ inside the existing atomic snapshot.
  # This is intentionally tiny and does not invoke Hermes/context/frame/network
  # collectors. It prevents a slow observer from making a live session look stale.
  _cc="$P/cc_snapshot"; [ -r "$_cc" ] || return 0
  _rt="$P/runtime_status"; [ -r "$_rt" ] || return 0
  _hrt="$_cc.runtime.tmp.$$"
  awk -v rf="$_rt" '
    /^__RUNTIME__$/ {
      print
      while ((getline line < rf) > 0) print line
      close(rf)
      skipping=1
      next
    }
    /^__FAST_TELEMETRY__$/ { skipping=0 }
    !skipping { print }
  ' "$_cc" >"$_hrt" 2>/dev/null || { rm -f "$_hrt" 2>/dev/null; return 1; }
  chmod 600 "$_hrt" 2>/dev/null
  mv -f "$_hrt" "$_cc" 2>/dev/null
}

publish_cc_snapshot(){
  _cc="$P/cc_snapshot"; _cct="$_cc.tmp.$$"; _ns="$P/hermes/.cc_neuron_status.$$"
  if [ -x "$HERMES_CLOUD" ]; then
    DJAEGER_MODDIR="$M" DJAEGER_STATE_DIR="$P" sh "$HERMES_CLOUD" neuron-status >"$_ns" 2>/dev/null || : >"$_ns"
  else
    : >"$_ns"
  fi
  {
    echo __INSTALLED__; echo 1
    echo __VERSION__; sed -n 's/^version=//p' "$M/module.prop" 2>/dev/null | head -n 1
    echo __RUNTIME__; cat "$P/runtime_status" 2>/dev/null
    echo __FAST_TELEMETRY__; cat "$FAST_TELEMETRY_FILE" 2>/dev/null
    echo __TEL__; if [ -n "${CC_IDLE_TEL:-}" ]; then printf '%s\n' "$CC_IDLE_TEL"; else tail -n 1 "$TEL" 2>/dev/null; fi
    echo __NETWORK__; cat "$NETWORK_STATUS" 2>/dev/null
    echo __LIVE__
