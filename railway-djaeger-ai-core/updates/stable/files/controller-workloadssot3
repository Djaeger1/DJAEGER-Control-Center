      NR>1&&$17==wm&&$18==game&&$19==um&&(now-$1)>=0&&(now-$1)<=1209600&&$16!="REJECT"{ch=part(cur,1);cf=part(cur,2);cj=part(cur,3);cm=part(cur,4);rh=part($2,1);rf=part($2,2);rj=part($2,3);rm=part($2,4);dh=abs(num(ch)-num(rh));df=abs(num(cf)-num(rf));dj=abs(num(cj)-num(rj));sh=(dh==0?25:(dh==1?15:4));sf=(df==0?30:(df==1?18:4));sj=(dj==0?25:(dj==1?15:4));sm=(cm==rm?20:((cm=="FLAT"||rm=="FLAT")?12:4));sim=sh+sf+sj+sm;if(sim>=70){k=$4" "$5" "$6" "$7" "$8" "$9;n[k]++;ss[k]+=$15;si[k]+=sim;if($3=="SUCCESS")ok[k]++}}
