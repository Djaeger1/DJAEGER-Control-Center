freeze_frame_observer(){
  _frp="${PROFILE_APPLIED:-${PROFILE:-STABLE}}"
  if [ "$_frp" != FREEZE ]; then FREEZE_FRAME_BAD_COUNT=0; FREEZE_FRAME_GOOD_COUNT=0; FREEZE_FRAME_RESCUE_ACTIVE=0; return 0; fi
  [ "${FRAME_MS:-NA}" != NA ] && [ "${FRAME_N:-0}" -ge 30 ] 2>/dev/null || { FREEZE_FRAME_BAD_COUNT=0; FREEZE_FRAME_GOOD_COUNT=0; [ "${FREEZE_FRAME_RESCUE_ACTIVE:-0}" -eq 1 ] 2>/dev/null && freeze_frame_rescue_release >/dev/null 2>&1 || true; return 0; }
  _mx_cpu="$(freeze_rescue_threshold PM_FREEZE_RESCUE_MAX_CPU_C)"; _mx_gpu="$(freeze_rescue_threshold PM_FREEZE_RESCUE_MAX_GPU_C)"; _mx_skin="$(freeze_rescue_threshold PM_FREEZE_RESCUE_MAX_SKIN_C)"; _mx_bat="$(freeze_rescue_threshold PM_FREEZE_RESCUE_MAX_BAT_C)"
  _tr_p99="$(freeze_rescue_threshold PM_FREEZE_RESCUE_TRIGGER_P99_MS)"; _tr_jank="$(freeze_rescue_threshold PM_FREEZE_RESCUE_TRIGGER_JANK_PCT)"; _rl_p99="$(freeze_rescue_threshold PM_FREEZE_RESCUE_RELEASE_P99_MS)"; _rl_jank="$(freeze_rescue_threshold PM_FREEZE_RESCUE_RELEASE_JANK_PCT)"
  _tr_win="$(freeze_rescue_threshold PM_FREEZE_RESCUE_TRIGGER_WINDOWS)"; _rl_win="$(freeze_rescue_threshold PM_FREEZE_RESCUE_RELEASE_WINDOWS)"; _cd_ms="$(freeze_rescue_threshold PM_FREEZE_RESCUE_COOLDOWN_MS)"
  for _x in "$_mx_cpu" "$_mx_gpu" "$_mx_skin" "$_mx_bat" "$_tr_p99" "$_tr_jank" "$_rl_p99" "$_rl_jank" "$_tr_win" "$_rl_win" "$_cd_ms"; do case "$_x" in ''|*[!0-9]*) return 0;; esac; done
  if [ "${CPU:-99}" -gt "$_mx_cpu" ] || [ "${GPUT:-99}" -gt "$_mx_gpu" ] || [ "${SKIN:-99}" -gt "$_mx_skin" ] || [ "${BAT:-99}" -gt "$_mx_bat" ]; then
    FREEZE_FRAME_BAD_COUNT=0; FREEZE_FRAME_GOOD_COUNT=0
    if [ "${FREEZE_FRAME_RESCUE_ACTIVE:-0}" -eq 1 ] 2>/dev/null; then freeze_frame_rescue_release >/dev/null 2>&1 || true; log "FREEZE_FRAME_RESCUE THERMAL_RELEASE cpu=$CPU gpu=$GPUT skin=$SKIN bat=$BAT"; fi
    return 0
  fi
  if [ "${FREEZE_FRAME_RESCUE_ACTIVE:-0}" -eq 1 ] 2>/dev/null; then
    if awk "BEGIN{exit !((${P99_MS:-999}<=${_rl_p99})&&(${JANK_PCT:-999}<=${_rl_jank}))}"; then FREEZE_FRAME_GOOD_COUNT=$((FREEZE_FRAME_GOOD_COUNT+1)); else FREEZE_FRAME_GOOD_COUNT=0; fi
    if [ "$FREEZE_FRAME_GOOD_COUNT" -ge "$_rl_win" ] 2>/dev/null; then freeze_frame_rescue_release >/dev/null 2>&1 || true; fi
    return 0
  fi
  _now_ms=$(( $(date +%s) * 1000 )); _last_ms=$(( ${FREEZE_FRAME_RESCUE_LAST_AT:-0} * 1000 ))
  [ "${FREEZE_FRAME_RESCUE_LAST_AT:-0}" -eq 0 ] 2>/dev/null || [ $((_now_ms-_last_ms)) -ge "$_cd_ms" ] 2>/dev/null || return 0
  if awk "BEGIN{exit !((${P99_MS:-0}>=${_tr_p99})||(${JANK_PCT:-0}>=${_tr_jank}))}"; then FREEZE_FRAME_BAD_COUNT=$((FREEZE_FRAME_BAD_COUNT+1)); else FREEZE_FRAME_BAD_COUNT=0; fi
  if [ "$FREEZE_FRAME_BAD_COUNT" -ge "$_tr_win" ] 2>/dev/null; then freeze_frame_rescue_apply >/dev/null 2>&1 || true; fi
}

response_gate(){
  [ "${FINAL_DECISION:-}" = RESPONSE ] || return 0
  _rnow="$(date +%s)"; _rfrom="${PROFILE_APPLIED:-${PROFILE:-STABLE}}"
  case "$_rfrom" in STABLE|PERFORM) :;; *)
    FINAL_DECISION="$_rfrom"; EXEC_MODE=PROFILE; EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""
    FINAL_ADJUSTMENT="RESPONSE_BLOCKED_FROM_${_rfrom}"; log "RESPONSE_GATE BLOCK from=$_rfrom reason=PROFILE_POLICY"; return;; esac
  # Observable frame deficit is mandatory regardless of Gemini/Hermes/native source.
  case "${FRAME_SPIKE_STATE:-NO_DATA}:${FRAME_ADVISORY:-KEEP}" in SUSTAINED:*|*:MORE_RESPONSE) :;; *)
    FINAL_DECISION="$_rfrom"; EXEC_MODE=PROFILE; EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""
    FINAL_ADJUSTMENT="RESPONSE_BLOCKED_NO_FRAME_EVIDENCE"; log "RESPONSE_GATE BLOCK from=$_rfrom reason=NO_FRAME_EVIDENCE p99=${P99_MS:-NA} jank=${JANK_PCT:-NA}"; return;; esac
  if [ "${CPU:-99}" -gt 60 ] || [ "${GPUT:-99}" -gt 60 ] || [ "${SKIN:-99}" -gt 38 ] || [ "${BAT:-99}" -gt 39 ]; then
    FINAL_DECISION="$_rfrom"; EXEC_MODE=PROFILE; EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""
    FINAL_ADJUSTMENT="RESPONSE_BLOCKED_THERMAL"; log "RESPONSE_GATE BLOCK from=$_rfrom reason=THERMAL cpu=$CPU gpu=$GPUT skin=$SKIN bat=$BAT"; return
  fi
  if [ "${RESPONSE_LAST_AT:-0}" -gt 0 ] 2>/dev/null && [ $((_rnow-RESPONSE_LAST_AT)) -lt 3 ] 2>/dev/null; then
    FINAL_DECISION="$_rfrom"; EXEC_MODE=PROFILE; EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""
    FINAL_ADJUSTMENT="RESPONSE_BLOCKED_COOLDOWN"; log "RESPONSE_GATE BLOCK from=$_rfrom reason=COOLDOWN"; return
  fi
