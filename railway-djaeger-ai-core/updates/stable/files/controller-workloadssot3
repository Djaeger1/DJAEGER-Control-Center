}
fast_response_maybe(){
  # Evaluate on the 1 Hz frame observer. Three bad windows are required, so
  # one hitch can never cause a high-GPU pulse.
  _frp="${PROFILE_APPLIED:-${PROFILE:-STABLE}}"
  case "$_frp" in STABLE|PERFORM) :;; *) return 0;; esac
  [ "${FRAME_ADVISORY:-KEEP}" = MORE_RESPONSE ] || return 0
  [ "${FRAME_SPIKE_STATE:-CLEAR}" = SUSTAINED ] || return 0
  if [ "${CPU:-99}" -gt 60 ] || [ "${GPUT:-99}" -gt 60 ] || [ "${SKIN:-99}" -gt 38 ] || [ "${BAT:-99}" -gt 39 ]; then
    log "RESPONSE_FAST BLOCK from=$_frp reason=THERMAL cpu=$CPU gpu=$GPUT skin=$SKIN bat=$BAT"; return 0
  fi
  _frnow="$(date +%s)"
  if [ "${RESPONSE_LAST_AT:-0}" -gt 0 ] 2>/dev/null && [ $((_frnow-RESPONSE_LAST_AT)) -lt 3 ] 2>/dev/null; then return 0; fi
  RESPONSE_RETURN_PROFILE="$_frp"
  if response_burst_apply; then
    sleep 0.25
    if response_return_apply "$_frp"; then
      RESPONSE_LAST_AT="$(date +%s)"; PROFILE_APPLIED="$_frp"; PROFILE="$_frp"; APPLIED_SIGNATURE=""; PROFILE_SINCE="$RESPONSE_LAST_AT"
      profile_map_publish "$_frp"
      log "RESPONSE_MICROBURST FAST_DONE duration_ms=250 return=$_frp p99=${P99_MS:-NA} jank=${JANK_PCT:-NA} cpu=$CPU gpu=$GPUT skin=$SKIN bat=$BAT"
    else
      log "RESPONSE_MICROBURST FAST_RETURN_FAILED target=$_frp ACTION=SAFE"
      response_return_apply SAFE >/dev/null 2>&1 || true
      PROFILE_APPLIED=SAFE; PROFILE=SAFE; APPLIED_SIGNATURE=""; PROFILE_SINCE="$(date +%s)"; profile_map_publish SAFE
    fi
  else
    log "RESPONSE_MICROBURST FAST_APPLY_FAILED from=$_frp"
  fi
  # Consume evidence; another pulse needs a new 3-window sustained deficit.
  FRAME_ADVISORY=KEEP; FRAME_POOR_COUNT=0; FRAME_SPIKE_COUNT=0; FRAME_SPIKE_STATE=CLEAR
}

fusion_decide() {
  LOCAL_DECISION="$PROFILE"
  FINAL_DECISION="$LOCAL_DECISION"
  EXEC_SOURCE="LOCAL_BASELINE"
  GEMINI_DECISION="OFFLINE"
  NOWF="$(date +%s)"
  EXEC_MODE="PROFILE"; EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""

  predictive_read
  shadow_validate >/dev/null 2>&1
  local_learned_decide
  hermes_local_decide
  hermes_cloud_decide


  # REBUILD3 fixed hierarchy. This is NOT Agent arbitration:
  # 1) Gemini is the highest/primary decision brain whenever its policy is valid.
  # 2) Hermes H2 is the sole deputy brain when Gemini is invalid; backend priority is Cloud then Local.
  # 3) If neither brain is valid, use native deterministic failsafe (non-AI).
  # local_learned_decide() remains evidence preparation for Hermes only.
  if [ "$PREDICTIVE_STATE" = "VALID" ]; then
    FINAL_DECISION="$POLICY_PROFILE"; EXEC_SOURCE="GEMINI"; GEMINI_DECISION="$PREDICTIVE_ACTION"; EXEC_MODE="${POLICY_CONTROL_MODE:-PROFILE}"
    BRAIN_SOURCE="GEMINI"; AGENT_INPUT_SOURCE="GEMINI"; AGENT_STATE="READY_TO_EXECUTE"
    if [ "$EXEC_MODE" = DYNAMIC ] || [ "$EXEC_MODE" = ENVELOPE ]; then EXEC_LMIN="$POLICY_LITTLE_MIN"; EXEC_LMAX="$POLICY_LITTLE_MAX"; EXEC_BMIN="$POLICY_BIG_MIN"; EXEC_BMAX="$POLICY_BIG_MAX"; EXEC_GMIN="$POLICY_GPU_MIN"; EXEC_GMAX="$POLICY_GPU_MAX"; fi
    if [ "${POLICY_AT:-}" != "$LAST_PRED_POLICY_AT" ]; then
      log "HIERARCHY PRIMARY_BRAIN=GEMINI AGENT_ROLE=FULL_HARDWARE_CONTROLLER_EXECUTOR PROFILE=$POLICY_PROFILE ACTION=$PREDICTIVE_ACTION CONF=$PREDICTIVE_CONF"
      LAST_PRED_POLICY_AT="${POLICY_AT:-}"
    fi
  elif [ "$HERMES_STATE" = "VALID" ]; then
    FINAL_DECISION="$HERMES_PROFILE"; EXEC_SOURCE="HERMES_${HERMES_BACKEND}"; GEMINI_DECISION="OFFLINE_HERMES"; EXEC_MODE="$HERMES_MODE"
    BRAIN_SOURCE="HERMES_H2"; AGENT_INPUT_SOURCE="HERMES_H2"; AGENT_STATE="READY_TO_EXECUTE"
    if [ "$EXEC_MODE" = DYNAMIC ]; then EXEC_LMIN="$HERMES_LMIN"; EXEC_LMAX="$HERMES_LMAX"; EXEC_BMIN="$HERMES_BMIN"; EXEC_BMAX="$HERMES_BMAX"; EXEC_GMIN="$HERMES_GMIN"; EXEC_GMAX="$HERMES_GMAX"; fi
    log "HIERARCHY DEPUTY_BRAIN=HERMES_H2 BACKEND=$HERMES_BACKEND AGENT_ROLE=FULL_HARDWARE_CONTROLLER_EXECUTOR PROFILE=$HERMES_PROFILE CONF=$HERMES_CONF"
  else
    FINAL_DECISION="$LOCAL_DECISION"; EXEC_SOURCE="LOCAL_BASELINE"; GEMINI_DECISION="NATIVE_FAILSAFE"; EXEC_MODE="PROFILE"
    BRAIN_SOURCE="NONE"; AGENT_INPUT_SOURCE="NATIVE_FAILSAFE"; AGENT_STATE="READY_TO_EXECUTE"
  fi

  # RT3 semantic attribution separates the brain/proposal source from later
  # deterministic adjustments. This prevents UI from confusing a Hermes
  # decision with a user-mode or validator adjustment.
  case "$BRAIN_SOURCE" in
    GEMINI) BRAIN_MODE="GEMINI_PRIMARY";;
    HERMES_H2) [ "$HERMES_BACKEND" = CLOUD ] && BRAIN_MODE="HERMES_CLOUD" || BRAIN_MODE="HERMES_LOCAL";;
    *) BRAIN_MODE="NATIVE_FAILSAFE";;
  esac
  BRAIN_PROFILE="$FINAL_DECISION"; FINAL_ADJUSTMENT="NONE"

  # CLOUDTRUTH1: provider-aware Thought/Cloud control truth + durable async HERMES lease.
  # R89COMFORT2 deterministic native thermal floor. AUTO uses SOFT_COOL/COOL/SAFE;
  # FREEZE remains protected only when an explicit/manual path has selected it.
  # Brains may never weaken an active native thermal rung. SAFE remains absolute.
  _before_thermal_floor="$FINAL_DECISION"
  case "$LOCAL_DECISION" in
    SAFE) FINAL_DECISION=SAFE; EXEC_MODE=PROFILE;;
    FREEZE) case "$FINAL_DECISION" in SAFE|FREEZE) :;; *) FINAL_DECISION=FREEZE; EXEC_MODE=PROFILE;; esac;;
    COOL) case "$FINAL_DECISION" in SAFE|FREEZE|COOL) :;; *) FINAL_DECISION=COOL; EXEC_MODE=PROFILE;; esac;;
    SOFT_COOL) case "$FINAL_DECISION" in SAFE|FREEZE|COOL|SOFT_COOL) :;; *) FINAL_DECISION=SOFT_COOL; EXEC_MODE=PROFILE;; esac;;
  esac
  if [ "$FINAL_DECISION" != "$_before_thermal_floor" ]; then
    EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""
    EXEC_SOURCE="NATIVE_THERMAL_FLOOR"; FINAL_ADJUSTMENT="NATIVE_THERMAL_FLOOR:${_before_thermal_floor}>${FINAL_DECISION}"
    log "THERMAL_FLOOR local=$LOCAL_DECISION brain=$_before_thermal_floor final=$FINAL_DECISION"
  fi

  # r28 flexible-intent semantics: user mode is a preference bias, never an artificial
  # CPU/GPU ceiling. A mature context-matched Local learned dynamic envelope must remain
  # executable offline; deterministic mode anchors are only the last-resort baseline.
  # Native SOFT_COOL/COOL/SAFE thermal behavior is never weakened; explicit FREEZE is protected too.
  if [ "$BRAIN_SOURCE" = "NONE" ] && [ "$EXEC_SOURCE" = "LOCAL_BASELINE" ]; then
    _before_mode="$FINAL_DECISION"
    # r30 human-comfort ceiling objective (skin sensor): never heat toward a mode band; modes never narrow hardware capability.
    case "$USER_MODE" in DINGIN) _tmin=35; _tmax=37;; NYAMAN) _tmin=38; _tmax=40;; HANGAT) _tmin=41; _tmax=43;; PANAS) _tmin=44; _tmax=45;; *) _tmin=""; _tmax="";; esac
    if [ -n "$_tmax" ]; then
      if [ "${SKIN:-99}" -gt "$_tmax" ]; then case "$FINAL_DECISION" in RESPONSE|PERFORM|STABLE) FINAL_DECISION=SOFT_COOL; EXEC_MODE=PROFILE;; esac
      fi
    fi
    if [ "$FINAL_DECISION" != "$_before_mode" ]; then
      EXEC_LMIN=""; EXEC_LMAX=""; EXEC_BMIN=""; EXEC_BMAX=""; EXEC_GMIN=""; EXEC_GMAX=""; EXEC_SOURCE="USER_MODE_OFFLINE"; FINAL_ADJUSTMENT="USER_MODE_OFFLINE_BIAS"
      log "USER_MODE OFFLINE_BIAS mode=$USER_MODE from=$_before_mode to=$FINAL_DECISION"
    fi
  fi

  # Frame advice is used only by the baseline fallback. It never silently
  # rewrites a Gemini or learned decision.
  if [ "$EXEC_SOURCE" = "LOCAL_BASELINE" ] && [ "$FRAME_ADVISORY" = "MORE_RESPONSE" ] &&
     case "$LOCAL_DECISION" in STABLE|PERFORM) true;; *) false;; esac && [ "$CPU" -le 60 ] && [ "$GPUT" -le 60 ] &&
     [ "$SKIN" -le 38 ] && [ "$BAT" -le 39 ]; then
    FINAL_DECISION="RESPONSE"; EXEC_SOURCE="LOCAL_FRAME"; FINAL_ADJUSTMENT="LOCAL_FRAME_ADVISORY"
  fi

  case "$FINAL_DECISION" in
    STABLE|PERFORM|RESPONSE|SOFT_COOL|COOL|FREEZE|SAFE) :;;
    *)
      if [ "$BRAIN_SOURCE" = GEMINI ] || [ "$BRAIN_SOURCE" = HERMES_H2 ]; then
        log "BRAIN_INTENT_INVALID source=$BRAIN_SOURCE value=$FINAL_DECISION alternate_strategy_not_invented=1"
        AGENT_STATE="COMMAND_INVALID"; FINAL_DECISION="INVALID_BRAIN_COMMAND"
      else
        FINAL_DECISION="$LOCAL_DECISION"; EXEC_SOURCE="NATIVE_FAILSAFE"; FINAL_ADJUSTMENT="NATIVE_FAILSAFE_VALIDATION"
      fi;;
  esac
  response_gate
  materialize_effective_envelope || true
  PROFILE="$FINAL_DECISION"
  local_thought_publish
  thought_semantics
  cloud_semantics
  publish_agent_brain_lease
  printf "GAME_COMFORT_CONTRACT_ID='%s'\nPROFILE_MAP_CONTRACT_ID='PROFILEMAP1_SSOT1'\nPROFILE_MAP_SYNC='GEMINI_HERMES_LOCAL_CLOUD_AGENT_CONTROLLER_CC'\nGAME_COMFORT_SYNC='PROFILEMAP1_SSOT1'\nUSER_MODE='%s'\nMODE='%s'\nSOURCE='%s'\nCURRENT_SCENE='%s'\nLOCAL_BASELINE='%s'\nFINAL_PROFILE='%s'\nEXEC_MODE='%s'\nEXEC_LITTLE='%s-%s'\nEXEC_BIG='%s-%s'\nEXEC_GPU='%s-%s'\nLEARNED_STATE='%s'\nLEARNED_PROFILE='%s'\nLEARNED_CONF='%s'\nLEARNED_SIMILARITY='%s'\nLEARNED_SAMPLES='%s'\nLEARNING_PROMOTION='%s'\nLEARNING_PROMOTION_REASON='%s'\nUPDATED_AT='%s'\n" \
    "${GCC_CONTRACT_ID:-UNKNOWN}" "$USER_MODE" "$GEMINI_DECISION" "$EXEC_SOURCE" "${CURRENT_SCENE:-NA}" "$LOCAL_DECISION" "$FINAL_DECISION" "$EXEC_MODE" "${EXEC_LMIN:-NA}" "${EXEC_LMAX:-NA}" "${EXEC_BMIN:-NA}" "${EXEC_BMAX:-NA}" "${EXEC_GMIN:-NA}" "${EXEC_GMAX:-NA}" "$LOCAL_LEARNED_STATE" "${LOCAL_LEARNED_PROFILE:-NA}" "$LOCAL_LEARNED_CONF" "$LOCAL_LEARNED_SIM" "$LOCAL_LEARNED_SAMPLES" "$([ "$LOCAL_LEARNED_STATE" = READY ] || [ "$LOCAL_LEARNED_STATE" = READY_HARDWARE_MODEL ] || [ "$LOCAL_LEARNED_STATE" = READY_EFFICIENT ] && echo MATURE || echo CANDIDATE)" "$LOCAL_LEARNED_PROMOTION_REASON" "$NOWF" >"$LOCAL_BRAIN.tmp" 2>/dev/null && { printf "SHADOW_STATE=%s\nSHADOW_SCORE=%s\nSHADOW_REASON=%s\n" "${SHADOW_STATE:-NA}" "${SHADOW_SCORE:-0}" "${SHADOW_REASON:-NA}" >>"$LOCAL_BRAIN.tmp"; printf "HERMES_STATE=%s\nHERMES_PROFILE=%s\nHERMES_CONFIDENCE=%s\nHERMES_MODE=%s\nHERMES_VARIABLE=%s\nHERMES_VARIABLE_VALUE=%s\nHERMES_VARIABLE_STATE=%s\nHERMES_VARIABLE_SAMPLES=%s\nHERMES_VARIABLE_SUCCESS_RATE=%s\nHERMES_REASON=%s\nHERMES_EVIDENCE_SCOPE=%s\nHERMES_EVIDENCE_FILTER=%s\n" "${HERMES_STATE:-UNAVAILABLE}" "${HERMES_PROFILE:-NA}" "${HERMES_CONF:-0}" "${HERMES_MODE:-PROFILE}" "${HERMES_VARIABLE:-NA}" "${HERMES_VARIABLE_VALUE:-0}" "${HERMES_VARIABLE_STATE:-NONE}" "${HERMES_VARIABLE_SAMPLES:-0}" "${HERMES_VARIABLE_RATE:-0}" "${HERMES_REASON:-NA}" "${HERMES_EVIDENCE_SCOPE:-NA}" "${HERMES_EVIDENCE_FILTER:-NA}" >>"$LOCAL_BRAIN.tmp"; printf "CURRENT_BRAIN=%s\nBRAIN_SOURCE=%s\nBRAIN_MODE=%s\nBRAIN_PROFILE=%s\nFINAL_SOURCE=%s\nFINAL_ADJUSTMENT=%s\nCLOUD_CONNECTION_STATUS=%s\nCLOUD_PROVIDER=%s\nCLOUD_HTTP_CODE=%s\nCLOUD_HTTP_AGE_SEC=%s\nCLOUD_MODEL=%s\nCLOUD_IN_CONTROL=%s\nCLOUD_CONTROL_PROVIDER=%s\nCLOUD_PLAN_PROVIDER=%s\nCLOUD_PLAN_STATE=%s\nCLOUD_PLAN_SCORE=%s\nCLOUD_PLAN_REASON=%s\nCLOUD_ACCOUNTABILITY_STATUS=%s\nGEMINI_LAST_EVENT_STATUS=%s\nGEMINI_STATUS_FRESH=%s\nGEMINI_COOLDOWN_UNTIL=%s\nHERMES_CLOUD_TRANSPORT_STATUS=%s\nHERMES_CLOUD_TRANSPORT_AGE_SEC=%s\nHERMES_CLOUD_REPORTED_ROUTE=%s\nHERMES_ACTIVE_ROUTE=%s\nHERMES_CLOUD_USED=%s\nHERMES_PROPOSAL_STATE=%s\nHERMES_PROPOSAL_CONFIDENCE=%s\nHERMES_PROPOSAL_SOURCE=%s\nTHOUGHT_SOURCE_CURRENT=%s\nTHOUGHT_STATUS_CURRENT=%s\nTHOUGHT_AT=%s\nTHOUGHT_AGE_SEC=%s\nTHOUGHT_FRESH=%s\n" "${BRAIN_SOURCE:-LOCAL_BASELINE}" "${BRAIN_SOURCE:-LOCAL_BASELINE}" "${BRAIN_MODE:-OFFLINE_BASELINE}" "${BRAIN_PROFILE:-NA}" "${EXEC_SOURCE:-LOCAL_BASELINE}" "${FINAL_ADJUSTMENT:-NONE}" "${CLOUD_CONNECTION_STATUS:-UNKNOWN}" "${CLOUD_PROVIDER:-NONE}" "${CLOUD_HTTP_CODE:-NA}" "${CLOUD_HTTP_AGE_SEC:--1}" "${CLOUD_MODEL:-NA}" "${CLOUD_IN_CONTROL:-NO}" "${CLOUD_CONTROL_PROVIDER:-NONE}" "${CLOUD_PLAN_PROVIDER:-NONE}" "${CLOUD_PLAN_STATE:-UNAVAILABLE}" "${CLOUD_PLAN_SCORE:-0}" "${CLOUD_PLAN_REASON:-NO_VALID_GEMINI_PLAN}" "${CLOUD_ACCOUNTABILITY_STATUS:-NA}" "${GEMINI_LAST_EVENT_STATUS:-NONE}" "${GEMINI_STATUS_FRESH:-NO}" "${GEMINI_COOLDOWN_UNTIL:-0}" "${HERMES_CLOUD_TRANSPORT_STATUS:-NOT_YET_CHECKED}" "${HERMES_CLOUD_TRANSPORT_AGE_SEC:--1}" "${HERMES_CLOUD_REPORTED_ROUTE:-NA}" "${HERMES_ACTIVE_ROUTE:-STANDBY}" "${HERMES_CLOUD_USED:-NO}" "${HERMES_STATE:-UNAVAILABLE}" "${HERMES_CONF:-0}" "$([ "${HERMES_BACKEND:-LOCAL}" = CLOUD ] && echo HERMES_CLOUD || echo HERMES_H2_LOCAL)" "${THOUGHT_SOURCE_CURRENT:-NA}" "${THOUGHT_STATUS_CURRENT:-NA}" "${THOUGHT_AT_CURRENT:-0}" "${THOUGHT_AGE_SEC:--1}" "${THOUGHT_FRESH:-0}" >>"$LOCAL_BRAIN.tmp"; printf "AGENT_VERSION=%s\nAGENT_ROLE=%s\nAGENT_STATE=%s\nAGENT_INPUT_SOURCE=%s\nAGENT_DECISION_AUTHORITY=NONE\nAGENT_EXECUTION_OWNER=YES\nAGENT_HARDWARE_AUTHORITY=FULL\nAGENT_HARDWARE_TRUTH_SOURCE=AI_AGENT_DIRECT_READBACK\nAGENT_HARDWARE_TRUTH_AUTHORITY=AUTHORITATIVE\nAGENT_MUST_OBEY_ACTIVE_BRAIN=YES\nAGENT_CAN_CHOOSE_BRAIN=NO\nAGENT_CAN_OVERRIDE_BRAIN=NO\nAGENT_EXECUTION_BACKEND=%s\nAGENT_LAST_VALIDATION=%s\nAGENT_LAST_READBACK=%s\nDECISION_PRIORITY=%s\nBRAIN_CLOUD=GEMINI\nBRAIN_LOCAL=HERMES_H2\nTHIRD_BRAIN=NONE\nNATIVE_FAILSAFE=%s\n" "$AGENT_VERSION" "$AGENT_ROLE" "$AGENT_STATE" "$AGENT_INPUT_SOURCE" "$AGENT_EXECUTION_BACKEND" "${LAST_VALIDATION:-UNKNOWN}" "${READBACK_STATUS:-UNKNOWN}" "$DECISION_PRIORITY" "$([ "$BRAIN_SOURCE" = NONE ] && echo ACTIVE || echo STANDBY)" >>"$LOCAL_BRAIN.tmp"; _bp_present=NO; [ -r "$POLICY" ] && _bp_present=YES; _bp_rem=0; case "${POLICY_UNTIL:-}" in ''|*[!0-9]*) _bp_rem=0;; *) _bp_rem=$((${POLICY_UNTIL}-${NOWF:-0}));; esac; printf "BRAIN_STATE_AT=%s\nBRAIN_POLICY_STATE=%s\nBRAIN_POLICY_PRESENT=%s\nBRAIN_POLICY_AT=%s\nBRAIN_POLICY_UNTIL=%s\nBRAIN_POLICY_REMAINING_S=%s\nBRAIN_POLICY_SESSION_ID=%s\nBRAIN_POLICY_GAME=%s\nBRAIN_POLICY_USER_MODE=%s\nBRAIN_POLICY_WINDOW_MODE=%s\nBRAIN_POLICY_WINDOW_EPOCH=%s\n" "${NOWF:-0}" "${PREDICTIVE_STATE:-LOCAL_ONLY}" "$_bp_present" "${POLICY_AT:-0}" "${POLICY_UNTIL:-0}" "$_bp_rem" "${POLICY_SESSION_ID:-NA}" "${POLICY_GAME:-NA}" "${POLICY_USER_MODE:-NA}" "${POLICY_WINDOW_MODE:-NA}" "${POLICY_WINDOW_EPOCH:-NA}" >>"$LOCAL_BRAIN.tmp"; chmod 600 "$LOCAL_BRAIN.tmp" 2>/dev/null; printf "NETWORK_PING_AVG_MS=%s\nNETWORK_P95_MS=%s\nNETWORK_JITTER_MS=%s\nNETWORK_LOSS_PCT=%s\nNETWORK_QUALITY=%s\n" "$NET_AVG_MS" "$NET_P95_MS" "$NET_JITTER_MS" "$NET_LOSS_PCT" "$NET_QUALITY" >>"$LOCAL_BRAIN.tmp" 2>/dev/null; chmod 600 "$LOCAL_BRAIN.tmp" 2>/dev/null; mv -f "$LOCAL_BRAIN.tmp" "$LOCAL_BRAIN"; }
  printf "COOP_MODE='%s'\nLOCAL_DECISION='%s'\nFINAL_DECISION='%s'\nEXEC_SOURCE='%s'\nCOOP_AT='%s'\n" "$GEMINI_DECISION" "$LOCAL_DECISION" "$FINAL_DECISION" "$EXEC_SOURCE" "$NOWF" >"$COOP.tmp" 2>/dev/null && { chmod 600 "$COOP.tmp" 2>/dev/null; mv -f "$COOP.tmp" "$COOP"; }

  if [ "$LOCAL_DECISION/$GEMINI_DECISION/$FINAL_DECISION/$EXEC_SOURCE" != "$LAST_FUSION" ]; then
    log "HIERARCHY DECISION_SOURCE=$BRAIN_SOURCE AGENT=EXECUTOR EXEC_SOURCE=$EXEC_SOURCE GEMINI=$PREDICTIVE_STATE/$PREDICTIVE_CONF HERMES=$HERMES_STATE/$HERMES_CONF EVIDENCE=$LOCAL_LEARNED_STATE/$LOCAL_LEARNED_CONF FINAL=$FINAL_DECISION CPU=${CPU}C GPU=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C"
    LAST_FUSION="$LOCAL_DECISION/$GEMINI_DECISION/$FINAL_DECISION/$EXEC_SOURCE"
  fi
