predictor_runtime_alive(){
  _pp="$(cat "$P/predictor.pid" 2>/dev/null)"
  case "$_pp" in ''|*[!0-9]*) return 1;; esac
  [ "$_pp" -gt 1 ] 2>/dev/null || return 1
  kill -0 "$_pp" 2>/dev/null || return 1
  _pcmd="$(tr '\000' ' ' <"/proc/$_pp/cmdline" 2>/dev/null)"
  case "$_pcmd" in *djaeger_game_stabilizer/predictor.sh*) return 0;; esac
  return 1
}
ensure_predictor(){
  # LOOPFIX1: predictor startup must never block session detection/heartbeat.
  # If the predictor is already alive, clear any stale launch gate and return.
  if predictor_runtime_alive; then rm -rf "$P/predictor.starting" 2>/dev/null; return 0; fi
  _sg="$P/predictor.starting"
  # Atomic launch gate. Only the controller may own this short-lived gate.
  # A recent gate means a worker is still committing predictor.pid; do not race it.
  if [ -d "$_sg" ]; then
    _sat="$(cat "$_sg/at" 2>/dev/null)"; _now="$(date +%s)"
    case "$_sat" in ''|*[!0-9]*) _sat=0;; esac
    if [ $((_now-_sat)) -ge 0 ] && [ $((_now-_sat)) -lt 10 ]; then return 0; fi
    rm -rf "$_sg" 2>/dev/null
  fi
  mkdir "$_sg" 2>/dev/null || return 0
  printf '%s\n' "$(date +%s)" >"$_sg/at" 2>/dev/null
  chmod 700 "$_sg" 2>/dev/null

  # Only clear a stale singleton after the launch gate is ours.
  rm -rf "$P/predictor.lock" 2>/dev/null
  rm -f "$P/predictor.pid" 2>/dev/null
  if [ -r "$M/predictor.sh" ]; then
    sh "$M/predictor.sh" >/dev/null 2>&1 &
    _spawn=$!
    log "PREDICTOR ATOMIC_START_REQUESTED PID=$_spawn NONBLOCKING=1"
    # Keep the launch gate while predictor publishes its pid. The next controller
    # pass continues immediately; a failed launch becomes retryable after 10 s.
    return 0
  fi
  rm -rf "$_sg" 2>/dev/null
}

