restore_original(){
  ORIG="/data/adb/djaeger_ai/original_state"
  [ -r "$ORIG" ] || { log "ORIGINAL_STATE RESTORE_SKIPPED NO_SNAPSHOT"; return 1; }
  if ! snapshot_valid "$ORIG"; then
    log "ORIGINAL_STATE RESTORE_BLOCKED INVALID_SNAPSHOT=1 HARDWARE_UNTOUCHED=1"
    mv -f "$ORIG" "${ORIG}.invalid.$(date +%s)" 2>/dev/null
    return 1
  fi
  [ -x "$AGENT_EXEC" ] || { log "ORIGINAL_STATE RESTORE_BLOCKED AGENT_MISSING=1"; return 1; }
  _out="$(sh "$AGENT_EXEC" restore-original "$ORIG" 2>&1)"; _rc=$?
  log "ORIGINAL_STATE ROOT_AUTHORITY_RESTORE rc=$_rc result=$(printf '%s' "$_out"|tr '\n' ';'|cut -c1-360)"
  [ "$_rc" -eq 0 ] || return "$_rc"
  [ ! -e "$ORIG" ] || { log "ORIGINAL_STATE RESTORE_INCOMPLETE SNAPSHOT_RETAINED=1"; return 1; }
  log "ORIGINAL_STATE RESTORED VERIFIED=1 AUTHORITY=AI_AGENT>ROOT_AUTHORITY"
  return 0
}

# Restore every subordinate authority before the session identity is removed.
# A failed restore keeps both its typed snapshot and the boot/session context so
# the supervisor can retry instead of turning a recoverable failure into stale data.
authority_restore(){
  if [ -x "$AGENT_EXEC" ]; then
    if ! sh "$AGENT_EXEC" restore >/dev/null 2>&1; then
      log "AI_AGENT RESTORE_FAILED=1 SNAPSHOTS_RETAINED=1"
      return 1
    fi
  else
    log "AI_AGENT RESTORE_FAILED=1 AGENT_MISSING=1"; return 1
  fi
  rm -f "$ROOT_AUTHORITY_POLICY" "$LOCAL_TYPED_POLICY" 2>/dev/null
  LAST_ROOT_AUTHORITY_AT=""
NETWORK_STATE="$P/network_state"; NETWORK_STATUS="$P/network_status"; NETWORK_HISTORY="$P/network_history.csv"; NETWORK_CFG="$P/network.conf"; LAST_NETWORK_SAMPLE_AT=0; NET_PING_MS=NA; NET_AVG_MS=NA; NET_P95_MS=NA; NET_JITTER_MS=NA; NET_LOSS_PCT=NA; NET_QUALITY=UNKNOWN; NET_SAMPLES=0
  return 0
}

# v12.3.1 crash-safe lifecycle: if the controller is terminated while tuning is
# active, restore the pre-game CPU/GPU state before removing runtime markers.
controller_cleanup(){
  _cleanup_fail=0
  # LOOPFIX1: stop the independent UI/runtime heartbeat worker before removing
  # controller/session state. The worker never owns hardware authority.
  _hbp="$(cat "$RUNTIME_HEARTBEAT_PID" 2>/dev/null)"
  case "$_hbp" in ''|*[!0-9]*) :;; *) kill "$_hbp" 2>/dev/null || true;; esac
  rm -f "$RUNTIME_HEARTBEAT_PID" 2>/dev/null
  authority_restore >/dev/null 2>&1 || _cleanup_fail=1
  if [ -r "$P/original_state" ]; then
    log "CONTROLLER_EXIT ACTIVE=${ACTIVE:-0} RESTORE_REQUIRED=1"
    restore_original || _cleanup_fail=1
  fi
  if [ "$_cleanup_fail" -eq 0 ] && [ ! -e "$P/original_state" ]; then
    rm -f "$POLICY" "$P/session_start" "$P/session_game" "$P/session_id" 2>/dev/null
  else
    log "CONTROLLER_EXIT RESTORE_INCOMPLETE=1 SESSION_CONTEXT_RETAINED=1"
  fi
  _cpid="$(sed -n 's/^PID=//p' "$CONTROLLER_OWNER" 2>/dev/null)"
  _cbirth="$(sed -n 's/^STARTTIME=//p' "$CONTROLLER_OWNER" 2>/dev/null)"
  if [ "$_cpid" = "$$" ] && [ "$_cbirth" = "$(proc_starttime "$$")" ]; then
    rm -f "$CONTROLLER_PID" 2>/dev/null
    rm -rf "$CONTROLLER_LOCK" 2>/dev/null
  fi
}
trap 'controller_cleanup' EXIT INT TERM

# v12.9.43: reconcile transaction/session journals before legacy CPU/GPU orphan restore.
# The recovery manager is boot-aware: it never replays a prior-boot sysfs snapshot.
RECOVERY_EXEC="$M/system/bin/djaeger-session-recovery"
if [ -x "$RECOVERY_EXEC" ]; then
  sh "$RECOVERY_EXEC" startup-controller >>"$LOG" 2>&1 || {
    log "STARTUP_ABORT SESSION_RECOVERY_FAILED=1"
    exit 1
  }
fi

# Recover an orphan snapshot left by a previous controller crash/kill BEFORE a
# new game session is allowed to overwrite it with already-tuned values.
if [ -r "$P/original_state" ]; then
  log "ORPHAN_ORIGINAL_STATE DETECTED STARTUP_RECOVERY=1"
  if ! restore_original; then
    log "STARTUP_ABORT ORPHAN_RESTORE_UNSAFE=1"
    exit 1
  fi
  rm -f "$P/session_start" "$P/session_game" "$P/session_id" 2>/dev/null
fi

next_local_policy_at(){
  _now=$(date +%s)
  _last_file=$(cat "$LOCAL_POLICY_SEQ" 2>/dev/null); case "$_last_file" in ''|*[!0-9]*) _last_file=0;; esac
  case "$LOCAL_POLICY_AT" in ''|*[!0-9]*) LOCAL_POLICY_AT=0;; esac
  _last="$_last_file"; [ "$LOCAL_POLICY_AT" -gt "$_last" ] 2>/dev/null && _last="$LOCAL_POLICY_AT"
  [ "$_now" -gt "$_last" ] 2>/dev/null || _now=$((_last+1))
  NEXT_LOCAL_POLICY_AT="$_now"; LOCAL_POLICY_AT="$_now"
  printf '%s\n' "$_now" >"$LOCAL_POLICY_SEQ.tmp.$$" 2>/dev/null || return 1
  chmod 600 "$LOCAL_POLICY_SEQ.tmp.$$" 2>/dev/null
  mv -f "$LOCAL_POLICY_SEQ.tmp.$$" "$LOCAL_POLICY_SEQ" 2>/dev/null || return 1
  return 0
}
write_local_typed_policy(){
  _profile="$1"; _lmin="$2"; _lmax="$3"; _bmin="$4"; _bmax="$5"; _gmin="$6"; _gmax="$7"
  dynamic_valid "$_lmin" "$_lmax" "$_bmin" "$_bmax" "$_gmin" "$_gmax" || { log "LOCAL_TYPED_EXECUTOR REJECT INVALID_OPP profile=$_profile"; return 1; }
  next_local_policy_at || { log "LOCAL_TYPED_EXECUTOR REJECT POLICY_SEQUENCE_COMMIT_FAILED"; return 1; }; _pat="$NEXT_LOCAL_POLICY_AT"; _sid=$(cat "$P/session_id" 2>/dev/null); _game=$(cat "$P/session_game" 2>/dev/null)
  [ -n "$_sid" ] && [ -n "$_game" ] || { log "LOCAL_TYPED_EXECUTOR REJECT NO_SESSION_CONTEXT"; return 1; }
  _tmp="$LOCAL_TYPED_POLICY.tmp.$$"; umask 077
  {
    printf "POLICY_AT='%s'\nPOLICY_SESSION_ID='%s'\nPOLICY_GAME='%s'\nPOLICY_USER_MODE='%s'\n" "$_pat" "$_sid" "$_game" "${USER_MODE:-AUTO}"
    printf "AUTHORITY_SCOPE='AI_AGENT_TYPED_CPU_GPU'\nSOURCE='AI_AGENT_TYPED_EXECUTOR'\nLOGICAL_PROFILE='%s'\n" "$_profile"
    printf "THERMAL_MODE='NATIVE'\nSENSOR_MODE='NATIVE'\nTHERMAL_POLLING_MS='NA'\nTHERMAL_PASSIVE_MS='NA'\nTHERMAL_TRIP_SHIFT_MC='0'\n"
    printf "LITTLE_MIN_KHZ='%s'\nLITTLE_MAX_KHZ='%s'\nBIG_MIN_KHZ='%s'\nBIG_MAX_KHZ='%s'\n" "$_lmin" "$_lmax" "$_bmin" "$_bmax"
    printf "GPU_MIN_HZ='%s'\nGPU_MAX_HZ='%s'\n" "$((_gmin*1000000))" "$((_gmax*1000000))"
    printf "CPU_GOVERNOR='schedutil'\nGPU_GOVERNOR='msm-adreno-tz'\nCPU_BOOST='AUTO'\nGPU_BOOST_LEVEL='AUTO'\n"
    printf "BATTERY_MODE='NATIVE'\nCHARGE_ENABLE='AUTO'\nCHARGE_CURRENT_UA='NA'\nINPUT_CURRENT_UA='NA'\nBATTERY_VOLTAGE_UV='NA'\nCHARGE_END_PERCENT='NA'\n"
    printf "NATIVE_WRITE_PLAN=''\nCONFIDENCE='100'\nRATIONALE='DJAEGER local typed profile after validated OPP mapping'\n"
  } >"$_tmp" || { rm -f "$_tmp"; return 1; }
  chmod 600 "$_tmp" 2>/dev/null; mv -f "$_tmp" "$LOCAL_TYPED_POLICY"
}
execute_local_typed_policy(){
  _profile="$1"; shift
  [ -x "$AGENT_EXEC" ] || { log "AI_AGENT EXEC FAIL AGENT_MISSING"; return 1; }
  _agent_source="NATIVE_FAILSAFE"; _agent_policy="$LOCAL_TYPED_POLICY"
  # SESSIONFIX1: the very first policy of a newly detected game session is a
  # bootstrap baseline apply. At this point the new session_id already exists,
  # but fusion_decide() has not yet published a matching brain lease. A stale
  # HERMES_H2/GEMINI shell state from the previous session must therefore never
  # force the first STABLE apply through a brain lease tied to the old session.
  if [ "${ACTIVE:-0}" -eq 0 ] 2>/dev/null && [ -z "${PROFILE_APPLIED:-}" ]; then
    write_local_typed_policy "$_profile" "$@" || return 1
    _agent_source="BOOTSTRAP"; _agent_policy="$LOCAL_TYPED_POLICY"
  elif [ "${BRAIN_SOURCE:-NONE}" = GEMINI ] && [ "${PREDICTIVE_STATE:-LOCAL_ONLY}" = VALID ] && [ -r "$ROOT_AUTHORITY_POLICY" ]; then
    _agent_source="GEMINI"; _agent_policy="$ROOT_AUTHORITY_POLICY"
  else
    write_local_typed_policy "$_profile" "$@" || return 1
    if [ "${BRAIN_SOURCE:-NONE}" = HERMES_H2 ]; then _agent_source="HERMES_H2"
    else _agent_source="NATIVE_FAILSAFE"; fi
  fi
  _out="$(sh "$AGENT_EXEC" execute-policy "$_agent_policy" "$_agent_source" 2>&1)"; _rc=$?
  _es="$(sed -n "s/^EXECUTION_STATUS='\\([^']*\\)'.*/\\1/p" "$P/agent_execution_state.env" 2>/dev/null | head -1)"
  case "$_es" in VERIFIED_MATCH|VERIFIED_CLAMPED|VERIFIED) LAST_VALIDATION="ACCEPTED"; READBACK_STATUS="VERIFIED";; FAILED|READBACK_MISMATCH|VERIFY_FAILED) LAST_VALIDATION="REJECTED"; READBACK_STATUS="FAILED";; *) [ "$_rc" -eq 0 ] && { LAST_VALIDATION="ACCEPTED"; READBACK_STATUS="PENDING"; };; esac
  log "AI_AGENT EXEC source=$_agent_source profile=$_profile rc=$_rc result=$(printf '%s' "$_out"|tr '\n' ';'|cut -c1-420)"
  [ "$_rc" -eq 0 ] || return "$_rc"
  return 0
}

apply(){
  vals "$1"; dynamic_valid "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || { log "LOCAL_TYPED_EXECUTOR REJECT PROFILE_INVALID profile=$1"; return 1; }
  execute_local_typed_policy "$1" "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
  PROFILE="$1"; temps; log "LOCAL PROFILE=$PROFILE AUTHORITY=TYPED_ROOT_EXECUTOR CPU_T=${CPU}C GPU_T=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C GPU=${GM}-${GX}MHz"; return 0
}
dynamic_valid(){ refresh_live_contract; valid_l "$1" && valid_l "$2" && valid_b "$3" && valid_b "$4" && valid_g "$5" && valid_g "$6" && [ "$1" -le "$2" ] && [ "$3" -le "$4" ] && [ "$5" -le "$6" ]; }
apply_dynamic(){
  dynamic_valid "$1" "$2" "$3" "$4" "$5" "$6" || { log "DYNAMIC_EXECUTOR REJECT INVALID_BUDGET"; return 1; }
  execute_local_typed_policy "$FINAL_DECISION" "$1" "$2" "$3" "$4" "$5" "$6" || return 1
  temps; log "DYNAMIC_EXECUTOR AUTHORITY=TYPED_ROOT_EXECUTOR SOURCE=$EXEC_SOURCE LOGICAL_PROFILE=$FINAL_DECISION L=$1-$2 B=$3-$4 G=$5-$6 CPU_T=${CPU}C GPU_T=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C"
  return 0
}

clear_strategy_transparency(){
  rm -f "$STRATEGY_RESULT" 2>/dev/null
}
refresh_strategy_outcome(){
  LAST_OUTCOME="PENDING"
  [ -r "$STRATEGY_OUTCOME" ] || return 0
  _oa=$(sed -n "s/^POLICY_AT='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  _os=$(sed -n "s/^SESSION_ID='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  _og=$(sed -n "s/^GAME='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  _om=$(sed -n "s/^USER_MODE='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  _oo=$(sed -n "s/^OUTCOME='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  _ou=$(sed -n "s/^UPDATED_AT='\([^']*\)'.*/\1/p" "$STRATEGY_OUTCOME" | head -1)
  case "$_oo" in SUCCESS|FAILED|MIXED) :;; *) return 0;; esac
  case "$_oa:$_ou" in *[!0-9:]*|*::*|:*) return 0;; esac
  _now=$(date +%s); [ "$_ou" -le "$_now" ] 2>/dev/null || return 0
  [ $((_now-_ou)) -le 300 ] 2>/dev/null || return 0
  _sid=$(cat "$P/session_id" 2>/dev/null); _sg=$(cat "$P/session_game" 2>/dev/null)
  [ -n "$_sid" ] && [ "$_os" = "$_sid" ] || return 0
  [ -n "$_sg" ] && [ "$_og" = "$_sg" ] || return 0
  [ "$_om" = "${USER_MODE:-AUTO}" ] || return 0
  case "${POLICY_AT:-}" in ''|*[!0-9]*) return 0;; esac
  [ "$_oa" = "$POLICY_AT" ] || return 0
  LAST_OUTCOME="$_oo"
}
