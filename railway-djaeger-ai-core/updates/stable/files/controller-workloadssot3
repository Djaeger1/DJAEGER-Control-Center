    FRAME_SPIKE_COUNT=0; FRAME_SPIKE_STATE="CLEAR"
  fi

  case "$PROFILE" in STABLE|PERFORM) :;; *) FRAME_POOR_COUNT=0; return;; esac
  # Comfort headroom: RESPONSE only while skin is <=38C.
  if [ "$CPU" -le 60 ] && [ "$GPUT" -le 60 ] && [ "$SKIN" -le 38 ] && [ "$BAT" -le 39 ]; then
    if [ "$FRAME_SPIKE_STATE" = "SUSTAINED" ]; then FRAME_POOR_COUNT=$((FRAME_POOR_COUNT+1)); else FRAME_POOR_COUNT=0; fi
    if [ "$FRAME_POOR_COUNT" -ge 1 ]; then
      FRAME_ADVISORY="MORE_RESPONSE"
      log "FRAME_ADVISORY=MORE_RESPONSE REASON=SUSTAINED_POOR PROFILE=$PROFILE P99=${P99_MS}ms JANK=${JANK_PCT}% CPU=${CPU}C GPU=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C"
      FRAME_POOR_COUNT=0
    fi
  else
    FRAME_POOR_COUNT=0
  fi
}

local_thought_publish(){
  # CLOUDTRUTH1: Thought must describe the brain that actually won arbitration.
  # Presentation may be local NLG, but SOURCE is the decision provider.
  _now=$(date +%s)
  case "${BRAIN_SOURCE:-NONE}" in
    GEMINI)
      # Predictor owns GEMINI thought publication. Never replace a selected Gemini
      # decision with a Hermes explanation merely because the last text is older.
      return 0
