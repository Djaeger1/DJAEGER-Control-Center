# Overflow-safe uA*uV -> mW conversion for Android shells that may use 32-bit arithmetic.
# Decompose uA into mA + remainder and uV into mV before multiplying.
power_mw_from_ua_uv(){
  _ua=${1#-}; _uv=${2#-}
  _ma=$((_ua/1000)); _ur=$((_ua%1000)); _mv=$((_uv/1000))
  echo $(( (_ma*_mv)/1000 + (_ur*_mv)/1000000 ))
}
power_sample(){
  # v12.1.4: normalize vendor-specific current_now units and reject implausible
  # battery-side power before it can enter efficiency learning. Linux power_supply
  # normally exposes uA/uV, but some Android vendor kernels expose current in mA.
  BPS=/sys/class/power_supply/battery
  BATT_STATUS=$(r "$BPS/status"); BATT_UA_RAW=$(r "$BPS/current_now"); BATT_UV=$(r "$BPS/voltage_now")
  BATT_UA=NA; BATT_POWER_MW=NA; BATT_POWER_VALID=REJECTED; BATT_POWER_REASON=NO_SAMPLE; BATT_CURRENT_SCALE=NA
  case "$BATT_UA_RAW:$BATT_UV" in
    *[!0-9:-]*|:|*:) BATT_POWER_REASON=NON_NUMERIC;;
    *)
      AU=${BATT_UA_RAW#-}; AV=${BATT_UV#-}
      if [ "$AV" -lt 2500000 ] || [ "$AV" -gt 5000000 ]; then
        BATT_POWER_REASON=VOLTAGE_IMPLAUSIBLE
      else
        # First interpret current_now according to the documented uA convention.
        P_UA=$(power_mw_from_ua_uv "$AU" "$AV")
        # During an active game, <100mW is not a credible whole-device reading.
        # If the raw current is in a plausible mA range, try vendor mA -> uA.
        if [ "$P_UA" -ge 100 ] && [ "$P_UA" -le 15000 ]; then
          BATT_UA=$AU; BATT_POWER_MW=$P_UA; BATT_CURRENT_SCALE=UA_NATIVE
        elif [ "$AU" -ge 20 ] && [ "$AU" -le 5000 ]; then
          NUA=$((AU*1000)); P_MA=$(power_mw_from_ua_uv "$NUA" "$AV")
          if [ "$P_MA" -ge 100 ] && [ "$P_MA" -le 15000 ]; then
            BATT_UA=$NUA; BATT_POWER_MW=$P_MA; BATT_CURRENT_SCALE=MA_X1000
          else BATT_POWER_REASON=POWER_IMPLAUSIBLE; fi
        else BATT_POWER_REASON=POWER_IMPLAUSIBLE; fi
        if [ "$BATT_POWER_MW" != NA ]; then
          case "$BATT_STATUS" in Discharging) BATT_POWER_VALID=VALID; BATT_POWER_REASON=OK;; *) BATT_POWER_VALID=REJECTED; BATT_POWER_REASON=STATUS_${BATT_STATUS:-NA};; esac
        fi
      fi
    ;;
  esac
}
