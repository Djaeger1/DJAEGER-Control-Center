  if [ -r "$EFFMEM" ]; then
    ER="$(awk -F, -v cur="$CURRENT_SCENE" -v wm="$WINDOW_MODE" -v game="${SESSION_GAME_ID:-UNKNOWN}" -v um="${USER_MODE:-AUTO}" -v now="$(date +%s)" '
