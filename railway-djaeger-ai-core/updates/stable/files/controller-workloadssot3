    printf "PIPELINE_APPLIED='%s'\n" "$([ "${EXEC_SOURCE:-NA}" != NA ] && echo YES || echo NO)"
    printf "PIPELINE_READBACK_VERIFIED='%s'\n" "$([ "${READBACK_STATUS:-${VERIFY_STATUS:-UNKNOWN}}" = VERIFIED ] && echo YES || echo NO)"
    printf "PIPELINE_OUTCOME_READY='%s'\n" "$([ "${LAST_OUTCOME:-PENDING}" != PENDING ] && echo YES || echo NO)"
