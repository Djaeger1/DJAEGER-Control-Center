hermes_cloud_decide(){
  HERMES_BACKEND="LOCAL"
  # BRAINROUTER1: one expensive brain at a time. Gemini owns valid heavy reasoning first.
  [ "${PREDICTIVE_STATE:-LOCAL_ONLY}" = VALID ] && return 0
  [ -r "$HERMES_CLOUD" ] || return 0
  # When Local HERMES already has a confident answer for an ordinary condition, keep it local.
  # Cloud is a deputy/specialist, not a duplicate thinker. Escalate on low confidence,
  # invalid local reasoning, or materially difficult frame/thermal conditions.
  _hc_need=0
  [ "${HERMES_STATE:-UNAVAILABLE}" = VALID ] || _hc_need=1
  case "${HERMES_CONF:-0}" in ''|*[!0-9]*) _hc_need=1;; *) [ "${HERMES_CONF:-0}" -lt 70 ] 2>/dev/null && _hc_need=1;; esac
  case "${LOCAL_DECISION:-STABLE}" in SAFE|FREEZE|COOL) _hc_need=1;; esac
  awk "BEGIN{exit !((${JANK_PCT:-0}+0)>=5 || (${P99_MS:-0}+0)>=45)}" >/dev/null 2>&1 && _hc_need=1
  [ "$_hc_need" -eq 1 ] || return 0
  SESSION_GAME_ID="$(cat "$SESSION_GAME" 2>/dev/null)"; [ -n "$SESSION_GAME_ID" ] || SESSION_GAME_ID="UNKNOWN"
  # Non-blocking/event-driven: helper owns lock, throttle, timeout and secret handling.
  sh "$HERMES_CLOUD" request-async "${CURRENT_SCENE:-NA}" "${WINDOW_MODE:-INACTIVE}" "$SESSION_GAME_ID" "${USER_MODE:-AUTO}" \
    "${SKIN:-0}" "${CPU:-0}" "${GPUT:-0}" "${BAT:-0}" "${FPS_EST:-0}" "${P95_MS:-0}" "${P99_MS:-0}" "${JANK_PCT:-0}" "${LOCAL_DECISION:-STABLE}" >/dev/null 2>&1 || true
  [ -r "$HERMES_CLOUD_PROPOSAL" ] || return 0
  hcget(){ awk -v k="$1" 'index($0,k"=\047")==1 && substr($0,length($0),1)=="\047"{print substr($0,length(k)+3,length($0)-length(k)-3);exit}' "$HERMES_CLOUD_PROPOSAL" 2>/dev/null; }
  _schema="$(hcget SCHEMA)"; _at="$(hcget AT)"; _exp="$(hcget EXPIRES_AT)"; _state="$(hcget STATE)"; _sid="$(hcget SESSION_ID)"; _game="$(hcget GAME)"; _um="$(hcget USER_MODE)"; _wm="$(hcget WINDOW_MODE)"; _we="$(hcget WINDOW_EPOCH)"; _scene="$(hcget SCENE)"
  [ "$_schema" = DJAEGER_HERMES_CLOUD_PROPOSAL_V1 ] || return 0
  case "$_at:$_exp" in *[!0-9:]*|:*) return 0;; esac
  _now="$(date +%s)"; [ "$_at" -le "$_now" ] 2>/dev/null && [ "$_now" -le "$_exp" ] 2>/dev/null || return 0
  [ "$_state" = VALID ] || return 0
  _cur_sid="$(cat "$P/session_id" 2>/dev/null)"; _cur_we="$(cat "$WINDOW_EPOCH_FILE" 2>/dev/null)"; [ -n "$_cur_we" ] || _cur_we=0
  # CLOUDTRUTH1: SCENE is deliberately not part of the async lease identity.
  # FPS/jank/momentum bins can change while the cloud request is in flight. The
  # durable lease is session+game+user+window mode+window epoch+TTL; native thermal
  # guards below still prevent a now-weaker cloud proposal from reducing safety.
  [ "$_sid" = "$_cur_sid" ] && [ "$_game" = "$SESSION_GAME_ID" ] && [ "$_um" = "${USER_MODE:-AUTO}" ] && [ "$_wm" = "${WINDOW_MODE:-INACTIVE}" ] && [ "$_we" = "$_cur_we" ] || return 0
  _profile="$(hcget PROFILE)"; _conf="$(hcget CONFIDENCE)"; _reason="$(hcget REASON)"; _route="$(hcget ROUTE)"
  case "$_profile" in STABLE|PERFORM|RESPONSE|SOFT_COOL|COOL|FREEZE|SAFE) :;; *) return 0;; esac
  if [ "$_profile" = FREEZE ] && [ "${LOCAL_DECISION:-STABLE}" != FREEZE ]; then return 0; fi
  case "$_conf" in ''|*[!0-9]*) return 0;; esac
  [ "$_conf" -ge 50 ] 2>/dev/null && [ "$_conf" -le 100 ] 2>/dev/null || return 0
  # Native deterministic guards are physically authoritative and cannot be weakened by cloud cognition.
  if [ "$LOCAL_DECISION" = SAFE ] && [ "$_profile" != SAFE ]; then return 0; fi
  if [ "$LOCAL_DECISION" = FREEZE ]; then case "$_profile" in SAFE|FREEZE) :;; *) return 0;; esac; fi
  if [ "$LOCAL_DECISION" = COOL ]; then case "$_profile" in SAFE|FREEZE|COOL) :;; *) return 0;; esac; fi
  if [ "$LOCAL_DECISION" = SOFT_COOL ]; then case "$_profile" in SAFE|FREEZE|COOL|SOFT_COOL) :;; *) return 0;; esac; fi
  HERMES_STATE="VALID"; HERMES_PROFILE="$_profile"; HERMES_CONF="$_conf"; HERMES_MODE="PROFILE"
  HERMES_LMIN=""; HERMES_LMAX=""; HERMES_BMIN=""; HERMES_BMAX=""; HERMES_GMIN=""; HERMES_GMAX=""
  HERMES_VARIABLE="CLOUD_${_route:-AUTO}"; HERMES_VARIABLE_VALUE=0; HERMES_VARIABLE_STATE="REMOTE_COGNITION"; HERMES_VARIABLE_SAMPLES=0; HERMES_VARIABLE_RATE=0
  HERMES_REASON="HERMESCLOUD1:${_reason:-CLOUD_STRATEGY}"; HERMES_EVIDENCE_SCOPE="SHAREDINT1_PLUS_CURRENT_TELEMETRY"; HERMES_EVIDENCE_FILTER="STRICT_SESSION_CONTEXT_LEASE"
  HERMES_BACKEND="CLOUD"
}

