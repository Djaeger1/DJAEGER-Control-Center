freeze_frame_rescue_release(){
  vals FREEZE || return 1; dynamic_valid "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
  write_local_typed_policy FREEZE "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
