stabilize_local(){
  NOWH="$(date +%s)"
  [ "$PROFILE_SINCE" -le 0 ] 2>/dev/null && PROFILE_SINCE="$NOWH"

  # SAFE, FREEZE, COOL, and thermal entry into SOFT_COOL are never delayed.
  if [ "$NEW" = "SAFE" ] || [ "$NEW" = "FREEZE" ] || [ "$NEW" = "COOL" ] || { [ "$NEW" = "SOFT_COOL" ] && [ "$PROFILE" != "SOFT_COOL" ]; }; then
    CANDIDATE=""; CANDIDATE_COUNT=0
    return
  fi

  # v10.6.8: SOFT_COOL at 42C protects frame pacing. It recovers only after
  # two consecutive samples at <=40C with safe die/battery headroom.
  if [ "$PROFILE" = "SOFT_COOL" ] && [ "$NEW" != "SOFT_COOL" ] && [ "$NEW" != "COOL" ] && [ "$NEW" != "FREEZE" ] && [ "$NEW" != "SAFE" ]; then
    if [ "${SKIN:-99}" -gt 40 ] || [ "${BAT:-99}" -gt 40 ] || [ "${CPU:-99}" -gt 65 ] || [ "${GPUT:-99}" -gt 65 ]; then
      CANDIDATE=""; CANDIDATE_COUNT=0; NEW="SOFT_COOL"
      if [ "${SKIN:-99}" -gt 40 ]; then WHY="SKIN_HYSTERESIS"
      elif [ "${BAT:-99}" -gt 40 ]; then WHY="BATTERY_HEADROOM"
      elif [ "${CPU:-99}" -gt 65 ]; then WHY="CPU_HEADROOM"
      else WHY="GPU_HEADROOM"; fi
      log "SOFT_COOL_RECOVERY WAIT=$WHY CPU=${CPU}C GPU=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C"
      return
    fi
    if [ "$CANDIDATE" = "SOFT_COOL_RECOVERY" ]; then CANDIDATE_COUNT=$((CANDIDATE_COUNT+1)); else CANDIDATE="SOFT_COOL_RECOVERY"; CANDIDATE_COUNT=1; fi
    if [ "$CANDIDATE_COUNT" -lt 2 ]; then
      NEW="SOFT_COOL"; log "SOFT_COOL_RECOVERY HOLD COUNT=$CANDIDATE_COUNT"
    else
      NEW="$PROFILE"; CANDIDATE=""; CANDIDATE_COUNT=0; log "SOFT_COOL_RECOVERY ACCEPT=STABLE"
    fi
    return
  fi

  # v8.6: leaving COOL requires 3 consecutive recovery samples.
  # This only delays COOL -> warmer recovery; it never delays entering FREEZE/SAFE.
  if [ "$PROFILE" = "COOL" ] && [ "$NEW" != "COOL" ] && [ "$NEW" != "FREEZE" ] && [ "$NEW" != "SAFE" ]; then
    # v8.8 recovery headroom gate. Entry to COOL/SAFE is unchanged and immediate.
    # Adaptive Comfort v10.6.7: require skin <=40C, battery <=40C, CPU/GPU die <=65C before recovery counts.
    if [ "${SKIN:-99}" -gt 40 ] || [ "${BAT:-99}" -gt 40 ] || [ "${CPU:-99}" -gt 65 ] || [ "${GPUT:-99}" -gt 65 ]; then
      CANDIDATE=""; CANDIDATE_COUNT=0
      log "COOL_RECOVERY WAIT_HEADROOM TARGET=$NEW CPU=${CPU}C GPU=${GPUT}C SKIN=${SKIN}C BAT=${BAT}C"
      echo "$(date +%s),WAIT_HEADROOM,$NEW,0,$((NOWH-PROFILE_SINCE))" >> "$M/cool_recovery.csv"
      tail -n 61 "$M/cool_recovery.csv" > "$M/cool_recovery.x" && mv "$M/cool_recovery.x" "$M/cool_recovery.csv"
      NEW="COOL"
      return
    fi
    if [ "$CANDIDATE" = "COOL_RECOVERY" ]; then
      CANDIDATE_COUNT=$((CANDIDATE_COUNT+1))
    else
      CANDIDATE="COOL_RECOVERY"; CANDIDATE_COUNT=1
    fi
    AGE=$((NOWH-PROFILE_SINCE))
    if [ "$CANDIDATE_COUNT" -lt 3 ]; then
      log "COOL_RECOVERY HOLD=COOL TARGET=$NEW COUNT=$CANDIDATE_COUNT AGE=${AGE}s"
      echo "$(date +%s),HOLD,$NEW,$CANDIDATE_COUNT,$AGE" >> "$M/cool_recovery.csv"
      tail -n 61 "$M/cool_recovery.csv" > "$M/cool_recovery.x" && mv "$M/cool_recovery.x" "$M/cool_recovery.csv"
      NEW="COOL"
    else
      # v9.2 recovery landing invariant: COOL may only recover to STABLE.
      # A RESPONSE request during recovery cannot inherit the STABLE recovery count.
      RECOVERY_REQUEST="$NEW"
      NEW="STABLE"
      log "COOL_RECOVERY ACCEPT=STABLE REQUESTED=$RECOVERY_REQUEST COUNT=$CANDIDATE_COUNT AGE=${AGE}s"
      echo "$(date +%s),ACCEPT,STABLE,$CANDIDATE_COUNT,$AGE" >> "$M/cool_recovery.csv"
      tail -n 61 "$M/cool_recovery.csv" > "$M/cool_recovery.x" && mv "$M/cool_recovery.x" "$M/cool_recovery.csv"
      CANDIDATE=""; CANDIDATE_COUNT=0
    fi
    return
  fi

  # No transition requested.
  if [ "$NEW" = "$PROFILE" ]; then
    CANDIDATE=""; CANDIDATE_COUNT=0
    return
  fi

  # PROFILEMAP1: RESPONSE is no longer a residency profile. It is a bounded
  # micro-burst overlay handled after fusion, so local transition hysteresis
  # must never hold it for tens of seconds.
  CANDIDATE=""; CANDIDATE_COUNT=0
}


