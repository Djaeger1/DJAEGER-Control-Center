}

freeze_rescue_threshold(){
  _fr_key="$1"; awk -v k="$_fr_key" 'index($0,k"=\047")==1&&substr($0,length($0),1)=="\047"{print substr($0,length(k)+3,length($0)-length(k)-3);exit}' "$M/system/etc/djaeger/game-profile-map.conf" 2>/dev/null
}
write_freeze_rescue_policy(){
