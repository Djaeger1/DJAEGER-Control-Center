  _now="$(date +%s)"
  case "$_sf_created" in ''|*[!0-9]*) return 0;; esac
  [ $((_now-_sf_created)) -le 120 ] || { clear_strategy_transparency; return 0; }
  [ -n "$_sf_tx" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_complete" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_bounds" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_livecap" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_exactopp" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_govcap" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_capctx" = "YES" ] || { clear_strategy_transparency; return 0; }
  [ -n "$_sf_capgen" ] && [ "$_sf_capgen" = "$_live_capgen" ] || { clear_strategy_transparency; return 0; }
  [ -n "$_sf_capsig" ] && [ "$_sf_capsig" = "$_live_capsig" ] || { clear_strategy_transparency; return 0; }
  [ -n "$_sf_capepoch" ] && [ "$_sf_capepoch" = "$_live_capepoch" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_oppcanon" = "YES" ] && [ "$_sf_oppcanon" = "$_live_oppcanon" ] || { clear_strategy_transparency; return 0; }
  [ "$_sf_govcanon" = "YES" ] && [ "$_sf_govcanon" = "$_live_govcanon" ] || { clear_strategy_transparency; return 0; }
  [ -n "$_sf_owner_mode" ] && [ "$_sf_owner_mode" = "${USER_MODE:-AUTO}" ] || { clear_strategy_transparency; return 0; }
  if [ -n "${PROFILE:-}" ] && [ "$_sf_profile" != "UNKNOWN" ]; then
    [ "$_sf_profile" = "$PROFILE" ] || { clear_strategy_transparency; return 0; }
  fi
  [ -n "$_sf_game" ] && [ "$_sf_game" != "UNKNOWN" ] || { clear_strategy_transparency; return 0; }
  [ -n "${GAME:-}" ] && [ "$_sf_game" = "$GAME" ] || { clear_strategy_transparency; return 0; }
  case "$_sf_observed_at" in ''|*[!0-9]*) clear_strategy_transparency; return 0;; esac
  _obs_now=$(date +%s)
  _obs_age=$((_obs_now - _sf_observed_at))
  [ "$_obs_age" -ge 0 ] && [ "$_obs_age" -le 120 ] || { clear_strategy_transparency; return 0; }
  case "$_sf_observation_fps" in
    NA) ;;
    ''|*[!0-9.]*) clear_strategy_transparency; return 0 ;;
    *.*.*|.*|*.) clear_strategy_transparency; return 0 ;;
    *)
      _fps_int="${_sf_observation_fps%%.*}"
      case "$_fps_int" in ''|*[!0-9]*) clear_strategy_transparency; return 0;; esac
      if [ "$_fps_int" -gt 1000 ] 2>/dev/null; then
        clear_strategy_transparency; return 0
      elif [ "$_fps_int" -eq 1000 ] 2>/dev/null; then
        case "$_sf_observation_fps" in 1000|1000.0|1000.00|1000.000) ;; *) clear_strategy_transparency; return 0;; esac
      fi
