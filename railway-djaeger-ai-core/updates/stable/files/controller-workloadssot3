}
response_return_apply(){
  _rr="${1:-STABLE}"; vals "$_rr" || return 1; dynamic_valid "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
  write_local_typed_policy "$_rr" "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
