    HERMES_H2)
      _conf="${HERMES_CONF:-0}"; _state="${HERMES_STATE:-UNAVAILABLE}"; _txt=""
      if [ "${HERMES_BACKEND:-LOCAL}" = CLOUD ]; then _src=HERMES_CLOUD; else _src=HERMES_H2; fi
      if [ -x "$HERMES_NLG" ]; then
        _txt="$(DJAEGER_MODDIR="$M" DJAEGER_STATE_DIR="$P" sh "$HERMES_NLG" text 2>/dev/null | head -c 780)"
      fi
      if [ -z "$_txt" ]; then
        if [ "$_src" = HERMES_CLOUD ]; then
          _txt="HERMES Cloud memilih profil ${HERMES_PROFILE:-NA} berdasarkan telemetry game saat ini. Keputusan tetap melewati thermal guard, validasi Agent, readback, dan rollback sebelum diterapkan."
        elif [ "$_state" = VALID ]; then
