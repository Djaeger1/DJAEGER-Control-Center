  log "FREEZE_FRAME_RESCUE RELEASE via=AI_AGENT rc=$_rc result=$(printf '%s' "$_out"|tr '\n' ';'|cut -c1-300)"
  if [ "$_rc" -eq 0 ]; then
    FREEZE_FRAME_RESCUE_ACTIVE=0; FREEZE_FRAME_BAD_COUNT=0; FREEZE_FRAME_GOOD_COUNT=0
    PROFILE=FREEZE; PROFILE_APPLIED=FREEZE; EXEC_MODE=PROFILE; EXEC_LMIN=$LM; EXEC_LMAX=$LX; EXEC_BMIN=$BM; EXEC_BMAX=$BX; EXEC_GMIN=$GM; EXEC_GMAX=$GX
    APPLIED_SIGNATURE="FREEZE:PROFILE:$LM:$LX:$BM:$BX:$GM:$GX"; FINAL_ADJUSTMENT="FREEZE_FRAME_RESCUE_RELEASED"
