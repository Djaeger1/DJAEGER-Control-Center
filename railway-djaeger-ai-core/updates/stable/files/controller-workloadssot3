response_burst_apply(){
  vals RESPONSE || return 1; dynamic_valid "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
  write_local_typed_policy RESPONSE "$LM" "$LX" "$BM" "$BX" "$GM" "$GX" || return 1
