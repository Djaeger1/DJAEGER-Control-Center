#!/system/bin/sh
# DJAEGER NEURONUSAGEFIX2 + CLOUDTRUTH1 remote hotfix wrapper.
# Installed through REMOTEBOOT1. Software-state only; no hardware/sysfs authority.
M="${DJAEGER_MODDIR:-/data/adb/modules/djaeger_game_stabilizer}"
P="${DJAEGER_STATE_DIR:-/data/adb/djaeger_ai}"
LIVEP="${DJAEGER_REMOTE_BASE_STATE_DIR:-/data/adb/djaeger_ai}"
RUNTIME="$LIVEP/railway/runtime"
BASE="$RUNTIME/djaeger-hermes-cloud.seq3.base"
PATCHED="$RUNTIME/djaeger-hermes-cloud.neuronusagefix2"
ROLLBACK_BASE="$LIVEP/railway/rollback/3/system/bin/djaeger-hermes-cloud"

qget(){
  [ -r "$1" ] || return 0
  awk -F= -v k="$2" '$1==k{v=substr($0,index($0,"=")+1);gsub(/^[[:space:]\047\042]+|[[:space:]\047\042]+$/,"",v);print v;exit}' "$1" 2>/dev/null
}

seed_base(){
  mkdir -p "$RUNTIME" 2>/dev/null || return 1
  chmod 700 "$RUNTIME" 2>/dev/null || true
  if [ ! -s "$BASE" ]; then
    [ -r "$ROLLBACK_BASE" ] || return 1
    grep -Fq 'NEURONUSAGEFIX1' "$ROLLBACK_BASE" || return 1
    grep -Fq 'neuron_record "$_route" "$_probe_in" "$_probe_out"' "$ROLLBACK_BASE" || return 1
    cp -pf "$ROLLBACK_BASE" "$BASE.tmp.$$" 2>/dev/null || return 1
    chmod 600 "$BASE.tmp.$$" 2>/dev/null || true
    mv -f "$BASE.tmp.$$" "$BASE" || return 1
  fi
}

build_patched(){
  seed_base || return 1
  if [ -s "$PATCHED" ] && grep -Fq 'NEURONUSAGEFIX2_REMOTE_PATCH' "$PATCHED" 2>/dev/null; then return 0; fi
  awk '
    /# NEURONUSAGEFIX1: successful explicit probe compute counts even with model=UNKNOWN\./ {
      print "    # NEURONUSAGEFIX2_REMOTE_PATCH: explicit liveness probe is not user Cloud usage."
      getline
      next
    }
    { print }
  ' "$BASE" >"$PATCHED.tmp.$$" || return 1
  sh -n "$PATCHED.tmp.$$" >/dev/null 2>&1 || { rm -f "$PATCHED.tmp.$$"; return 1; }
  sed -n '/^probe_core(){/,/^}/p' "$PATCHED.tmp.$$" | grep -Fq 'neuron_record' && { rm -f "$PATCHED.tmp.$$"; return 1; }
  grep -Fq 'neuron_record "$_bill_route" "${_req_chars:-0}" "$_out_chars"' "$PATCHED.tmp.$$" || { rm -f "$PATCHED.tmp.$$"; return 1; }
  grep -Fq 'neuron_record "$_route" "$_ic" "$_oc"' "$PATCHED.tmp.$$" || { rm -f "$PATCHED.tmp.$$"; return 1; }
  chmod 700 "$PATCHED.tmp.$$" 2>/dev/null || true
  mv -f "$PATCHED.tmp.$$" "$PATCHED" || return 1
}

normalize_cloud_state(){
  _f="$1"; [ -r "$_f" ] || return 0
  _qs="$(qget "$_f" HERMES_NEURON_PROVIDER_QUOTA_STATE)"
  _qr="$(qget "$_f" HERMES_NEURON_PROVIDER_QUOTA_REASON)"
  _st="$(qget "$_f" HERMES_CLOUD_STATE)"
  _at="$(qget "$_f" HERMES_CLOUD_AT)"
  _now="$(date +%s 2>/dev/null)"; case "$_now" in ''|*[!0-9]*) _now=0;; esac
  _age=-1; case "$_at" in ''|*[!0-9]*) :;; *) _age=$((_now-_at));; esac
  _new=""; _reason=""; _route=""; _model=""
  if [ "$_qs" = EXHAUSTED ] || [ "$_qr" = WORKERS_AI_FREE_QUOTA_EXHAUSTED ]; then
    _new=QUOTA_EXHAUSTED; _reason=WORKERS_AI_FREE_QUOTA_EXHAUSTED; _route=NA; _model=NA
  elif [ "$_st" = READY ] && { [ "$_age" -lt 0 ] 2>/dev/null || [ "$_age" -gt 300 ] 2>/dev/null; }; then
    _new=UNAVAILABLE; _reason=STALE_CLOUD_STATE; _route=NA; _model=NA
  else
    return 0
  fi
  _tmp="$_f.cloudtruth.$$"
  awk -v st="$_new" -v rs="$_reason" -v rt="$_route" -v md="$_model" '
    BEGIN{a=0;b=0;c=0;d=0}
    /^HERMES_CLOUD_STATE=/{print "HERMES_CLOUD_STATE=\047" st "\047";a=1;next}
    /^HERMES_CLOUD_REASON=/{print "HERMES_CLOUD_REASON=\047" rs "\047";b=1;next}
    /^HERMES_CLOUD_ROUTE=/{print "HERMES_CLOUD_ROUTE=\047" rt "\047";c=1;next}
    /^HERMES_CLOUD_MODEL=/{print "HERMES_CLOUD_MODEL=\047" md "\047";d=1;next}
    {print}
    END{
      if(!a)print "HERMES_CLOUD_STATE=\047" st "\047"
      if(!b)print "HERMES_CLOUD_REASON=\047" rs "\047"
      if(!c)print "HERMES_CLOUD_ROUTE=\047" rt "\047"
      if(!d)print "HERMES_CLOUD_MODEL=\047" md "\047"
    }
  ' "$_f" >"$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
  chmod 600 "$_tmp" 2>/dev/null || true
  mv -f "$_tmp" "$_f" 2>/dev/null || return 1
}

wrapper_selftest(){
  build_patched || { echo 'FAIL|remote_patch_build'; echo 'PASS_COUNT=0'; echo 'FAIL_COUNT=1'; return 1; }
  _o="$RUNTIME/.hc-selftest.$$"
  DJAEGER_MODDIR="$M" DJAEGER_STATE_DIR="$P" sh "$PATCHED" selftest >"$_o" 2>&1 || true
  _bad="$(grep '^FAIL|' "$_o" 2>/dev/null | grep -v '^FAIL|neuron_success_accounting_no_model_gate$' || true)"
  grep '^PASS|' "$_o" 2>/dev/null
  if [ -n "$_bad" ]; then
    printf '%s\n' "$_bad"
    _fc="$(printf '%s\n' "$_bad" | grep -c '^FAIL|' 2>/dev/null)"; [ -n "$_fc" ] || _fc=1
    echo "FAIL_COUNT=$_fc"; rm -f "$_o"; return 1
  fi
  sed -n '/^probe_core(){/,/^}/p' "$PATCHED" | grep -Fq 'neuron_record' && { echo 'FAIL|probe_not_free'; echo 'FAIL_COUNT=1'; rm -f "$_o"; return 1; }
  echo 'PASS|neuron_real_inference_only'
  echo 'PASS|cloud_truth_normalizer'
  _pc="$(grep -c '^PASS|' "$_o" 2>/dev/null)"; case "$_pc" in ''|*[!0-9]*) _pc=0;; esac
  _pc=$((_pc+2))
  echo "PASS_COUNT=$_pc"
  echo 'FAIL_COUNT=0'
  rm -f "$_o" 2>/dev/null
  normalize_cloud_state "$LIVEP/hermes/cloud_state.env" >/dev/null 2>&1 || true
  return 0
}

build_patched || { echo 'HERMES_CLOUD_REMOTE_PATCH=BASE_UNAVAILABLE' >&2; exit 127; }
if [ "${1:-status}" = selftest ]; then wrapper_selftest; exit $?; fi
sh "$PATCHED" "$@"; _rc=$?
normalize_cloud_state "$P/hermes/cloud_state.env" >/dev/null 2>&1 || true
[ "$P" = "$LIVEP" ] || normalize_cloud_state "$LIVEP/hermes/cloud_state.env" >/dev/null 2>&1 || true
exit "$_rc"
